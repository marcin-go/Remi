@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="@PeriodLink("/home")" aria-label="Remi home">
            <span class="brand-mark">R</span>
            <span>Remi</span>
        </a>
        <span class="brand-subtitle">Framework MI reporting</span>
        <nav class="navigation" aria-label="Primary navigation">
            <NavLink href="@PeriodLink("/home")" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="@PeriodLink("/contracts")">Contracts</NavLink>
            <NavLink href="@PeriodLink("/invoices")">Invoices</NavLink>
            <NavLink href="@PeriodLink("/reports")">Reports</NavLink>
            <NavLink href="@PeriodLink("/settings")">Settings</NavLink>
        </nav>
    </header>
    <main>
        @Body
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ReportingPeriod.Changed += ReportingPeriodChanged;
        Navigation.LocationChanged += LocationChanged;
        await SynchroniseReportingPeriodAsync();
    }

    public void Dispose()
    {
        ReportingPeriod.Changed -= ReportingPeriodChanged;
        Navigation.LocationChanged -= LocationChanged;
    }

    private async void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        await InvokeAsync(async () =>
        {
            await SynchroniseReportingPeriodAsync(args.Location);
            StateHasChanged();
        });
    }

    private void ReportingPeriodChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SynchroniseReportingPeriodAsync(string? location = null)
    {
        var periods = await Workspace.GetReportingPeriodsAsync();
        ReportingPeriod.Synchronise(periods, PeriodFromLocation(location ?? Navigation.Uri));
    }

    private string PeriodLink(string path) => PeriodLink(path, ReportingPeriod.SelectedPeriod);

    private static string PeriodLink(string path, string period)
        => ReportingRoutes.WithPeriod(path, period);

    private static string? PeriodFromLocation(string location) =>
        QueryHelpers.ParseQuery(new Uri(location).Query).TryGetValue("period", out var values)
            ? values.FirstOrDefault()
            : null;
}
