@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="clipboard-evidence-layout @LayoutClass" @ref="host">
    <AntiforgeryToken />
    <div class="clipboard-evidence-form">
        @ChildContent
    </div>
    <aside class="clipboard-image-panel @(!ShowHeader ? "clipboard-image-panel--plain" : null)" aria-label="@Heading">
        @if (ShowHeader)
        {
            <header><strong>@Heading</strong><span>@(documents.Count == 0 ? EmptyStatus : $"{documents.Count} ready to save")</span></header>
        }
        <label class="clipboard-document-dropzone"><input type="file" multiple disabled="@saving" aria-label="Add supporting documents" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" /><strong>@DropZoneTitle</strong><span class="clipboard-instruction-desktop">choose multiple files, drop files here, or press Ctrl+V to paste</span><span class="clipboard-instruction-mobile">choose files or photos</span><span>15 MB per file</span></label>
        <p class="clipboard-document-error" data-clipboard-client-error hidden role="alert"></p>
        @if (busy || progress is not null) { <p class="clipboard-documents-empty" role="status">@(busy ? "Preparing documents…" : progress)</p> }
        @if (intakeError is not null) { <p class="clipboard-document-error" role="alert">@intakeError</p> }
        @if (documents.Count != 0)
        {
            <div class="clipboard-image-list">
                @foreach (var document in documents)
                {
                    <article class="clipboard-document-item" @key="document.Id">
                        @if (document.PreviewUrl is not null) { <img src="@document.PreviewUrl" alt="@document.FileName" /> } else { <span class="clipboard-document-icon" aria-hidden="true">▧</span> }
                        <div><label class="floating-field floating-field--static"><input value="@document.Title" disabled="@saving" maxlength="200" @oninput="@(args => RenameDocumentAsync(document, args))" aria-label="Document title for @document.FileName" placeholder="Document title" /><span class="floating-label">Document title</span></label><small>@document.FileName</small></div>
                        <button type="button" class="clipboard-document-remove" disabled="@saving" @onclick="@(() => RemoveDocumentAsync(document.Id))" aria-label="Remove @document.FileName" title="Remove document"><span aria-hidden="true">×</span></button>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="clipboard-documents-empty">@EmptyMessage</p>
        }
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<int> OnDocumentsChanged { get; set; }
    [Parameter] public string Heading { get; set; } = "Documents";
    [Parameter] public string EmptyStatus { get; set; } = "Add supporting files";
    [Parameter] public string DropZoneTitle { get; set; } = "Drop files here";
    [Parameter] public string EmptyMessage { get; set; } = "Paste screenshots, or add signed contracts, pricing and related files.";
    [Parameter] public string? LayoutClass { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;

    private ElementReference host;
    private IJSObjectReference? module;
    private DotNetObjectReference<ClipboardImageEvidence>? reference;
    private readonly TaskCompletionSource<bool> ready = new(TaskCreationOptions.RunContinuationsAsynchronously);
    private bool disposed, busy, saving;
    private string? progress;
    private long revision = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/clipboard-image-evidence.js");
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("attach", host, reference);
            ready.TrySetResult(true);
        }
        catch (Exception)
        {
            intakeError = "Documents could not be prepared. Reload the page and try again.";
            ready.TrySetResult(false);
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task DocumentsChanged()
    {
        if (disposed || module is null) return;
        await ApplyStateAsync(await module.InvokeAsync<DocumentState>("getState", host));
    }

    public async Task PrepareAsync()
    {
        if (!await ready.Task.WaitAsync(TimeSpan.FromSeconds(15)) || module is null)
            throw new InvalidOperationException("Documents are not ready. Reload the page and try again.");
        await ApplyStateAsync(await module.InvokeAsync<DocumentState>("prepare", host));
    }

    public async Task<bool> ArchiveAsync(string entityType, Guid entityId)
    {
        await PrepareAsync();
        using var timeout = new CancellationTokenSource(TimeSpan.FromMinutes(10));
        var result = await module!.InvokeAsync<DocumentState>("archive", timeout.Token, host, entityType, entityId);
        await ApplyStateAsync(result);
        if (result.Error is not null) throw new InvalidOperationException(result.Error);
        return result.ArchivedCount != 0;
    }

    private async Task ApplyStateAsync(DocumentState state)
    {
        if (disposed || state.Revision < revision) return;
        revision = state.Revision;
        documents = state.Documents;
        busy = state.Busy;
        saving = state.Saving;
        intakeError = state.Error;
        progress = state.Progress;
        await OnDocumentsChanged.InvokeAsync(documents.Count);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RenameDocumentAsync(PendingDocument document, ChangeEventArgs args)
    {
        document.Title = args.Value?.ToString() ?? string.Empty;
        if (module is not null)
        {
            await module.InvokeVoidAsync("rename", host, document.Id, document.Title);
            await DocumentsChanged();
        }
    }

    private async Task RemoveDocumentAsync(string id)
    {
        if (module is not null) await module.InvokeVoidAsync("remove", host, id);
        await DocumentsChanged();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        ready.TrySetResult(false);
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose", host);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        reference?.Dispose();
    }

    private List<PendingDocument> documents = [];
    private string? intakeError;
    public sealed class DocumentState
    {
        public long Revision { get; set; }
        public List<PendingDocument> Documents { get; set; } = [];
        public bool Busy { get; set; }
        public bool Saving { get; set; }
        public string? Error { get; set; }
        public string? Progress { get; set; }
        public int ArchivedCount { get; set; }
    }

    public sealed class PendingDocument
    {
        public string Id { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string ContentType { get; set; } = string.Empty;
        public long FileSizeBytes { get; set; }
        public string? PreviewUrl { get; set; }
        public string Title { get; set; } = string.Empty;
    }
}
