@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="clipboard-evidence-layout @LayoutClass" @ref="host">
    <AntiforgeryToken />
    <div class="clipboard-evidence-form">
        @ChildContent
    </div>
    <aside class="clipboard-image-panel @(!ShowHeader ? "clipboard-image-panel--plain" : null)" aria-label="@Heading">
        @if (ShowHeader)
        {
            <header><strong>@Heading</strong><span>@(documents.Count == 0 ? EmptyStatus : $"{documents.Count} ready to save")</span></header>
        }
        <label class="clipboard-document-dropzone"><input type="file" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" /><strong>@DropZoneTitle</strong><span class="clipboard-instruction-desktop">choose from disk, or press Ctrl+V to paste an image</span><span class="clipboard-instruction-mobile">choose a file or photo</span></label>
        @if (intakeError is not null) { <p class="clipboard-document-error" role="alert">@intakeError</p> }
        @if (documents.Count != 0)
        {
            <div class="clipboard-image-list">
                @foreach (var document in documents)
                {
                    <article class="clipboard-document-item" @key="document.Id">
                        @if (document.PreviewDataUrl is not null) { <img src="@document.PreviewDataUrl" alt="@document.FileName" /> } else { <span class="clipboard-document-icon" aria-hidden="true">▧</span> }
                        <div><label class="floating-field floating-field--static"><input value="@document.Title" @oninput="@(args => RenameDocumentAsync(document, args))" aria-label="Document title for @document.FileName" placeholder="Document title" /><span class="floating-label">Document title</span></label><small>@document.FileName</small></div>
                        <button type="button" class="clipboard-document-remove" @onclick="@(() => RemoveDocumentAsync(document.Id))" aria-label="Remove @document.FileName" title="Remove document"><span aria-hidden="true">×</span></button>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="clipboard-documents-empty">@EmptyMessage</p>
        }
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<int> OnDocumentsChanged { get; set; }
    [Parameter] public string Heading { get; set; } = "Documents";
    [Parameter] public string EmptyStatus { get; set; } = "Add supporting files";
    [Parameter] public string DropZoneTitle { get; set; } = "Drop files here";
    [Parameter] public string EmptyMessage { get; set; } = "Paste screenshots, or add signed contracts, pricing and related files.";
    [Parameter] public string? LayoutClass { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;

    private ElementReference host;
    private IJSObjectReference? module;
    private DotNetObjectReference<ClipboardImageEvidence>? reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/clipboard-image-evidence.js");
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("attach", host, reference);
        }
        catch (Exception)
        {
            intakeError = "Documents could not be prepared. Reload the page and try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task DocumentAdded(string id, string fileName, string contentType, long fileSizeBytes, string? previewDataUrl)
    {
        intakeError = null;
        if (documents.All(document => document.Id != id))
        {
            documents.Add(new PendingDocument(id, fileName, contentType, fileSizeBytes, previewDataUrl));
        }
        await InvokeAsync(StateHasChanged);
        await OnDocumentsChanged.InvokeAsync(documents.Count);
    }

    [JSInvokable]
    public async Task DocumentIntakeFailed(string message)
    {
        intakeError = message;
        await InvokeAsync(StateHasChanged);
    }

    public async Task<bool> ArchiveAsync(string entityType, Guid entityId)
    {
        if (module is null) return false;
        var archivedCount = await module.InvokeAsync<int>("archive", host, entityType, entityId);
        documents.Clear();
        await OnDocumentsChanged.InvokeAsync(0);
        return archivedCount != 0;
    }

    private async Task RenameDocumentAsync(PendingDocument document, ChangeEventArgs args)
    {
        document.Title = args.Value?.ToString() ?? string.Empty;
        if (module is not null)
        {
            await module.InvokeVoidAsync("rename", host, document.Id, document.Title);
        }
    }

    private async Task RemoveDocumentAsync(string id)
    {
        if (module is not null) await module.InvokeVoidAsync("remove", host, id);
        documents.RemoveAll(document => document.Id == id);
        await OnDocumentsChanged.InvokeAsync(documents.Count);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("dispose", host); }
            catch (JSDisconnectedException) { }
            await module.DisposeAsync();
        }
        reference?.Dispose();
    }

    private readonly List<PendingDocument> documents = [];
    private string? intakeError;
    private sealed class PendingDocument(string id, string fileName, string contentType, long fileSizeBytes, string? previewDataUrl)
    {
        public string Id { get; } = id;
        public string FileName { get; } = fileName;
        public string ContentType { get; } = contentType;
        public long FileSizeBytes { get; } = fileSizeBytes;
        public string? PreviewDataUrl { get; } = previewDataUrl;
        public string Title { get; set; } = Path.GetFileNameWithoutExtension(fileName);
    }
}
