    private void RemoveOperationalPart(EditableContractPart part) { if (editableOperations.Count > 1) editableOperations.Remove(part); }

    private async Task SaveOperationsAsync()
    {
        if (!CanSaveOperations) return;
        operationsWorking = true;
        operationsSubmission = null;
        try
        {
            EnsureSimpleOperationalPart();
            IReadOnlyList<EditableContractPart> source = operationsStaged ? editableOperations : [editableOperations[0]];
            if (!operationsStaged) source[0].Name = DefaultOperationalPartName;
            operationsSubmission = await Workspace.UpdateContractOperationsAsync(
                ContractId,
                source.Select((part, index) => new ContractServicePartEntry(part.Id, part.Name, part.GoLiveDate, index)).ToList());
            if (operationsSubmission.Succeeded)
            {
                details = await Workspace.GetContractDetailsAsync(ContractId);
                history = await Workspace.GetContractAuditEventsAsync(ContractId);
                editingOperations = false;
                PopulateEditors();
            }
        }
        finally { operationsWorking = false; }
    }

    private async Task CaptureCustomerGoLiveMessageAsync()
    {
        var livePartIds = GoLiveCapturePartIds;
        if (livePartIds.Count == 0) return;
        operationsMailWorking = true;
        operationsMailMessage = null;
        operationsMailSucceeded = false;
        try
        {
            var mailEvents = Services.GetService<RemiMailEventService>();
            if (mailEvents is null)
            {
                operationsMailMessage = "Mail capture is not available.";
                return;
            }

            var result = await mailEvents.CaptureCustomerGoLiveAsync(ContractId, livePartIds);
            operationsMailSucceeded = result.Succeeded;
            operationsMailMessage = result.Message;
        }
        finally { operationsMailWorking = false; }
    }

    private async Task SaveContractAsync()
    {
        if (!CanSaveContract) return;
        contractWorking = true; contractSubmission = null;
        try
        {
            contractSubmission = await Workspace.UpdateContractAsync(ContractId, new ContractEntry(editFramework, editSupplierReference, editCustomerName, editCustomerUrn, editStartDate, editEndDate, editLotNumber, IsEditGCloud ? editServiceGroup : null, null, IsEditGCloud ? null : editServiceDescription, IsEditGCloud ? null : editOrderChannel, IsEditGCloud ? editMarketplaceServiceId : null, editContractValue, editReportingMonth, "Edited in Remi"));
            if (contractSubmission.Succeeded) { if (contractClipboardImageCount != 0) await contractClipboardEvidence!.ArchiveAsync("contract", ContractId); contractClipboardImageCount = 0; details = await Workspace.GetContractDetailsAsync(ContractId); history = await Workspace.GetContractAuditEventsAsync(ContractId); editingContract = false; PopulateEditors(); }
        }
        finally { contractWorking = false; }
    }

    private async Task SaveScheduleAsync()
    {
        if (!CanSaveSchedule) return;
        scheduleWorking = true; scheduleSubmission = null;
        try
        {
            var retainedPositionIds = editableSchedule.Where(position => position.Id is not null).Select(position => position.Id!.Value).ToHashSet();
            var deletedPositionIds = details?.ChargeSchedule.Where(position => !retainedPositionIds.Contains(position.Id)).Select(position => position.Id).ToList() ?? [];
            foreach (var positionId in deletedPositionIds)
            {
                scheduleSubmission = await Workspace.DeleteChargeScheduleItemAsync(positionId, ContractId);
                if (!scheduleSubmission.Succeeded) return;
            }

            foreach (var position in editableSchedule)
            {
                var entry = new ChargeScheduleEntry(ContractId, position.ContractYear, position.Description, position.ExpectedInvoiceDate, position.ParsedValueExVat!.Value, position.IsOptionalExtension, position.ContractServicePartId);
                scheduleSubmission = position.Id is null ? await Workspace.AddChargeScheduleItemAsync(entry) : await Workspace.UpdateChargeScheduleItemAsync(position.Id.Value, entry);
                if (!scheduleSubmission.Succeeded) return;
            }
            scheduleSubmission ??= new ReturnActionResult(true, "The payment schedule has not changed.", []);
            details = await Workspace.GetContractDetailsAsync(ContractId); history = await Workspace.GetContractAuditEventsAsync(ContractId); editingSchedule = false; PopulateScheduleEditor();
        }
        finally { scheduleWorking = false; }
    }

