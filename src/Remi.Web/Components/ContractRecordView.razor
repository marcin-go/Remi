@using Remi.Application
@using Remi.Domain
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@implements IDisposable

@if (details is null)
{
    <section class="empty-state"><p>The requested contract was not found.</p><a class="button secondary" href="@PeriodRoute("contracts")">Back ←</a></section>
}
else
{
    <section class="contract-record">
        <header class="contract-hero">
            <div>
                <div class="contract-title-line"><h1>@details.Contract.SupplierReference</h1><span class="contract-status"><i aria-hidden="true"></i>Recorded</span></div>
                <p class="lede">@details.Contract.CustomerName · @Frameworks.Get(details.Contract.Framework).DisplayName</p>
            </div>
            <div class="contract-hero-actions">
                @if (editingContract)
                {
                    <button class="button primary" disabled="@(!CanSaveContract || contractWorking)" @onclick="SaveContractAsync">@(contractWorking ? "Saving…" : "Save")</button>
                    <button class="button secondary" @onclick="ToggleContractEditor">Cancel</button>
                }
                else
                {
                    <button class="button secondary" @onclick="ToggleContractEditor">Edit</button>
                    @if (SourceEvidence is not null)
                    {
                        <a class="button secondary" href="@($"/evidence/{SourceEvidence.Id}/download")">Download</a>
                    }
                    <a class="button secondary" href="@PeriodRoute("contracts")">Back ←</a>
                }
            </div>
        </header>

        <section class="contract-summary-grid" aria-label="Contract summary">
            <div class="contract-summary-item"><span>Contract value, ex VAT</span><strong>@Currency(CurrentContractValue)</strong><small>@LotAndFramework</small>@if (AgreedChangeValue != 0) { <small>Original value: @Currency(details.Contract.TotalContractValueExVat)</small> }</div>
            <div class="contract-summary-item"><span>Reported invoices</span><strong>@details.Invoices.Count</strong><small>Across @ReportingMonthCount reporting month@(ReportingMonthCount == 1 ? string.Empty : "s")</small></div>
            <div class="contract-summary-item"><span>Value invoiced</span><strong>@Currency(InvoicedValue)</strong><div class="contract-summary-progress" aria-label="@InvoicePercent of contract value"><i style="width: @InvoiceProgressWidth"></i></div><small>@InvoicePercent of contract value</small></div>
            <div class="contract-summary-item"><span>Contract term</span><strong>@ContractTerm</strong><small>@DateRange</small>@if (TermHasBeenExtended) { <small>Original term: @OriginalDateRange</small> }</div>
        </section>

        <section class="contract-tab-shell">
            <div class="contract-tabs" role="tablist" aria-label="Contract sections">
                <button class="@TabClass("overview")" role="tab" aria-selected="@(activeTab == "overview")" @onclick="@(() => SetTab("overview"))">Overview</button>
                <button class="@TabClass("changes")" role="tab" aria-selected="@(activeTab == "changes")" @onclick="@(() => SetTab("changes"))">Changes <span>@details.ContractChanges.Count</span></button>
                <button class="@TabClass("invoices")" role="tab" aria-selected="@(activeTab == "invoices")" @onclick="@(() => SetTab("invoices"))">Invoices <span>@details.Invoices.Count</span></button>
                <button class="@TabClass("evidence")" role="tab" aria-selected="@(activeTab == "evidence")" @onclick="@(() => SetTab("evidence"))">Documents <span>@details.Evidence.Count</span></button>
                <button class="@TabClass("history")" role="tab" aria-selected="@(activeTab == "history")" @onclick="@(() => SetTab("history"))">Record history</button>
            </div>

            @if (activeTab == "overview")
            {
                <div class="contract-tab-panel" role="tabpanel">
                    @if (details.Findings.Count != 0)
                    {
                        <section class="contract-findings"><p class="eyebrow">Needs attention</p><ul class="findings inline-findings">@foreach (var finding in details.Findings) { <li class="@finding.Severity.ToString().ToLowerInvariant()"><strong>@finding.Code</strong><span>@finding.Message</span></li> }</ul></section>
                    }
                    @if (editingContract)
                    {
                        <ClipboardImageEvidence @ref="contractClipboardEvidence" OnDocumentsChanged="SetContractClipboardImageCount">
                        <section class="contract-edit-panel">
                            <div class="panel-heading"><div><p class="eyebrow">Edit record</p><h2>Contract information</h2></div></div>
                            <div class="invoice-details-grid record-edit-fields">
                                <label class="floating-field floating-field--static"><select @bind="editFramework">@foreach (var framework in Frameworks.All) { <option value="@framework.Code">@framework.DisplayName</option> }</select><span class="floating-label">Framework</span></label>
                                <label class="floating-field"><input required placeholder=" " @bind="editReportingMonth" /><span class="floating-label">Reporting month</span></label>
                                <label class="floating-field"><input required placeholder=" " @bind="editSupplierReference" /><span class="floating-label">Supplier reference</span></label>
                                <label class="floating-field"><input required placeholder=" " @bind="editCustomerName" /><span class="floating-label">Customer</span></label>
                                <label class="floating-field"><input placeholder=" " @bind="editCustomerUrn" /><span class="floating-label">Customer URN</span></label>
                                <label class="floating-field"><input placeholder=" " @bind="editLotNumber" /><span class="floating-label">Lot</span></label>
                                <label class="floating-field floating-field--static"><input type="date" @bind="editStartDate" /><span class="floating-label">Start date</span></label>
                                <label class="floating-field floating-field--static"><input type="date" @bind="editEndDate" /><span class="floating-label">End date</span></label>
                                <label class="floating-field floating-field--static floating-field--currency"><b aria-hidden="true">&pound;</b><input required type="number" step="0.01" @bind="editContractValue" /><span class="floating-label">Total value, ex VAT</span></label>
                                <label class="floating-field"><input placeholder=" " @bind="editMarketplaceServiceId" /><span class="floating-label">Digital Marketplace service ID</span></label>
                                <label class="floating-field"><input placeholder=" " @bind="editServiceGroup" /><span class="floating-label">Service group / level 1</span></label>
                                <label class="floating-field"><input placeholder=" " @bind="editServiceGroupLevel2" /><span class="floating-label">Service group / level 2</span></label>
                                <label class="floating-field"><input placeholder=" " @bind="editServiceDescription" /><span class="floating-label">Service description</span></label>
                                <label class="floating-field"><input placeholder=" " @bind="editOrderChannel" /><span class="floating-label">Order channel</span></label>
                            </div>
                            @if (contractSubmission is not null) { <p class="notice @(contractSubmission.Succeeded ? "success" : "error")" role="status">@contractSubmission.Message</p> }
                        </section>
                        </ClipboardImageEvidence>
                    }
                    else
                    {
                    <div class="contract-overview-layout">
                        <article class="contract-content-card">
                            <header class="contract-card-head"><div><p class="eyebrow">Registered information</p><h2>Contract overview</h2><p>The signed-contract information used for monthly reporting.</p></div></header>
                            <section class="contract-detail-section">
                                <h3>▧ Framework and parties</h3>
                                <dl class="record-display-grid">
                                    <div><dt>Framework</dt><dd>@Frameworks.Get(details.Contract.Framework).DisplayName</dd></div><div><dt>Reporting month</dt><dd>@details.Contract.ReportMonth</dd></div>
                                    <div><dt>Supplier reference</dt><dd>@details.Contract.SupplierReference</dd></div><div><dt>Customer</dt><dd>@details.Contract.CustomerName</dd></div>
                                    <div><dt>Customer URN</dt><dd class="@NotRecordedClass(details.Contract.CustomerUrn)">@Display(details.Contract.CustomerUrn)</dd></div><div><dt>Lot</dt><dd class="@NotRecordedClass(details.Contract.LotNumber)">@Display(details.Contract.LotNumber)</dd></div>
                                </dl>
                            </section>
                            <section class="contract-detail-section">
                                <h3>▣ Dates and commercial information</h3>
                                <dl class="record-display-grid">
                                    <div><dt>Start date</dt><dd>@Display(details.Contract.StartDate)</dd></div><div><dt>End date</dt><dd>@Display(details.Contract.EndDate)</dd></div>
                                    <div><dt>Total value, ex VAT</dt><dd>@Currency(details.Contract.TotalContractValueExVat)</dd></div><div><dt>Digital Marketplace service ID</dt><dd class="@NotRecordedClass(details.Contract.DigitalMarketplaceServiceId)">@Display(details.Contract.DigitalMarketplaceServiceId)</dd></div>
                                </dl>
                            </section>
                            <section class="contract-detail-section">
                                <h3>≡ Service classification</h3>
                                <dl class="record-display-grid">
                                    <div><dt>Service group / level 1</dt><dd class="@NotRecordedClass(details.Contract.ServiceGroup)">@Display(details.Contract.ServiceGroup)</dd></div><div><dt>Service group / level 2</dt><dd class="@NotRecordedClass(details.Contract.ServiceGroupLevel2)">@Display(details.Contract.ServiceGroupLevel2)</dd></div>
                                    <div><dt>Service description</dt><dd class="@NotRecordedClass(details.Contract.ServiceDescription)">@Display(details.Contract.ServiceDescription)</dd></div><div><dt>Order channel</dt><dd class="@NotRecordedClass(details.Contract.OrderChannel)">@Display(details.Contract.OrderChannel)</dd></div>
                                </dl>
                            </section>
                            <section class="contract-detail-section">
                                <h3>▤ Annual payment positions</h3>
                                <div class="contract-section-actions"><button class="button secondary" @onclick="ToggleScheduleEditor">@(editingSchedule ? "Cancel" : "Edit")</button></div>
                                @if (editingSchedule)
                                {
                                    <div class="payment-position-editor">
                                        @foreach (var position in editableSchedule)
                                        {
                                            <div class="payment-position-row">
                                                <label>Year<input type="number" min="1" @bind="position.ContractYear" /></label><label>Description<input @bind="position.Description" /></label><label>Expected date<input type="date" @bind="position.ExpectedInvoiceDate" /></label><label>Value, ex VAT<input type="number" step="0.01" @bind="position.ValueExVat" /></label><label class="payment-optional"><input type="checkbox" @bind="position.IsOptionalExtension" /> Optional year</label>
                                            </div>
                                        }
                                        <div class="action-row"><button class="button secondary" @onclick="AddSchedulePosition">Add</button><button class="button primary" disabled="@(!CanSaveSchedule || scheduleWorking)" @onclick="SaveScheduleAsync">@(scheduleWorking ? "Saving…" : "Save")</button></div>
                                        @if (scheduleSubmission is not null) { <p class="notice @(scheduleSubmission.Succeeded ? "success" : "error")" role="status">@scheduleSubmission.Message</p> }
                                    </div>
                                }
                                @if (details.ChargeSchedule.Count == 0)
                                {
                                    <div class="contract-empty-inline"><strong>No charge schedule recorded</strong><span>This contract has no annual payment positions in the source register.</span></div>
                                }
                                else
                                {
                                    <div class="table-wrap"><table><thead><tr><th>Year</th><th>Description</th><th>Expected date</th><th>Value, ex VAT</th></tr></thead><tbody>@foreach (var yearGroup in details.ChargeSchedule.GroupBy(item => item.ContractYear).OrderBy(group => group.Key)) { @foreach (var item in yearGroup) { <tr class="@(item.IsOptionalExtension ? "optional-payment-position" : null)"><td>@item.ContractYear</td><td>@item.Description</td><td>@Display(item.ExpectedInvoiceDate)</td><td>@Currency(item.ValueExVat)</td></tr> } @if (yearGroup.Count() > 1) { <tr class="contract-payment-total @(yearGroup.Any(item => item.IsOptionalExtension) ? "optional-payment-position" : null)"><td colspan="3">Year @yearGroup.Key total</td><td>@Currency(yearGroup.Sum(item => item.ValueExVat))</td></tr> } }</tbody></table></div>
                                }
                            </section>
                        </article>
                        <aside class="contract-side-card">
                            <section><h2>Record completeness</h2><ul class="contract-check-list"><li class="@(HasCoreDetails ? "complete" : "incomplete")"><i>@StatusMark(HasCoreDetails)</i><span>Core contract fields recorded</span></li><li class="@(HasCustomerUrn ? "complete" : "incomplete")"><i>@StatusMark(HasCustomerUrn)</i><span>@(HasCustomerUrn ? "Customer URN recorded" : "Customer URN not recorded")</span></li><li class="@(details.Evidence.Count != 0 ? "complete" : "incomplete")"><i>@StatusMark(details.Evidence.Count != 0)</i><span>@(details.Evidence.Count != 0 ? "Supporting evidence attached" : "Supporting evidence not attached")</span></li></ul></section>
                            <section><h2>Record information</h2><dl class="contract-meta-list"><div><dt>Recorded</dt><dd>@details.Contract.CreatedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</dd></div><div><dt>Reporting month</dt><dd>@details.Contract.ReportMonth</dd></div><div><dt>Evidence</dt><dd>@details.Evidence.Count file@(details.Evidence.Count == 1 ? string.Empty : "s")</dd></div><div><dt>Invoices</dt><dd>@details.Invoices.Count record@(details.Invoices.Count == 1 ? string.Empty : "s")</dd></div></dl></section>
                            <section><h2>Register source</h2>@if (SourceEvidence is not null) { <a class="contract-source-file" href="@($"/evidence/{SourceEvidence.Id}/download")"><span>▧</span><strong>@SourceEvidence.FileName<small>Imported source workbook</small></strong><b aria-hidden="true">↓</b></a> } else { <p class="muted">@details.Contract.SourceWorkbook<br />Source file is not in the local archive.</p> }</section>
                        </aside>
                    </div>
                    }
                </div>
            }
            else if (activeTab == "changes")
            {
                <div class="contract-tab-panel" role="tabpanel">
                    <article class="contract-content-card">
                        <header class="contract-card-head"><div><p class="eyebrow">Agreed changes</p><h2>Extensions and variations</h2><p>Options are not reported until an agreement is recorded. Each agreement reports once, in its agreement month.</p></div><button class="button primary" @onclick="ToggleChangeForm">@(showChangeForm ? "Close" : "Register")</button></header>
                        @if (showChangeForm)
                        {
                            <ClipboardImageEvidence @ref="changeClipboardEvidence" OnDocumentsChanged="SetChangeClipboardDocumentCount">
                            <section class="contract-invoice-form">
                                <header class="contract-invoice-form-heading"><h3>@(EditingChange ? "Correct a contract change" : "Register a contract change")</h3><span>The agreement date determines the MI reporting month.</span></header>
                                <div class="invoice-details-grid contract-invoice-fields">
                                    <label class="floating-field floating-field--static"><select @bind="changeKind"><option value="@ContractChangeKind.Extension">Extension</option><option value="@ContractChangeKind.Variation">Variation</option></select><span class="floating-label">Change type</span></label>
                                    <label class="floating-field floating-field--static"><input required type="date" @bind="changeAgreementDate" /><span class="floating-label">Agreement date</span></label>
                                    <label class="floating-field floating-field--static"><input type="date" @bind="changeEffectiveStartDate" /><span class="floating-label">Effective start date</span></label>
                                    <label class="floating-field floating-field--static"><input type="date" @bind="changeEffectiveEndDate" /><span class="floating-label">Effective end date</span></label>
                                    <label class="floating-field floating-field--static floating-field--currency"><b aria-hidden="true">£</b><input required type="number" step="0.01" @bind="changeIncrementalValue" @onfocus="ClearZeroIncrementalValue" /><span class="floating-label">Incremental value, ex VAT</span></label>
                                    <label class="floating-field"><input placeholder=" " @bind="changeReference" /><span class="floating-label">Agreement reference (optional)</span></label>
                                </div>
                                <div class="contract-change-checks">
                                    <label class="contract-change-flipper"><input type="checkbox" @bind="changeProvidedFor" /><span class="contract-change-flipper-control" aria-hidden="true"></span><span>Provided for in the original call-off</span></label>
                                    <label class="contract-change-flipper"><input type="checkbox" @bind="changeIsConfirmed" disabled="@ConfirmedChangeCannotBeUnconfirmed" /><span class="contract-change-flipper-control" aria-hidden="true"></span><span>@(ConfirmedChangeCannotBeUnconfirmed ? "Confirmed" : "Confirm now")</span></label>
                                </div>
                                <footer class="contract-invoice-actions"><button type="button" class="invoice-command invoice-command-muted" @onclick="ToggleChangeForm">Cancel</button><button type="button" class="invoice-command invoice-command-save" disabled="@(!CanRecordChange || changeWorking)" @onclick="SaveChangeAsync">@(changeWorking ? "Saving…" : EditingChange ? "Save correction" : "Save change")</button></footer>
                                @if (changeSubmission is not null) { <p class="notice @(changeSubmission.Succeeded ? "success" : "error")" role="status">@changeSubmission.Message</p> }
                            </section>
                            </ClipboardImageEvidence>
                        }
                        @if (details.ContractChanges.Count == 0)
                        {
                            <div class="contract-empty-inline"><strong>No agreed changes recorded</strong><span>Unexercised optional years remain outside the awarded contract value.</span></div>
                        }
                        else
                        {
                            <div class="table-wrap"><table><thead><tr><th>Type</th><th>Agreement date</th><th>Effective period</th><th>Incremental value</th><th>Confirmation</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>@foreach (var change in details.ContractChanges) { <tr><td>@change.Kind</td><td>@Display(change.AgreementDate)</td><td>@DisplayPeriod(change.EffectiveStartDate, change.EffectiveEndDate)</td><td>@Currency(change.IncrementalValueExVat)</td><td>@if (change.IsConfirmed) { <span>Confirmed</span> } else { <button class="button secondary" disabled="@(confirmingChangeId == change.Id)" @onclick="@(() => ConfirmChangeAsync(change.Id))">@(confirmingChangeId == change.Id ? "Confirming…" : "Confirm")</button> }</td><td><button class="button secondary" disabled="@changeWorking" @onclick="@(() => BeginChangeEdit(change))">Edit</button></td></tr> }</tbody></table></div>
                        }
                    </article>
                </div>
            }
            else if (activeTab == "invoices")
            {
                <div class="contract-tab-panel" role="tabpanel">
                    <article class="contract-content-card">
                        <header class="contract-card-head"><div><p class="eyebrow">Reported invoices</p><h2>Activity against this contract</h2><p>Invoices are prefilled from this contract and the latest reported values, then reviewed before saving.</p></div><button class="button primary" @onclick="ShowInvoiceFormAsync">@(showInvoiceForm ? "Close" : "Register")</button></header>
                        @if (showInvoiceForm)
                        {
                            <section class="contract-invoice-form">
                                <header class="contract-invoice-form-heading"><h3>Register invoice</h3><span>Review every MI report field before saving.</span></header>
                                <div class="invoice-contract-summary contract-invoice-context"><div><strong>@details.Contract.SupplierReference <span aria-hidden="true">·</span> @details.Contract.CustomerName</strong><span>@Frameworks.Get(details.Contract.Framework).DisplayName <span aria-hidden="true">·</span> @Frameworks.Get(details.Contract.Framework).AgreementNumber</span></div></div>
                                <div class="invoice-details-grid contract-invoice-fields">
                                    <label class="floating-field"><input required placeholder=" " @bind="invoiceNumber" @bind:event="oninput" /><span class="floating-label">Invoice or credit note number</span></label>
                                    <label class="floating-field floating-field--static"><input required type="date" @bind="invoiceDate" /><span class="floating-label">Invoice or credit note date</span></label>
                                    <label class="floating-field floating-field--static"><select required @bind="invoiceReportingMonth">@foreach (var month in InvoiceReportingMonthOptions) { <option value="@month">@DisplayReportingMonth(month)</option> }</select><span class="floating-label">Reporting month</span></label>
                                    <label class="floating-field floating-field--static floating-field--currency"><b aria-hidden="true">£</b><input required type="number" step="0.01" @bind="invoiceTotalExVat" /><span class="floating-label">Total cost, ex VAT</span></label>
                                    @if (details.ContractChanges.Count != 0) { <label class="floating-field floating-field--static"><select @bind="invoiceContractChangeId"><option value="">Original contract</option>@foreach (var change in details.ContractChanges) { <option value="@change.Id">@ChangeDescription(change)</option> }</select><span class="floating-label">Contract segment</span></label> }
                                </div>
                                <p class="invoice-field-help">Use a negative total for a credit note.</p>
                                <p class="invoice-field-help">Contract fields are prefilled. Invoice-only values use the latest recorded invoice for this contract or the standard default.</p>
                                <div class="invoice-details-grid contract-invoice-fields">
                                    <label class="floating-field"><input required placeholder=" " @bind="invoiceCustomerName" @bind:event="oninput" /><span class="floating-label">Customer organisation name</span></label>
                                    <label class="floating-field"><input required placeholder=" " @bind="invoiceCustomerUrn" @bind:event="oninput" /><span class="floating-label">Customer URN</span></label>
                                    <label class="floating-field"><input required placeholder=" " @bind="invoiceLotNumber" @bind:event="oninput" /><span class="floating-label">Lot number</span></label>
                                    @if (IsVasInvoice)
                                    {
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceServiceGroup" @bind:event="oninput" /><span class="floating-label">Product/service group level 1</span></label>
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceServiceGroupLevel2" @bind:event="oninput" /><span class="floating-label">Product/service group level 2</span></label>
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceServiceDescription" @bind:event="oninput" /><span class="floating-label">Product/service description</span></label>
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceOriginalVendor" @bind:event="oninput" /><span class="floating-label">Original vendor</span></label>
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceSubcontractorName" @bind:event="oninput" /><span class="floating-label">Subcontractor name</span></label>
                                    }
                                    else
                                    {
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceServiceGroup" @bind:event="oninput" /><span class="floating-label">Service group</span></label>
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceDigitalMarketplaceServiceId" @bind:event="oninput" /><span class="floating-label">Digital Marketplace service ID</span></label>
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceUnitOfMeasure" @bind:event="oninput" /><span class="floating-label">Unit of measure</span></label>
                                        <label class="floating-field"><input required type="number" step="0.01" @bind="invoiceQuantity" /><span class="floating-label">Quantity</span></label>
                                        <label class="floating-field floating-field--currency"><b aria-hidden="true">&pound;</b><input required type="number" step="0.01" @bind="invoicePricePerUnitExVat" /><span class="floating-label">Price per unit, ex VAT</span></label>
                                    }
                                </div>
                                @if (InvoiceMayRevealChange) { <p class="notice warning">This invoice exceeds the remaining recorded contract value by @Currency(InvoiceOverage). It may reveal an extension or variation—record it in the Changes tab.</p> }
                                @if (SelectedInvoiceChange is { IsConfirmed: false }) { <p class="notice warning">The selected @SelectedInvoiceChange.Kind.ToString().ToLowerInvariant() is awaiting confirmation. The invoice can still be linked to it.</p> }
                                <footer class="contract-invoice-actions"><button type="button" class="invoice-command invoice-command-muted" @onclick="ShowInvoiceFormAsync">Cancel</button><button type="button" class="invoice-command invoice-command-save" disabled="@(!CanRecordInvoice || invoiceWorking)" @onclick="RecordInvoiceAsync">@(invoiceWorking ? "Saving…" : "Save invoice")</button></footer>
                                @if (invoiceSubmission is not null) { <p class="notice @(invoiceSubmission.Succeeded ? "success" : "error")" role="status">@invoiceSubmission.Message</p>@if (invoiceSubmission.Findings.Count != 0) { <ul class="findings inline-findings">@foreach (var finding in invoiceSubmission.Findings) { <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li> }</ul> } }
                            </section>
                        }
                        <section class="contract-table-section">
                            @if (details.Invoices.Count == 0)
                            {
                                <div class="contract-empty-inline"><strong>No invoices recorded</strong><span>Register the first invoice against this contract when the accounting record is available.</span></div>
                            }
                            else
                            {
                                <div class="table-wrap"><table><thead><tr><th>Invoice number</th><th>Invoice date</th><th>Reporting month</th><th>Total, ex VAT</th></tr></thead><tbody>@foreach (var invoice in details.Invoices.OrderByDescending(item => item.InvoiceDate)) { <tr><td><a class="contract-table-link" href="@InvoiceRoute(invoice.Id)">@invoice.InvoiceNumber</a></td><td>@Display(invoice.InvoiceDate)</td><td>@invoice.ReportMonth</td><td>@Currency(invoice.TotalCostExVat)</td></tr> }</tbody></table></div>
                            }
                        </section>
                    </article>
                </div>
            }
            else if (activeTab == "evidence")
            {
                <div class="contract-tab-panel" role="tabpanel"><article class="contract-content-card"><header class="contract-card-head"><div><p class="eyebrow">Documents</p><h2>Supporting documents</h2><p>Immutable copies retained alongside this contract record.</p></div></header><section class="contract-file-grid">@if (details.Evidence.Count == 0) { <div class="contract-empty-inline"><strong>No documents linked</strong><span>Add signed contracts, pricing extracts and other supporting documents from the contract record.</span></div> } @foreach (var evidence in details.Evidence) { <a class="contract-evidence-file" href="@($"/evidence/{evidence.Id}")" target="_blank"><span>▧</span><strong>@evidence.FileName<small>@evidence.OriginalRelativePath</small></strong><b>@(IsPdf(evidence) ? "View PDF" : "Download")</b></a> }</section></article></div>
            }
            else
            {
                <div class="contract-tab-panel" role="tabpanel"><article class="contract-content-card"><header class="contract-card-head"><div><p class="eyebrow">Audit trail</p><h2>Record history</h2><p>Material contract and invoice actions recorded by Remi.</p></div></header><section class="contract-history-list">@if (history.Count == 0) { <div class="contract-empty-inline"><strong>No history events are available</strong><span>The contract was registered without a matching local audit event.</span></div> } @foreach (var item in history) { <article><time>@item.OccurredAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</time><div><strong>@FriendlyAuditAction(item.Action)</strong><span>@item.Summary</span>@if (!string.IsNullOrWhiteSpace(item.Reason)) { <em>Reason: @item.Reason</em> }</div></article> }</section></article></div>
            }
        </section>
    </section>
}

@code {
    [Parameter] public Guid ContractId { get; set; }
    private ContractDetailsModel? details;
    private IReadOnlyList<AuditEventSummary> history = [];
    private string activeTab = "overview";
    private bool showInvoiceForm;
    private string invoiceNumber = string.Empty;
    private DateOnly? invoiceDate;
    private string invoiceReportingMonth = string.Empty;
    private decimal invoiceTotalValue;
    private Guid? invoiceContractChangeId;
    private ReturnActionResult? invoiceSubmission;
    private bool invoiceWorking;
    private bool editingContract;
    private bool contractWorking;
    private ReturnActionResult? contractSubmission;
    private FrameworkCode editFramework;
    private string editSupplierReference = string.Empty, editCustomerName = string.Empty, editCustomerUrn = string.Empty, editLotNumber = string.Empty, editServiceGroup = string.Empty, editServiceGroupLevel2 = string.Empty, editServiceDescription = string.Empty, editOrderChannel = string.Empty, editMarketplaceServiceId = string.Empty, editReportingMonth = string.Empty;
    private DateOnly? editStartDate, editEndDate;
    private decimal editContractValue;
    private bool editingSchedule;
    private bool scheduleWorking;
    private ReturnActionResult? scheduleSubmission;
    private List<EditableSchedulePosition> editableSchedule = [];
    private bool showChangeForm;
    private bool changeWorking;
    private ReturnActionResult? changeSubmission;
    private ContractChangeKind changeKind = ContractChangeKind.Extension;
    private DateOnly? changeAgreementDate, changeEffectiveStartDate, changeEffectiveEndDate;
    private decimal? changeIncrementalValue;
    private bool changeProvidedFor, changeIsConfirmed;
    private Guid? editingChangeId;
    private Guid? confirmingChangeId;
    private string changeReference = string.Empty;
    private ClipboardImageEvidence? changeClipboardEvidence;
    private int changeClipboardDocumentCount;
    private ClipboardImageEvidence? contractClipboardEvidence;
    private int contractClipboardImageCount;
    private string invoiceCustomerName = string.Empty, invoiceCustomerUrn = string.Empty, invoiceLotNumber = string.Empty, invoiceServiceGroup = string.Empty, invoiceServiceGroupLevel2 = string.Empty, invoiceServiceDescription = string.Empty, invoiceOrderChannel = string.Empty, invoiceDigitalMarketplaceServiceId = string.Empty, invoiceUnitOfMeasure = string.Empty, invoiceOriginalVendor = string.Empty, invoiceSubcontractorName = string.Empty;
    private decimal? invoiceQuantity;
    private decimal? invoicePricePerUnitExVatValue;
    private bool invoicePricePerUnitManuallySet;

    private EvidenceLink? SourceEvidence => details is null ? null : details.Evidence.FirstOrDefault(item => string.Equals(item.FileName, details.Contract.SourceWorkbook, StringComparison.OrdinalIgnoreCase));
    private decimal InvoicedValue => details?.Invoices.Sum(item => item.TotalCostExVat) ?? 0;
    private decimal AgreedChangeValue => details?.ContractChanges.Sum(change => change.IncrementalValueExVat) ?? 0;
    private decimal CurrentContractValue => details?.Contract.TotalContractValueExVat + AgreedChangeValue ?? 0;
    private decimal RemainingContractValue => Math.Max(0, CurrentContractValue - InvoicedValue);
    private ContractChangeRecord? SelectedInvoiceChange => invoiceContractChangeId is Guid changeId ? details?.ContractChanges.SingleOrDefault(change => change.Id == changeId) : null;
    private int ReportingMonthCount => details?.Invoices.Select(item => item.ReportMonth).Distinct(StringComparer.Ordinal).Count() ?? 0;
    private decimal InvoiceRatio => CurrentContractValue <= 0 ? 0 : InvoicedValue / CurrentContractValue;
    private string InvoiceProgressWidth => $"{Math.Clamp(InvoiceRatio * 100, 0, 100):0.##}%";
    private string InvoicePercent => $"{InvoiceRatio * 100:0.#}%";
    private string LotAndFramework => $"{(string.IsNullOrWhiteSpace(details!.Contract.LotNumber) ? "No lot recorded" : $"Lot {details.Contract.LotNumber}")} · {Frameworks.Get(details.Contract.Framework).DisplayName}";
    private DateOnly? CurrentContractEndDate => details is null ? null : details.ContractChanges
        .Where(change => change.Kind == ContractChangeKind.Extension)
        .Select(change => change.EffectiveEndDate)
        .Append(details.Contract.EndDate)
        .Max();
    private bool TermHasBeenExtended => details is not null && CurrentContractEndDate is not null && CurrentContractEndDate != details.Contract.EndDate;
    private string ContractTerm => details?.Contract.StartDate is not null && CurrentContractEndDate is not null ? $"{FullContractMonths(details.Contract.StartDate.Value, CurrentContractEndDate.Value)} months" : "Not recorded";
    private string DateRange => details?.Contract.StartDate is not null && CurrentContractEndDate is not null ? $"{Display(details.Contract.StartDate)} – {Display(CurrentContractEndDate)}" : "Dates not recorded";
    private string OriginalDateRange => details?.Contract.StartDate is not null && details.Contract.EndDate is not null ? $"{Display(details.Contract.StartDate)} – {Display(details.Contract.EndDate)}" : "Dates not recorded";
    private bool HasCustomerUrn => !string.IsNullOrWhiteSpace(details?.Contract.CustomerUrn);
    private bool HasCoreDetails => details is not null && !string.IsNullOrWhiteSpace(details.Contract.SupplierReference) && !string.IsNullOrWhiteSpace(details.Contract.CustomerName) && details.Contract.StartDate is not null && details.Contract.EndDate is not null && details.Contract.TotalContractValueExVat > 0;
    private bool IsValidInvoiceReportingMonth => IsValidReportingMonth(invoiceReportingMonth);
    private bool IsVasInvoice => details?.Contract.Framework == FrameworkCode.VerticalApplicationSolutions;
    private decimal invoiceTotalExVat { get => invoiceTotalValue; set { invoiceTotalValue = value; if (!invoicePricePerUnitManuallySet) invoicePricePerUnitExVatValue = InvoiceReportingDefaults.PricePerUnitExVat(value); } }
    private decimal? invoicePricePerUnitExVat { get => invoicePricePerUnitExVatValue; set { invoicePricePerUnitManuallySet = true; invoicePricePerUnitExVatValue = value; } }
    private bool HasRequiredInvoiceMiFields => !string.IsNullOrWhiteSpace(invoiceCustomerName) && !string.IsNullOrWhiteSpace(invoiceCustomerUrn) && !string.IsNullOrWhiteSpace(invoiceLotNumber)
        && (IsVasInvoice
            ? !string.IsNullOrWhiteSpace(invoiceServiceGroup) && !string.IsNullOrWhiteSpace(invoiceServiceGroupLevel2) && !string.IsNullOrWhiteSpace(invoiceServiceDescription) && !string.IsNullOrWhiteSpace(invoiceOriginalVendor) && !string.IsNullOrWhiteSpace(invoiceSubcontractorName)
            : !string.IsNullOrWhiteSpace(invoiceServiceGroup) && !string.IsNullOrWhiteSpace(invoiceDigitalMarketplaceServiceId) && !string.IsNullOrWhiteSpace(invoiceUnitOfMeasure) && invoiceQuantity is not null && invoicePricePerUnitExVat is not null);
    private bool CanRecordInvoice => details is not null && IsValidInvoiceReportingMonth && !string.IsNullOrWhiteSpace(invoiceNumber) && invoiceDate is not null && invoiceTotalExVat != 0 && HasRequiredInvoiceMiFields;
    private bool InvoiceMayRevealChange => details is not null && invoiceTotalExVat > RemainingContractValue;
    private decimal InvoiceOverage => Math.Max(0, invoiceTotalExVat - RemainingContractValue);
    private bool CanRecordChange => details is not null && changeAgreementDate is not null && changeIncrementalValue is not null && changeIncrementalValue != 0;
    private bool EditingChange => editingChangeId is not null;
    private bool ConfirmedChangeCannotBeUnconfirmed => editingChangeId is Guid changeId && details?.ContractChanges.Any(change => change.Id == changeId && change.IsConfirmed) == true;
    private IReadOnlyList<string> InvoiceReportingMonthOptions
    {
        get
        {
            var selectedMonth = DateOnly.TryParseExact($"{invoiceReportingMonth}-01", "yyyy-MM-dd", out var parsed)
                ? parsed
                : DateOnly.FromDateTime(DateTime.Today);
            var firstMonth = new DateOnly(selectedMonth.Year, selectedMonth.Month, 1).AddMonths(-36);
            return Enumerable.Range(0, 61).Select(offset => firstMonth.AddMonths(offset).ToString("yyyy-MM")).ToList();
        }
    }
    private bool CanSaveContract => details is not null && IsValidReportingMonth(editReportingMonth) && !string.IsNullOrWhiteSpace(editSupplierReference) && !string.IsNullOrWhiteSpace(editCustomerName) && editContractValue > 0;
    private string ContractClipboardEvidenceMessage => contractClipboardImageCount == 0 ? "Paste images here to add them to this contract's evidence." : $"{contractClipboardImageCount} image{(contractClipboardImageCount == 1 ? string.Empty : "s")} ready to add as evidence.";
    private bool CanSaveSchedule => editableSchedule.Count != 0 && editableSchedule.All(item => item.ContractYear > 0 && !string.IsNullOrWhiteSpace(item.Description) && item.ValueExVat > 0);

    protected override void OnInitialized()
    {
        ReportingPeriod.Changed += ReportingPeriodChanged;
        invoiceReportingMonth = ReportingPeriod.SelectedPeriod;
    }

    public void Dispose() => ReportingPeriod.Changed -= ReportingPeriodChanged;

    protected override async Task OnParametersSetAsync()
    {
        activeTab = "overview";
        showInvoiceForm = false;
        details = await Workspace.GetContractDetailsAsync(ContractId);
        history = await Workspace.GetContractAuditEventsAsync(ContractId);
        PopulateEditors();
    }

    private void SetTab(string tab) => activeTab = tab;
    private async Task ShowInvoiceFormAsync()
    {
        showInvoiceForm = !showInvoiceForm;
        invoiceSubmission = null;
        if (showInvoiceForm && details is not null)
        {
            await PopulateInvoiceReportingFieldsAsync(details.Contract);
        }
    }
    private void ToggleChangeForm() { showChangeForm = !showChangeForm; changeSubmission = null; if (!showChangeForm) ResetChangeForm(); }
    private void BeginChangeEdit(ContractChangeRecord change)
    {
        editingChangeId = change.Id;
        changeKind = change.Kind;
        changeAgreementDate = change.AgreementDate;
        changeEffectiveStartDate = change.EffectiveStartDate;
        changeEffectiveEndDate = change.EffectiveEndDate;
        changeIncrementalValue = change.IncrementalValueExVat;
        changeProvidedFor = change.WasProvidedForInOriginalCallOff;
        changeIsConfirmed = change.IsConfirmed;
        changeReference = change.Reference ?? string.Empty;
        changeClipboardDocumentCount = 0;
        changeSubmission = null;
        showChangeForm = true;
    }
    private void ToggleContractEditor() { editingContract = !editingContract; contractSubmission = null; if (editingContract) PopulateContractEditor(); }
    private void ToggleScheduleEditor() { editingSchedule = !editingSchedule; scheduleSubmission = null; if (editingSchedule) PopulateScheduleEditor(); }
    private void AddSchedulePosition() => editableSchedule.Add(new EditableSchedulePosition());

    private void PopulateEditors() { PopulateContractEditor(); PopulateScheduleEditor(); }
    private void PopulateContractEditor()
    {
        if (details is null) return;
        var contract = details.Contract;
        editFramework = contract.Framework; editSupplierReference = contract.SupplierReference; editCustomerName = contract.CustomerName; editCustomerUrn = contract.CustomerUrn ?? string.Empty; editLotNumber = contract.LotNumber ?? string.Empty; editStartDate = contract.StartDate; editEndDate = contract.EndDate; editContractValue = contract.TotalContractValueExVat; editServiceGroup = contract.ServiceGroup ?? string.Empty; editServiceGroupLevel2 = contract.ServiceGroupLevel2 ?? string.Empty; editServiceDescription = contract.ServiceDescription ?? string.Empty; editOrderChannel = contract.OrderChannel ?? string.Empty; editMarketplaceServiceId = contract.DigitalMarketplaceServiceId ?? string.Empty; editReportingMonth = contract.ReportMonth;
    }
    private void PopulateScheduleEditor() => editableSchedule = details?.ChargeSchedule.Select(item => new EditableSchedulePosition { Id = item.Id, ContractYear = item.ContractYear, Description = item.Description, ExpectedInvoiceDate = item.ExpectedInvoiceDate, ValueExVat = item.ValueExVat, IsOptionalExtension = item.IsOptionalExtension }).ToList() ?? [];

    private async Task SaveContractAsync()
    {
        if (!CanSaveContract) return;
        contractWorking = true; contractSubmission = null;
        try
        {
            contractSubmission = await Workspace.UpdateContractAsync(ContractId, new ContractEntry(editFramework, editSupplierReference, editCustomerName, editCustomerUrn, editStartDate, editEndDate, editLotNumber, editServiceGroup, editServiceGroupLevel2, editServiceDescription, editOrderChannel, editMarketplaceServiceId, editContractValue, editReportingMonth, "Edited in Remi"));
            if (contractSubmission.Succeeded) { if (contractClipboardImageCount != 0) await contractClipboardEvidence!.ArchiveAsync("contract", ContractId); contractClipboardImageCount = 0; details = await Workspace.GetContractDetailsAsync(ContractId); history = await Workspace.GetContractAuditEventsAsync(ContractId); editingContract = false; PopulateEditors(); }
        }
        finally { contractWorking = false; }
    }

    private async Task SaveScheduleAsync()
    {
        if (!CanSaveSchedule) return;
        scheduleWorking = true; scheduleSubmission = null;
        try
        {
            foreach (var position in editableSchedule)
            {
                var entry = new ChargeScheduleEntry(ContractId, position.ContractYear, position.Description, position.ExpectedInvoiceDate, position.ValueExVat, position.IsOptionalExtension);
                scheduleSubmission = position.Id is null ? await Workspace.AddChargeScheduleItemAsync(entry) : await Workspace.UpdateChargeScheduleItemAsync(position.Id.Value, entry);
                if (!scheduleSubmission.Succeeded) return;
            }
            details = await Workspace.GetContractDetailsAsync(ContractId); history = await Workspace.GetContractAuditEventsAsync(ContractId); editingSchedule = false; PopulateScheduleEditor();
        }
        finally { scheduleWorking = false; }
    }

    private async Task RecordInvoiceAsync()
    {
        if (!CanRecordInvoice || details is null) return;
        var contract = details.Contract;
        invoiceWorking = true;
        invoiceSubmission = null;
        try
        {
            invoiceSubmission = await Workspace.RecordInvoiceAsync(new InvoiceEntry(contract.Framework, contract.SupplierReference, invoiceCustomerName, invoiceCustomerUrn, invoiceDate, invoiceNumber, invoiceLotNumber, invoiceServiceGroup, invoiceServiceGroupLevel2, invoiceServiceDescription, invoiceOrderChannel, invoiceDigitalMarketplaceServiceId, invoiceUnitOfMeasure, invoiceQuantity, invoicePricePerUnitExVat, invoiceTotalExVat, invoiceOriginalVendor, invoiceSubcontractorName, invoiceReportingMonth, "Manual invoice registration", invoiceContractChangeId));
            if (invoiceSubmission.Succeeded)
            {
                await ResetInvoiceFormAsync();
                details = await Workspace.GetContractDetailsAsync(ContractId);
                history = await Workspace.GetContractAuditEventsAsync(ContractId);
            }
        }
        finally { invoiceWorking = false; }
    }

    private async Task ResetInvoiceFormAsync()
    {
        invoiceNumber = string.Empty;
        invoiceDate = null;
        invoiceTotalExVat = 0;
        invoiceContractChangeId = null;
        invoiceReportingMonth = ReportingPeriod.SelectedPeriod;
        if (details is not null)
        {
            await PopulateInvoiceReportingFieldsAsync(details.Contract);
        }
    }

    private async Task PopulateInvoiceReportingFieldsAsync(ContractRecord contract)
    {
        invoiceCustomerName = contract.CustomerName;
        invoiceCustomerUrn = contract.CustomerUrn ?? string.Empty;
        invoiceLotNumber = contract.LotNumber ?? string.Empty;
        invoiceServiceGroup = contract.ServiceGroup ?? string.Empty;
        invoiceServiceGroupLevel2 = contract.ServiceGroupLevel2 ?? string.Empty;
        invoiceServiceDescription = contract.ServiceDescription ?? string.Empty;
        invoiceOrderChannel = contract.OrderChannel ?? string.Empty;
        invoiceDigitalMarketplaceServiceId = contract.DigitalMarketplaceServiceId ?? string.Empty;
        var suggestion = await Workspace.GetInvoiceReportingSuggestionAsync(contract.Id);
        invoiceUnitOfMeasure = suggestion.UnitOfMeasure;
        invoiceQuantity = suggestion.Quantity;
        invoicePricePerUnitManuallySet = false;
        invoicePricePerUnitExVatValue = InvoiceReportingDefaults.PricePerUnitExVat(invoiceTotalExVat);
        invoiceOriginalVendor = suggestion.OriginalVendor;
        invoiceSubcontractorName = suggestion.SubcontractorName;
    }

    private async Task SaveChangeAsync()
    {
        if (!CanRecordChange) return;
        changeWorking = true;
        changeSubmission = null;
        try
        {
            var entry = new ContractChangeEntry(ContractId, changeKind, changeAgreementDate, changeEffectiveStartDate, changeEffectiveEndDate, changeIncrementalValue!.Value, changeProvidedFor, changeIsConfirmed, changeReference);
            changeSubmission = editingChangeId is Guid changeId
                ? await Workspace.UpdateContractChangeAsync(changeId, entry)
                : await Workspace.RecordContractChangeAsync(entry);
            if (changeSubmission.Succeeded)
            {
                if (changeClipboardDocumentCount != 0 && changeSubmission.EntityId is Guid archivedChangeId)
                {
                    await changeClipboardEvidence!.ArchiveAsync("contract-change", archivedChangeId);
                }
                details = await Workspace.GetContractDetailsAsync(ContractId);
                history = await Workspace.GetContractAuditEventsAsync(ContractId);
                showChangeForm = false;
                ResetChangeForm();
            }
        }
        finally { changeWorking = false; }
    }

    private void ResetChangeForm()
    {
        changeKind = ContractChangeKind.Extension;
        changeAgreementDate = changeEffectiveStartDate = changeEffectiveEndDate = null;
        changeIncrementalValue = 0;
        changeProvidedFor = changeIsConfirmed = false;
        editingChangeId = null;
        changeReference = string.Empty;
        changeClipboardDocumentCount = 0;
    }

    private void ClearZeroIncrementalValue()
    {
        if (changeIncrementalValue == 0)
        {
            changeIncrementalValue = null;
        }
    }

    private void SetContractClipboardImageCount(int count) => contractClipboardImageCount = count;
    private void SetChangeClipboardDocumentCount(int count) => changeClipboardDocumentCount = count;

    private async Task ConfirmChangeAsync(Guid changeId)
    {
        confirmingChangeId = changeId;
        try
        {
            changeSubmission = await Workspace.ConfirmContractChangeAsync(changeId);
            if (changeSubmission.Succeeded)
            {
                details = await Workspace.GetContractDetailsAsync(ContractId);
                history = await Workspace.GetContractAuditEventsAsync(ContractId);
            }
        }
        finally { confirmingChangeId = null; }
    }

    private void ReportingPeriodChanged()
    {
        if (!showInvoiceForm)
        {
            invoiceReportingMonth = ReportingPeriod.SelectedPeriod;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private string TabClass(string tab) => activeTab == tab ? "active" : string.Empty;
    private string PeriodRoute(string path) => ReportingRoutes.WithPeriod($"/{path.TrimStart('/')}", ReportingPeriod.SelectedPeriod);
    private string InvoiceRoute(Guid invoiceId) => PeriodRoute($"invoices/{invoiceId}");
    private static bool IsValidReportingMonth(string value) => DateOnly.TryParseExact($"{value}-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out _);
    private static string DisplayReportingMonth(string month) => DateOnly.TryParseExact($"{month}-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed) ? parsed.ToString("MMMM yyyy") : month;
    private static string StatusMark(bool complete) => complete ? "✓" : "!";
    private static string NotRecordedClass(string? value) => string.IsNullOrWhiteSpace(value) ? "not-recorded" : string.Empty;
    private static bool IsPdf(EvidenceLink evidence) => string.Equals(evidence.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase);
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    private static string Display(DateOnly? value) => value?.ToString("dd MMM yyyy") ?? "Not recorded";
    private static int FullContractMonths(DateOnly start, DateOnly end)
    {
        var endExclusive = end == DateOnly.MaxValue ? end : end.AddDays(1);
        var months = (endExclusive.Year - start.Year) * 12 + endExclusive.Month - start.Month;
        if (endExclusive.Day < start.Day) months--;
        return Math.Max(0, months);
    }
    private static string Display(DateOnly value) => value.ToString("dd MMM yyyy");
    private static string DisplayPeriod(DateOnly? start, DateOnly? end) => start is null && end is null ? "Not recorded" : $"{Display(start)} – {Display(end)}";
    private static string ChangeDescription(ContractChangeRecord change) => $"{change.Kind} agreed {change.AgreementDate:dd MMM yyyy} · {change.IncrementalValueExVat:C2}";
    private static string Currency(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    private static string FriendlyAuditAction(string action) => action switch { "ContractImported" => "Contract imported", "ContractCreated" => "Contract registered", "ContractUpdated" => "Contract updated", "ContractMigratedFromLedger" => "Contract recovered from Ledger", "ContractPaymentScheduleRecorded" => "Payment schedule recorded", "LedgerPaymentScheduleImported" => "Payment schedule recovered from Ledger", "ContractChangeRecorded" => "Contract change recorded", "ContractChangeUpdated" => "Contract change corrected", "ContractChangeConfirmed" => "Contract change confirmed", "InvoiceImported" => "Invoice imported", "InvoiceRecorded" => "Invoice registered", "InvoiceUpdated" => "Invoice updated", "ChargeScheduled" => "Charge schedule updated", "ChargeScheduleUpdated" => "Payment position updated", _ => action };
    private sealed class EditableSchedulePosition { public Guid? Id { get; init; } public int ContractYear { get; set; } = 1; public string Description { get; set; } = "Annual licence and maintenance"; public DateOnly? ExpectedInvoiceDate { get; set; } public decimal ValueExVat { get; set; } public bool IsOptionalExtension { get; set; } }
}
