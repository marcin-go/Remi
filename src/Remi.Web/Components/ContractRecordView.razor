            : InvoiceServiceGroupOptions.Contains(invoiceServiceGroup, StringComparer.Ordinal) && !string.IsNullOrWhiteSpace(invoiceDigitalMarketplaceServiceId) && InvoiceIntakeForm.UnitOfMeasureOptions.Contains(invoiceUnitOfMeasure, StringComparer.Ordinal) && invoiceQuantity is not null && invoicePricePerUnitExVat is not null);
