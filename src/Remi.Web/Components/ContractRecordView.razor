    private string editSupplierReference = string.Empty, editCustomerName = string.Empty, editCustomerUrn = string.Empty, editLotNumber = string.Empty, editServiceGroup = string.Empty, editServiceDescription = string.Empty, editOrderChannel = string.Empty, editMarketplaceServiceId = string.Empty, editReportingMonth = string.Empty;
    private DateOnly? editStartDate, editEndDate;
