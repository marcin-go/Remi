        FilterEditCustomerSuggestions(editCustomerName, preferUrn: false);
    }

    private void SearchEditCustomerUrns(ChangeEventArgs args)
    {
        editCustomerUrn = args.Value?.ToString() ?? string.Empty;
        activeEditCustomerPicker = EditCustomerUrnPicker;
        if (!string.Equals(editSelectedCustomer?.Urn, editCustomerUrn, StringComparison.Ordinal))
        {
            editSelectedCustomer = null;
        }
        FilterEditCustomerSuggestions(editCustomerUrn, preferUrn: true);
    }

    private void FilterEditCustomerSuggestions(string query, bool preferUrn)
    {
        var search = query.Trim();
        var matches = string.IsNullOrWhiteSpace(search)
            ? customerDirectoryEntries
            : customerDirectoryEntries
                .Where(item => item.OrganisationName.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || item.Urn.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || (item.Address?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        FilteredEditCustomerSuggestions = matches
            .OrderBy(item => preferUrn
                ? (item.Urn.StartsWith(search, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                : (item.OrganisationName.StartsWith(search, StringComparison.OrdinalIgnoreCase) ? 0 : 1))
            .ThenBy(item => item.OrganisationName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.Urn, StringComparer.Ordinal)
            .ToList();
    }

    private void HandleEditCustomerPickerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            activeEditCustomerPicker = null;
        }
        else if (args.Key == "Enter" && FilteredEditCustomerSuggestions.Count == 1)
        {
            UseEditCustomerSuggestion(FilteredEditCustomerSuggestions[0]);
        }
    }

