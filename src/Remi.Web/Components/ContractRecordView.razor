    private void BeginDocumentDeletion(EvidenceLink document)
    {
        if (!document.CanDelete) return;
        documentPendingDeletion = document;
        documentDeleteResult = null;
    }

    private void CancelDocumentDeletion()
    {
        if (documentDeleting) return;
        documentPendingDeletion = null;
        documentDeleteResult = null;
    }

    private async Task DeleteDocumentAsync()
    {
        if (documentPendingDeletion is null || documentDeleting) return;
        documentDeleting = true;
        documentDeleteResult = null;
        try
        {
            documentDeleteResult = await Workspace.DeleteContractEvidenceAsync(ContractId, documentPendingDeletion.Id);
            if (documentDeleteResult.Succeeded)
            {
                details = await Workspace.GetContractDetailsAsync(ContractId);
                history = await Workspace.GetContractAuditEventsAsync(ContractId);
                documentPendingDeletion = null;
            }
        }
        catch (Exception exception)
        {
            documentDeleteResult = new ReturnActionResult(false, $"The supporting document could not be deleted: {exception.Message}", []);
        }
        finally
        {
            documentDeleting = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (details is null || deleting) return;
        deleting = true;
        deleteResult = null;
        try
        {
            deleteResult = await Workspace.DeleteContractAsync(ContractId);
            if (deleteResult.Succeeded)
            {
                Navigation.NavigateTo(PeriodRoute("contracts"));
            }
        }
        catch (Exception exception)
        {
            deleteResult = new ReturnActionResult(false, $"The contract could not be deleted: {exception.Message}", []);
        }
        finally
        {
            deleting = false;
        }
    }
