@using Remi.Application
@using Remi.Domain
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@inject IServiceProvider Services
@inject NavigationManager Navigation
@implements IDisposable

@if (details is null)
{
    <section class="empty-state"><p>The requested contract was not found.</p></section>
}
else
{
    <section class="contract-record">
        <header class="dashboard-header register-page-header-compact contract-hero">
            <div>
                <div class="contract-title-line"><h1>@details.Contract.SupplierReference</h1><span class="contract-status @OperationalStatusCss"><i aria-hidden="true"></i>@OperationalStatus</span></div>
                <p class="contract-hero-context">@details.Contract.CustomerName <span aria-hidden="true">·</span> @Frameworks.Get(details.Contract.Framework).DisplayName</p>
            </div>
            <div class="contract-hero-actions">
                @if (editingContract)
                {
                    <button class="button primary" disabled="@(!CanSaveContract || contractWorking)" @onclick="SaveContractAsync">@(contractWorking ? "Saving…" : "Save")</button>
                    <button class="button secondary" @onclick="ToggleContractEditor">Cancel</button>
                }
                else
                {
                    <button class="button secondary" @onclick="ToggleContractEditor">Edit</button>
                    <div class="record-more">
                        <button type="button" class="button secondary record-more-trigger" aria-label="More" title="More" aria-haspopup="menu" aria-expanded="@moreMenuOpen" @onclick="ToggleMoreMenu"><span class="record-more-icon" aria-hidden="true"></span></button>
                        @if (moreMenuOpen)
                        {
                            <div class="record-more-menu" role="menu"><button type="button" class="record-more-delete" role="menuitem" @onclick="ShowDeleteConfirmationAsync">DELETE</button></div>
                        }
                    </div>
                }
            </div>
        </header>

        <section class="contract-summary-grid" aria-label="Contract summary">
            <div class="contract-summary-item"><span>Contract value, ex VAT</span><strong>@Currency(CurrentContractValue)</strong><small>@LotAndFramework</small>@if (AgreedChangeValue != 0) { <small>Original value: @Currency(details.Contract.TotalContractValueExVat)</small> }</div>
            <div class="contract-summary-item"><span>Reported invoices</span><strong>@details.Invoices.Count</strong><small>Across @ReportingMonthCount reporting month@(ReportingMonthCount == 1 ? string.Empty : "s")</small></div>
            <div class="contract-summary-item"><span>Value invoiced</span><strong>@Currency(InvoicedValue)</strong><div class="contract-summary-progress" aria-label="@InvoicePercent of contract value"><i style="width: @InvoiceProgressWidth"></i></div><small>@InvoicePercent of contract value</small></div>
            <div class="contract-summary-item"><span>Contract term</span><strong>@ContractTerm</strong><small>@DateRange</small>@if (TermHasBeenExtended) { <small>Original term: @OriginalDateRange</small> }</div>
        </section>

        <section class="contract-tab-shell">
            <div class="contract-tabs" role="tablist" aria-label="Contract sections">
                <button class="@TabClass("overview")" role="tab" aria-selected="@(activeTab == "overview")" @onclick="@(() => SetTab("overview"))">Overview</button>
                <button class="@TabClass("changes")" role="tab" aria-selected="@(activeTab == "changes")" @onclick="@(() => SetTab("changes"))">Changes <span>@details.ContractChanges.Count</span></button>
                <button class="@TabClass("invoices")" role="tab" aria-selected="@(activeTab == "invoices")" @onclick="@(() => SetTab("invoices"))">Invoices <span>@details.Invoices.Count</span></button>
                <button class="@TabClass("evidence")" role="tab" aria-selected="@(activeTab == "evidence")" @onclick="@(() => SetTab("evidence"))">Documents <span>@details.Evidence.Count</span></button>
                <button class="@TabClass("history")" role="tab" aria-selected="@(activeTab == "history")" @onclick="@(() => SetTab("history"))">Record history</button>
            </div>

            @if (activeTab == "overview")
            {
                <div class="contract-tab-panel" role="tabpanel">
                    @if (details.Findings.Count != 0)
                    {
                        <section class="contract-findings"><h2>Needs attention</h2><ul class="findings inline-findings">@foreach (var finding in details.Findings) { <li class="@finding.Severity.ToString().ToLowerInvariant()"><strong>@finding.Code</strong><span>@finding.Message</span></li> }</ul></section>
                    }
                    @if (editingContract)
                    {
                        <ClipboardImageEvidence @ref="contractClipboardEvidence" OnDocumentsChanged="SetContractClipboardImageCount">
                        <section class="contract-edit-panel">
                            <div class="panel-heading"><h2>Contract information</h2></div>
                            <section class="contract-edit-field-group">
                                <h3>Reporting context</h3>
                                <div class="invoice-details-grid record-edit-fields">
                                    <RemiPicklist Id="contract-edit-framework-picklist-options" Label="Framework" Items="@EditableFrameworkOptions" Value="@editFramework.ToString()" ValueChanged="SetEditFramework" ItemLabel="FrameworkLabel" ItemGroup="FrameworkGroup" />
                                    <label class="floating-field"><input required placeholder=" " @bind="editReportingMonth" /><span class="floating-label">Reporting month</span></label>
                                </div>
                            </section>
                            <section class="contract-edit-field-group">
                                <h3>Customer and reference</h3>
                                <div class="invoice-details-grid record-edit-fields">
                                    <label class="floating-field"><input required placeholder=" " @bind="editSupplierReference" /><span class="floating-label">@EditFieldNames.SupplierReferenceNumber</span></label>
                                    <div class="searchable-picklist customer-directory-picker">
                                        <label class="floating-field"><input required role="combobox" aria-label="@EditFieldNames.CustomerOrganisationName" aria-autocomplete="list" aria-controls="edit-customer-name-suggestions" aria-expanded="@(activeEditCustomerPicker == EditCustomerNamePicker ? "true" : "false")" autocomplete="off" placeholder=" " value="@editCustomerName" @oninput="SearchEditCustomerNames" @onfocus="@(() => OpenEditCustomerPicker(EditCustomerNamePicker))" @onblur="CloseEditCustomerPicker" @onkeydown="HandleEditCustomerPickerKeyDown" /><span class="floating-label">@EditFieldNames.CustomerOrganisationName</span></label>
                                        @if (activeEditCustomerPicker == EditCustomerNamePicker)
                                        {
                                            <SearchablePicklistOptions TItem="CustomerUrnSuggestion"
                                                                       Id="edit-customer-name-suggestions"
                                                                       AriaLabel="Customer organisation suggestions"
                                                                       Items="@FilteredEditCustomerSuggestions"
                                                                       ItemSelected="@UseEditCustomerSuggestion"
                                                                       Selected="@IsSelectedEditCustomer"
                                                                       EmptyMessage="No GCA customer directory entries are available. Refresh the list in Settings."
                                                                       CssClass="customer-urn-suggestions">
                                                <ItemTemplate Context="suggestion"><strong>@suggestion.OrganisationName</strong><span>URN @suggestion.Urn@if (!string.IsNullOrWhiteSpace(suggestion.Address)) { <text> · @suggestion.Address</text> }</span></ItemTemplate>
                                            </SearchablePicklistOptions>
                                        }
                                    </div>
                                    <div class="searchable-picklist customer-directory-picker">
                                        <label class="floating-field"><input required role="combobox" aria-label="@EditFieldNames.CustomerUniqueReferenceNumber" aria-autocomplete="list" aria-controls="edit-customer-urn-suggestions" aria-expanded="@(activeEditCustomerPicker == EditCustomerUrnPicker ? "true" : "false")" autocomplete="off" placeholder=" " value="@editCustomerUrn" @oninput="SearchEditCustomerUrns" @onfocus="@(() => OpenEditCustomerPicker(EditCustomerUrnPicker))" @onblur="CloseEditCustomerPicker" @onkeydown="HandleEditCustomerPickerKeyDown" /><span class="floating-label">@EditFieldNames.CustomerUniqueReferenceNumber</span></label>
                                        @if (activeEditCustomerPicker == EditCustomerUrnPicker)
                                        {
                                            <SearchablePicklistOptions TItem="CustomerUrnSuggestion"
                                                                       Id="edit-customer-urn-suggestions"
                                                                       AriaLabel="Customer URN suggestions"
                                                                       Items="@FilteredEditCustomerSuggestions"
                                                                       ItemSelected="@UseEditCustomerSuggestion"
                                                                       Selected="@IsSelectedEditCustomer"
                                                                       EmptyMessage="No GCA customer directory entries are available. Refresh the list in Settings."
                                                                       CssClass="customer-urn-suggestions">
                                                <ItemTemplate Context="suggestion"><strong>@suggestion.OrganisationName</strong><span>URN @suggestion.Urn@if (!string.IsNullOrWhiteSpace(suggestion.Address)) { <text> · @suggestion.Address</text> }</span></ItemTemplate>
                                            </SearchablePicklistOptions>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(editSelectedCustomer?.Address))
                                    {
                                        <div class="customer-address-verification" aria-live="polite"><span>Address in GCA URN list</span><strong>@editSelectedCustomer.Address</strong></div>
                                    }
                                </div>
                            </section>
                            <section class="contract-edit-field-group">
                                <h3>Service classification</h3>
                                <div class="invoice-details-grid record-edit-fields">
                                    <RemiPicklist Id="contract-edit-lot-picklist-options" Label="@EditFieldNames.LotNumber" Items="@EditLotOptions" Value="@editLotNumber" ValueChanged="SetEditLot" ItemLabel="LotLabel" Required="true" />
                                    @if (IsEditGCloud)
                                    {
                                        <RemiPicklist Id="contract-edit-service-group-picklist-options" Label="@EditFieldNames.ServiceGroup" Items="@EditServiceGroupPicklistOptions" Value="@editServiceGroup" ValueChanged="@(value => editServiceGroup = value)" ItemLabel="EditServiceGroupLabel" Required="true" Disabled="@(EditServiceGroupOptions.Count == 0)" />
                                        <div class="searchable-picklist marketplace-service-picker">
                                            <label class="floating-field"><input required role="combobox" aria-label="@EditFieldNames.DigitalMarketplaceServiceId" aria-autocomplete="list" aria-controls="edit-marketplace-service-suggestions" aria-expanded="@editMarketplaceSuggestionsOpen.ToString().ToLowerInvariant()" autocomplete="off" placeholder=" " value="@editMarketplaceServiceId" @oninput="SearchEditMarketplaceServices" @onfocus="OpenEditMarketplaceServices" @onblur="CloseEditMarketplaceServices" @onkeydown="HandleEditMarketplaceKeyDown" /><span class="floating-label">@EditFieldNames.DigitalMarketplaceServiceId</span></label>
                                            @if (editMarketplaceSuggestionsOpen && HasMarketplaceServiceSuggestions)
                                            {
                                                <SearchablePicklistOptions TItem="DigitalMarketplaceService"
                                                                           Id="edit-marketplace-service-suggestions"
                                                                           AriaLabel="Digital Marketplace service suggestions"
                                                                           Items="@FilteredEditMarketplaceServices"
                                                                           ItemSelected="@UseEditMarketplaceService"
                                                                           Selected="@(service => service.ServiceId == editMarketplaceServiceId)"
                                                                           EmptyMessage="No matching Digital Marketplace services."
                                                                           CssClass="marketplace-service-suggestions">
                                                    <ItemTemplate Context="service"><strong>@service.ServiceId</strong><span>@service.Name</span></ItemTemplate>
                                                </SearchablePicklistOptions>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <label class="floating-field"><input required placeholder=" " @bind="editServiceDescription" /><span class="floating-label">@EditFieldNames.ProductServiceDescription</span></label>
                                        <RemiPicklist Id="contract-edit-order-channel-picklist-options" Label="@EditFieldNames.OrderChannel" Items="@EditOrderChannelOptions" Value="@editOrderChannel" ValueChanged="@(value => editOrderChannel = value)" ItemLabel="OrderChannelLabel" Required="true" />
                                    }
                                </div>
                            </section>
                            <section class="contract-edit-field-group">
                                <h3>Contract dates and value</h3>
                                <div class="invoice-details-grid record-edit-fields">
                                    <label class="floating-field floating-field--static"><input required type="date" @bind="editStartDate" /><span class="floating-label">@EditFieldNames.ContractStartDate</span></label>
                                    <label class="floating-field floating-field--static"><input required type="date" @bind="editEndDate" /><span class="floating-label">@EditFieldNames.ContractEndDate</span></label>
                                    <label class="floating-field floating-field--static floating-field--currency"><b aria-hidden="true">&pound;</b><input required type="number" step="0.01" @bind="editContractValue" /><span class="floating-label">@EditFieldNames.TotalContractValue</span></label>
                                </div>
                            </section>
                            @if (contractSubmission is not null) { <p class="notice @(contractSubmission.Succeeded ? "success" : "error")" role="status">@contractSubmission.Message</p> }
                        </section>
                        </ClipboardImageEvidence>
                    }
                    else
                    {
                    <div class="contract-overview-layout">
                        <article class="contract-content-card">
                            <header class="contract-card-head"><div><h2>Contract overview</h2><p>The signed-contract information used for monthly reporting.</p></div></header>
                            <section class="contract-detail-section">
                                <h3>Customer and reference</h3>
                                <dl class="record-display-grid">
                                    <div><dt>@DisplayFieldNames.SupplierReferenceNumber</dt><dd>@details.Contract.SupplierReference</dd></div>
                                    <div><dt>@DisplayFieldNames.CustomerOrganisationName</dt><dd>@details.Contract.CustomerName</dd></div>
                                    <div><dt>@DisplayFieldNames.CustomerUniqueReferenceNumber</dt><dd class="@NotRecordedClass(details.Contract.CustomerUrn)">@Display(details.Contract.CustomerUrn)</dd></div>
                                </dl>
                            </section>
                            <section class="contract-detail-section">
                                <h3>Service classification</h3>
                                <dl class="record-display-grid">
                                    <div><dt>@DisplayFieldNames.LotNumber</dt><dd class="@NotRecordedClass(details.Contract.LotNumber)">@Display(details.Contract.LotNumber)</dd></div>
                                    @if (details.Contract.Framework == FrameworkCode.VerticalApplicationSolutions)
                                    {
                                        <div><dt>@DisplayFieldNames.ProductServiceDescription</dt><dd class="@NotRecordedClass(details.Contract.ServiceDescription)">@Display(details.Contract.ServiceDescription)</dd></div>
                                        <div><dt>@DisplayFieldNames.OrderChannel</dt><dd class="@NotRecordedClass(details.Contract.OrderChannel)">@Display(details.Contract.OrderChannel)</dd></div>
                                    }
                                    else
                                    {
                                        <div><dt>@DisplayFieldNames.ServiceGroup</dt><dd class="@NotRecordedClass(details.Contract.ServiceGroup)">@Display(details.Contract.ServiceGroup)</dd></div>
                                        <div><dt>@DisplayFieldNames.DigitalMarketplaceServiceId</dt><dd class="@NotRecordedClass(details.Contract.DigitalMarketplaceServiceId)">@Display(details.Contract.DigitalMarketplaceServiceId)</dd></div>
                                    }
                                </dl>
                            </section>
                            <section class="contract-detail-section">
                                <h3>Contract dates and value</h3>
                                <dl class="record-display-grid">
                                    <div><dt>@DisplayFieldNames.ContractStartDate</dt><dd>@Display(details.Contract.StartDate)</dd></div>
                                    <div><dt>@DisplayFieldNames.ContractEndDate</dt><dd>@Display(details.Contract.EndDate)</dd></div>
                                    <div><dt>@DisplayFieldNames.TotalContractValue</dt><dd>@Currency(details.Contract.TotalContractValueExVat)</dd></div>
                                </dl>
                            </section>
                            <section class="contract-detail-section contract-operations-section">
                                <h3>Operational delivery</h3>
                                <div class="contract-section-actions">
                                    @if (editingOperations)
                                    {
                                        @if (operationsStaged) { <button class="button secondary" disabled="@(editableOperations.Count >= 20)" @onclick="AddOperationalPart">Add part</button> }
                                        <button class="button primary" disabled="@(!CanSaveOperations || operationsWorking)" @onclick="SaveOperationsAsync">@(operationsWorking ? "Saving..." : "Save")</button>
                                        <button class="button secondary" @onclick="ToggleOperationsEditor">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="button secondary" @onclick="ToggleOperationsEditor">Edit</button>
                                        @if (GoLiveCapturePartIds.Count != 0 && !operationsMailSucceeded)
                                        {
                                            <button class="button secondary" disabled="@operationsMailWorking" @onclick="CaptureCustomerGoLiveMessageAsync">@(operationsMailWorking ? "Capturing..." : "Capture customer go-live message")</button>
                                        }
                                    }
                                </div>
                                @if (editingOperations)
                                {
                                    <label class="contract-change-flipper operations-stage-toggle"><input type="checkbox" @bind="operationsStaged" /><span class="contract-change-flipper-control" aria-hidden="true"></span><span>This contract goes live in stages</span></label>
                                    @if (!operationsStaged)
                                    {
                                        <div class="operations-simple-editor">
                                            <label class="floating-field floating-field--static"><input type="date" @bind="SimpleGoLiveDate" /><span class="floating-label">Actual go-live date</span></label>
                                            <p>Leave this blank until the complete contract is operational.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="operations-part-editor">
                                            @for (var partIndex = 0; partIndex < editableOperations.Count; partIndex++)
                                            {
                                                var part = editableOperations[partIndex];
                                                var ordinal = partIndex + 1;
                                                <div class="operations-part-row" @key="part">
                                                    <label class="floating-field"><input required placeholder=" " aria-label="Part name @ordinal" @bind="part.Name" /><span class="floating-label">System or billing group</span></label>
                                                    <label class="floating-field floating-field--static"><input type="date" aria-label="Go-live date for part @ordinal" @bind="part.GoLiveDate" /><span class="floating-label">Actual go-live date</span></label>
                                                    <button type="button" class="payment-position-remove" disabled="@(editableOperations.Count == 1)" title="Remove contract part" aria-label="Remove contract part @ordinal" @onclick="@(() => RemoveOperationalPart(part))">&times;</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (operationsSubmission is not null) { <p class="notice @(operationsSubmission.Succeeded ? "success" : "error")" role="status">@operationsSubmission.Message</p> }
                                }
                                else if (details.ServiceParts.Count <= 1)
                                {
                                    var part = details.ServiceParts.FirstOrDefault();
                                    <dl class="record-display-grid operations-summary-grid"><div><dt>Status</dt><dd>@OperationalStatus</dd></div><div><dt>Actual go-live date</dt><dd class="@(part?.GoLiveDate is null ? "not-recorded" : null)">@Display(part?.GoLiveDate)</dd></div></dl>
                                }
                                else
                                {
                                    <div class="operations-status-line"><span class="contract-status @OperationalStatusCss"><i aria-hidden="true"></i>@OperationalStatus</span><small>@LivePartCount of @details.ServiceParts.Count parts live</small></div>
                                    <div class="table-wrap"><table><thead><tr><th>System or billing group</th><th>Actual go-live date</th></tr></thead><tbody>@foreach (var part in details.ServiceParts.OrderBy(part => part.SortOrder)) { <tr><td>@part.Name</td><td class="@(part.GoLiveDate is null ? "not-recorded" : null)">@Display(part.GoLiveDate)</td></tr> }</tbody></table></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(operationsMailMessage)) { <p class="notice @(operationsMailSucceeded ? "success" : "error")" role="status">@operationsMailMessage</p> }
                            </section>
                            <section class="contract-detail-section">
                                <h3>Payment schedule</h3>
                                <div class="contract-section-actions">
                                    @if (editingSchedule)
                                    {
                                        <button class="button secondary" @onclick="AddSchedulePosition">Add</button>
                                        <button class="button primary" disabled="@(!CanSaveSchedule || scheduleWorking)" @onclick="SaveScheduleAsync">@(scheduleWorking ? "Saving…" : "Save")</button>
                                        <button class="button secondary" @onclick="ToggleScheduleEditor">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="button secondary" @onclick="ToggleScheduleEditor">Edit</button>
                                    }
                                </div>
                                @if (editingSchedule)
                                {
                                    <div class="payment-position-editor">
                                        <div class="payment-schedule-grid">
                                            <div class="payment-schedule-heading @(HasStagedOperations ? "has-contract-part" : null)" aria-hidden="true"><span>Year</span><span>Description</span>@if (HasStagedOperations) { <span>Contract part</span> }<span>Expected date</span><span>Value, ex VAT</span><span>Optional</span><span></span></div>
                                            @for (var positionIndex = 0; positionIndex < editableSchedule.Count; positionIndex++)
                                            {
                                                var position = editableSchedule[positionIndex];
                                                var ordinal = positionIndex + 1;
                                                <div class="payment-position-row @(HasStagedOperations ? "has-contract-part" : null)" @key="position">
                                                    <input class="payment-schedule-input" type="number" min="1" aria-label="Year, payment position @ordinal" @bind="position.ContractYear" />
                                                    <input class="payment-schedule-input" aria-label="Description, payment position @ordinal" @bind="position.Description" />
                                                    @if (HasStagedOperations)
                                                    {
                                                        <RemiPicklist Id="@($"payment-part-{ordinal}")" Label="Contract part" Items="@ContractPartPickerItems" Value="@position.ContractServicePartValue" ValueChanged="@(value => position.ContractServicePartValue = value)" ItemLabel="ContractPartPickerLabel" CssClass="payment-part-picklist" />
                                                    }
                                                    <input class="payment-schedule-input" type="date" aria-label="Expected date, payment position @ordinal" @bind="position.ExpectedInvoiceDate" />
                                                    <div class="payment-schedule-money"><span aria-hidden="true">£</span><input class="payment-schedule-input" type="text" inputmode="decimal" aria-label="Value excluding VAT, payment position @ordinal" @bind="position.ValueExVatInput" /></div>
                                                    <label class="payment-optional"><input type="checkbox" aria-label="Optional year, payment position @ordinal" @bind="position.IsOptionalExtension" /></label>
                                                    <button type="button" class="payment-position-remove" title="Remove payment position" aria-label="Remove payment position @ordinal" @onclick="@(() => RemoveSchedulePosition(position))">×</button>
                                                </div>
                                            }
                                        </div>
                                        @if (scheduleSubmission is not null) { <p class="notice @(scheduleSubmission.Succeeded ? "success" : "error")" role="status">@scheduleSubmission.Message</p> }
                                    </div>
                                }
                                else if (details.ChargeSchedule.Count == 0)
                                {
                                    <div class="contract-empty-inline"><strong>No charge schedule recorded</strong><span>This contract has no annual payment positions in the source register.</span></div>
                                }
                                else
                                {
                                    <div class="table-wrap"><table><thead><tr><th>Year</th><th>Description</th>@if (HasStagedOperations) { <th>Contract part</th> }<th>Expected date</th><th>Value, ex VAT</th></tr></thead><tbody>@foreach (var yearGroup in details.ChargeSchedule.GroupBy(item => item.ContractYear).OrderBy(group => group.Key)) { @foreach (var item in yearGroup) { <tr class="@(item.IsOptionalExtension ? "optional-payment-position" : null)"><td>@item.ContractYear</td><td>@item.Description</td>@if (HasStagedOperations) { <td>@ContractPartName(item.ContractServicePartId)</td> }<td>@Display(item.ExpectedInvoiceDate)</td><td>@Currency(item.ValueExVat)</td></tr> } @if (yearGroup.Count() > 1) { <tr class="contract-payment-total @(yearGroup.Any(item => item.IsOptionalExtension) ? "optional-payment-position" : null)"><td colspan="@(HasStagedOperations ? 4 : 3)">Year @yearGroup.Key total</td><td>@Currency(yearGroup.Sum(item => item.ValueExVat))</td></tr> } }</tbody></table></div>
                                }
                            </section>
                        </article>
                        <aside class="contract-side-card">
                            <section><h2>Record completeness</h2><ul class="contract-check-list"><li class="@(HasCoreDetails ? "complete" : "incomplete")"><i>@StatusMark(HasCoreDetails)</i><span>Core contract fields recorded</span></li><li class="@(HasCustomerUrn ? "complete" : "incomplete")"><i>@StatusMark(HasCustomerUrn)</i><span>@(HasCustomerUrn ? "Customer URN recorded" : "Customer URN not recorded")</span></li><li class="@(details.Evidence.Count != 0 ? "complete" : "incomplete")"><i>@StatusMark(details.Evidence.Count != 0)</i><span>@(details.Evidence.Count != 0 ? "Supporting evidence attached" : "Supporting evidence not attached")</span></li></ul></section>
                            <section><h2>Record information</h2><dl class="contract-meta-list"><div><dt>Recorded</dt><dd>@details.Contract.CreatedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</dd></div><div><dt>Reporting month</dt><dd>@details.Contract.ReportMonth</dd></div><div><dt>Evidence</dt><dd>@details.Evidence.Count file@(details.Evidence.Count == 1 ? string.Empty : "s")</dd></div><div><dt>Invoices</dt><dd>@details.Invoices.Count record@(details.Invoices.Count == 1 ? string.Empty : "s")</dd></div></dl></section>
                            <section><h2>Register source</h2>@if (SourceEvidence is not null) { <EvidenceGallery Documents="@SourceDocuments" /> } else { <p class="muted">@details.Contract.SourceWorkbook<br />Source file is not in the local archive.</p> }</section>
                        </aside>
                    </div>
                    }
                </div>
            }
            else if (activeTab == "changes")
            {
                <div class="contract-tab-panel" role="tabpanel">
                    <article class="contract-content-card">
                        <header class="contract-card-head"><div><h2>Extensions and variations</h2><p>Options are not reported until an agreement is recorded. Each agreement reports once, in its agreement month.</p></div><button class="button primary" @onclick="ToggleChangeForm">@(showChangeForm ? "Close" : "Register")</button></header>
                        @if (showChangeForm)
                        {
                            <ClipboardImageEvidence @ref="changeClipboardEvidence" OnDocumentsChanged="SetChangeClipboardDocumentCount">
                            <section class="contract-invoice-form">
                                <header class="contract-invoice-form-heading"><h3>@(EditingChange ? "Correct a contract change" : "Register a contract change")</h3><span>The agreement date determines the MI reporting month.</span></header>
                                <div class="invoice-details-grid contract-invoice-fields">
                                    <RemiPicklist Id="contract-change-kind-picklist-options" Label="Change type" Items="@ChangeKindOptions" Value="@changeKind.ToString()" ValueChanged="SetChangeKind" />
                                    <label class="floating-field floating-field--static"><input required type="date" @bind="changeAgreementDate" /><span class="floating-label">Agreement date</span></label>
                                    <label class="floating-field floating-field--static"><input type="date" @bind="changeEffectiveStartDate" /><span class="floating-label">Effective start date</span></label>
                                    <label class="floating-field floating-field--static"><input type="date" @bind="changeEffectiveEndDate" /><span class="floating-label">Effective end date</span></label>
                                    <label class="floating-field floating-field--static floating-field--currency"><b aria-hidden="true">£</b><input required type="number" step="0.01" @bind="changeIncrementalValue" @onfocus="ClearZeroIncrementalValue" /><span class="floating-label">Incremental value, ex VAT</span></label>
                                    <label class="floating-field"><input placeholder=" " @bind="changeReference" /><span class="floating-label">Agreement reference (optional)</span></label>
                                </div>
                                <div class="contract-change-checks">
                                    <label class="contract-change-flipper"><input type="checkbox" @bind="changeProvidedFor" /><span class="contract-change-flipper-control" aria-hidden="true"></span><span>Provided for in the original call-off</span></label>
                                    <label class="contract-change-flipper"><input type="checkbox" @bind="changeIsConfirmed" disabled="@ConfirmedChangeCannotBeUnconfirmed" /><span class="contract-change-flipper-control" aria-hidden="true"></span><span>@(ConfirmedChangeCannotBeUnconfirmed ? "Confirmed" : "Confirm now")</span></label>
                                </div>
                                <footer class="contract-invoice-actions"><button type="button" class="invoice-command invoice-command-muted" @onclick="ToggleChangeForm">Cancel</button><button type="button" class="invoice-command invoice-command-save" disabled="@(!CanRecordChange || changeWorking)" @onclick="SaveChangeAsync">@(changeWorking ? "Saving…" : EditingChange ? "Save correction" : "Save change")</button></footer>
                                @if (changeSubmission is not null) { <p class="notice @(changeSubmission.Succeeded ? "success" : "error")" role="status">@changeSubmission.Message</p> }
                            </section>
                            </ClipboardImageEvidence>
                        }
                        @if (details.ContractChanges.Count == 0)
                        {
                            <div class="contract-empty-inline"><strong>No agreed changes recorded</strong><span>Unexercised optional years remain outside the awarded contract value.</span></div>
                        }
                        else
                        {
                            <div class="table-wrap"><table><thead><tr><th>Type</th><th>Agreement date</th><th>Effective period</th><th>Incremental value</th><th>Confirmation</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>@foreach (var change in details.ContractChanges) { <tr><td>@change.Kind</td><td>@Display(change.AgreementDate)</td><td>@DisplayPeriod(change.EffectiveStartDate, change.EffectiveEndDate)</td><td>@Currency(change.IncrementalValueExVat)</td><td>@if (change.IsConfirmed) { <span>Confirmed</span> } else { <button class="button secondary" disabled="@(confirmingChangeId == change.Id)" @onclick="@(() => ConfirmChangeAsync(change.Id))">@(confirmingChangeId == change.Id ? "Confirming…" : "Confirm")</button> }</td><td><button class="button secondary" disabled="@changeWorking" @onclick="@(() => BeginChangeEdit(change))">Edit</button></td></tr> }</tbody></table></div>
                        }
                    </article>
                </div>
            }
            else if (activeTab == "invoices")
            {
                <div class="contract-tab-panel" role="tabpanel">
                    <article class="contract-content-card">
                        <header class="contract-card-head"><div><h2>Activity against this contract</h2><p>Invoices are prefilled from this contract and the latest reported values, then reviewed before saving.</p></div><button class="button primary" @onclick="ShowInvoiceFormAsync">@(showInvoiceForm ? "Close" : "Register")</button></header>
                        @if (showInvoiceForm)
                        {
                            <section class="contract-invoice-form">
                                <header class="contract-invoice-form-heading"><h3>Register invoice</h3><span>Review every MI report field before saving.</span></header>
                                <div class="invoice-contract-summary contract-invoice-context"><div><strong>@details.Contract.SupplierReference <span aria-hidden="true">·</span> @details.Contract.CustomerName</strong><span>@Frameworks.Get(details.Contract.Framework).DisplayName <span aria-hidden="true">·</span> @Frameworks.Get(details.Contract.Framework).AgreementNumber</span></div></div>
                                <div class="invoice-details-grid contract-invoice-fields">
                                    <label class="floating-field"><input required placeholder=" " @bind="invoiceNumber" @bind:event="oninput" /><span class="floating-label">Invoice or credit note number</span></label>
                                    <label class="floating-field floating-field--static"><input required type="date" @bind="invoiceDate" /><span class="floating-label">Invoice or credit note date</span></label>
                                    <RemiPicklist Id="contract-invoice-month-picklist-options" Label="Reporting month" Items="@InvoiceReportingMonthOptions" Value="@invoiceReportingMonth" ValueChanged="@(value => invoiceReportingMonth = value)" ItemLabel="DisplayReportingMonth" Required="true" />
                                    <label class="floating-field floating-field--static floating-field--currency"><b aria-hidden="true">£</b><input required type="number" step="0.01" @bind="invoiceTotalExVat" /><span class="floating-label">Total cost, ex VAT</span></label>
                                    @if (details.ContractChanges.Count != 0) { <RemiPicklist Id="contract-invoice-segment-picklist-options" Label="Contract segment" Items="@InvoiceContractChangeOptions" Value="@(invoiceContractChangeId?.ToString("D") ?? string.Empty)" ValueChanged="SetInvoiceContractChange" ItemLabel="InvoiceContractChangeLabel" /> }
                                </div>
                                <p class="invoice-field-help">Use a negative total for a credit note.</p>
                                <section class="contract-invoice-prefill">
                                    <p class="invoice-field-help">Contract fields use the latest recorded invoice for this contract, falling back to the contract record. Choose a lot before its dependent product or service group.</p>
                                    <div class="invoice-details-grid contract-invoice-fields">
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceCustomerName" @bind:event="oninput" /><span class="floating-label">Customer organisation name</span></label>
                                        <label class="floating-field"><input required placeholder=" " @bind="invoiceCustomerUrn" @bind:event="oninput" /><span class="floating-label">Customer URN</span></label>
                                        <RemiPicklist Id="contract-invoice-lot-picklist-options" Label="Lot number" Items="@InvoiceLotOptions" Value="@invoiceLotNumber" ValueChanged="SetInvoiceLot" ItemLabel="LotLabel" Required="true" />
                                        @if (IsVasInvoice)
                                        {
                                            <RemiPicklist Id="contract-invoice-product-group-picklist-options" Label="Product/service group level 1" Items="@InvoiceServiceGroupPicklistOptions" Value="@invoiceServiceGroup" ValueChanged="@(value => invoiceServiceGroup = value)" ItemLabel="InvoiceServiceGroupLabel" Required="true" Disabled="@(InvoiceServiceGroupOptions.Count == 0)" />
                                            <RemiPicklist Id="contract-invoice-classification-picklist-options" Label="Product/service group level 2" Items="@InvoiceServiceGroupLevel2Options" Value="@invoiceServiceGroupLevel2" ValueChanged="@(value => invoiceServiceGroupLevel2 = value)" ItemLabel="ClassificationLabel" Required="true" />
                                            <label class="floating-field"><input required placeholder=" " @bind="invoiceServiceDescription" @bind:event="oninput" /><span class="floating-label">Product/service description</span></label>
                                            <label class="floating-field"><input required placeholder=" " @bind="invoiceOriginalVendor" @bind:event="oninput" /><span class="floating-label">Original vendor</span></label>
                                            <label class="floating-field"><input required placeholder=" " @bind="invoiceSubcontractorName" @bind:event="oninput" /><span class="floating-label">Subcontractor name</span></label>
                                        }
                                        else
                                        {
                                            <RemiPicklist Id="contract-invoice-service-group-picklist-options" Label="Service group" Items="@InvoiceServiceGroupPicklistOptions" Value="@invoiceServiceGroup" ValueChanged="@(value => invoiceServiceGroup = value)" ItemLabel="InvoiceServiceGroupLabel" Required="true" Disabled="@(InvoiceServiceGroupOptions.Count == 0)" />
                                            <label class="floating-field"><input required placeholder=" " @bind="invoiceDigitalMarketplaceServiceId" @bind:event="oninput" /><span class="floating-label">Digital Marketplace service ID</span></label>
                                            <label class="floating-field"><input required placeholder=" " @bind="invoiceUnitOfMeasure" @bind:event="oninput" /><span class="floating-label">Unit of measure</span></label>
                                            <label class="floating-field"><input required type="number" step="0.01" @bind="invoiceQuantity" /><span class="floating-label">Quantity</span></label>
                                            <label class="floating-field floating-field--currency"><b aria-hidden="true">&pound;</b><input required type="number" step="0.01" @bind="invoicePricePerUnitExVat" /><span class="floating-label">Price per unit, ex VAT</span></label>
                                        }
                                    </div>
                                </section>
                                @if (InvoiceMayRevealChange) { <p class="notice warning">This invoice exceeds the remaining recorded contract value by @Currency(InvoiceOverage). It may reveal an extension or variation—record it in the Changes tab.</p> }
                                @if (SelectedInvoiceChange is { IsConfirmed: false }) { <p class="notice warning">The selected @SelectedInvoiceChange.Kind.ToString().ToLowerInvariant() is awaiting confirmation. The invoice can still be linked to it.</p> }
                                <footer class="contract-invoice-actions"><button type="button" class="invoice-command invoice-command-muted" @onclick="ShowInvoiceFormAsync">Cancel</button><button type="button" class="invoice-command invoice-command-save" disabled="@(!CanRecordInvoice || invoiceWorking)" @onclick="RecordInvoiceAsync">@(invoiceWorking ? "Saving…" : "Save invoice")</button></footer>
                                @if (invoiceSubmission is not null) { <p class="notice @(invoiceSubmission.Succeeded ? "success" : "error")" role="status">@invoiceSubmission.Message</p>@if (invoiceSubmission.Findings.Count != 0) { <ul class="findings inline-findings">@foreach (var finding in invoiceSubmission.Findings) { <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li> }</ul> } }
                            </section>
                        }
                        <section class="contract-table-section">
                            @if (details.Invoices.Count == 0)
                            {
                                <div class="contract-empty-inline"><strong>No invoices recorded</strong><span>Register the first invoice against this contract when the accounting record is available.</span></div>
                            }
                            else
                            {
                                <div class="table-wrap"><table><thead><tr><th>Invoice number</th><th>Invoice date</th><th>Reporting month</th><th>Total, ex VAT</th></tr></thead><tbody>@foreach (var invoice in details.Invoices.OrderByDescending(item => item.InvoiceDate)) { <tr><td><a class="contract-table-link" href="@InvoiceRoute(invoice.Id)">@invoice.InvoiceNumber</a></td><td>@Display(invoice.InvoiceDate)</td><td>@invoice.ReportMonth</td><td>@Currency(invoice.TotalCostExVat)</td></tr> }</tbody></table></div>
                            }
                        </section>
                    </article>
                </div>
            }
            else if (activeTab == "evidence")
            {
                <div class="contract-tab-panel" role="tabpanel">
                    <article class="contract-content-card">
                        <header class="contract-card-head"><div><h2>Supporting documents</h2><p>Files added to this contract can be deleted. Imported source evidence remains protected.</p></div></header>
                        <section class="contract-file-grid">
                            @if (details.Evidence.Count == 0)
                            {
                                <div class="contract-empty-inline"><strong>No documents linked</strong><span>Add signed contracts, pricing extracts and other supporting documents from the contract record.</span></div>
                            }
                            else
                            {
                                <EvidenceGallery Documents="@details.Evidence" OnDelete="BeginDocumentDeletion" />
                            }
                        </section>
                    </article>
                </div>
            }
            else
            {
                <div class="contract-tab-panel" role="tabpanel"><article class="contract-content-card"><header class="contract-card-head"><div><h2>Record history</h2><p>Material contract and invoice actions recorded by Remi.</p></div></header><section class="contract-history-list">@if (history.Count == 0) { <div class="contract-empty-inline"><strong>No history events are available</strong><span>The contract was registered without a matching local audit event.</span></div> } @foreach (var item in history) { <article><time>@item.OccurredAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</time><div><strong>@FriendlyAuditAction(item.Action)</strong><span>@item.Summary</span>@if (!string.IsNullOrWhiteSpace(item.Reason)) { <em>Reason: @item.Reason</em> }</div></article> }</section></article></div>
            }
        </section>
        @if (confirmingDelete && deletionImpact is not null)
        {
            <DeletionConfirmationDialog Title="@($"Delete contract {details.Contract.SupplierReference}?")"
                                        Description="This permanently deletes the contract. This action cannot be undone."
                                        Impact="@deletionImpact"
                                        RetainedMessage="Related invoices, audit history, and imported or shared documents are retained."
                                        ConfirmLabel="Delete contract"
                                        Working="@deleting"
                                        ErrorMessage="@(deleteResult is { Succeeded: false } ? deleteResult.Message : null)"
                                        OnCancel="CancelDelete"
                                        OnConfirm="DeleteAsync" />
        }
        @if (documentPendingDeletion is not null)
        {
            <DeletionConfirmationDialog Title="@($"Delete {documentPendingDeletion.FileName}?")"
                                        Description="This permanently removes this supporting document from the contract. This action cannot be undone."
                                        Impact="@NoDependentDeletionImpact"
                                        RetainedMessage="Imported source evidence and other documents are retained."
                                        ConfirmLabel="Delete document"
                                        Working="@documentDeleting"
                                        RequiresTypedConfirmation="false"
                                        ErrorMessage="@(documentDeleteResult is { Succeeded: false } ? documentDeleteResult.Message : null)"
                                        OnCancel="CancelDocumentDeletion"
                                        OnConfirm="DeleteDocumentAsync" />
        }
    </section>
}

@code {
    [Parameter] public Guid ContractId { get; set; }
