    private void PopulateOperationsEditor()
    {
        editableOperations = details?.ServiceParts
            .OrderBy(part => part.SortOrder)
            .Select(part => new EditableContractPart { Id = part.Id, Name = part.Name, GoLiveDate = part.GoLiveDate })
            .ToList() ?? [];
        EnsureSimpleOperationalPart();
        operationsStaged = editableOperations.Count > 1;
