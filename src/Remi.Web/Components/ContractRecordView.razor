    private string DefaultOperationalPartName => details is null
        ? "Whole contract"
        : string.IsNullOrWhiteSpace(details.Contract.ServiceDescription)
            ? string.IsNullOrWhiteSpace(details.Contract.ServiceGroup) ? "Whole contract" : details.Contract.ServiceGroup
            : details.Contract.ServiceDescription;
