@using System.Globalization
@using System.Net.Mail
@using Microsoft.JSInterop
@using Remi.Application
@implements IAsyncDisposable
@inject IRemiMailStore MailStore
@inject RemiMailEventService MailEvents
@inject ReportingWorkspace Workspace
@inject TimeProvider TimeProvider
@inject IJSRuntime JsRuntime

<section class="panel maintenance-panel mail-settings-panel">
    <div class="mail-capture-banner"><strong>Manual capture mode</strong><span>Every message requires an explicit Capture action. Remi can compose and retain messages, but this release cannot send them or contact Mailgun.</span></div>
    <div class="mail-settings-layout">
        <nav class="mail-template-nav" aria-label="Mail events">
            @foreach (var template in templates)
            {
                <button type="button" class="@(template.EventType == selectedEventType ? "active" : null)" @onclick="@(() => SelectTemplate(template))">
                    <span>@template.DisplayName</span><small>@TemplateStatus(template)</small>
                </button>
            }
        </nav>
        @if (selectedTemplate is not null)
        {
            <div class="mail-template-editor">
                <header><div><h2>@selectedTemplate.DisplayName</h2><p>@TemplateExplanation(selectedTemplate.EventType)</p></div><span class="mail-trigger-badge">@selectedTemplate.TriggerMode</span></header>
                <label class="contract-change-flipper"><input type="checkbox" @bind="editEnabled" /><span class="contract-change-flipper-control" aria-hidden="true"></span><span>Enable this event</span></label>
                <div class="mail-recipient-grid">
                    <label class="floating-field"><input placeholder=" " @bind="editTo" /><span class="floating-label">To</span></label>
                    <label class="floating-field"><input placeholder=" " @bind="editCc" /><span class="floating-label">Cc</span></label>
                    <label class="floating-field"><input placeholder=" " @bind="editBcc" /><span class="floating-label">Bcc</span></label>
                </div>
                <p class="caption">Separate several addresses with commas or semicolons. Display names such as <code>Jane Smith &lt;jane@example.com&gt;</code> are supported.</p>
                <div class="mail-template-content">
                    <label class="floating-field"><input required placeholder=" " @bind="editSubject" /><span class="floating-label">Subject</span></label>
                    <div class="mail-message-authoring">
                        <label class="floating-field floating-field--static mail-message-field">
                            <textarea @ref="messageEditor" required placeholder="Write the complete message in reading order." @bind="editBody" @bind:event="oninput"></textarea>
                            <span class="floating-label">Message</span>
                        </label>
                        <aside class="mail-template-placements" aria-label="Available message placements">
                            <strong>Insert into message</strong>
                            <p>Place generated content exactly where it should appear.</p>
                            <div class="mail-placement-list">
                                @foreach (var placement in AvailablePlacements)
                                {
                                    var alreadyPlaced = placement.Block && editBody.Contains(PlacementToken(placement), StringComparison.Ordinal);
                                    <button type="button" disabled="@alreadyPlaced" @onclick="@(() => InsertPlacementAsync(placement))">
                                        <code>@PlacementToken(placement)</code>
                                        <span>@placement.Label</span>
                                        @if (alreadyPlaced) { <small>Placed</small> }
                                        else if (placement.Required) { <small>Required</small> }
                                    </button>
                                }
                            </div>
                        </aside>
                    </div>
                    @if (!HasRequiredPlacement && RequiredPlacement is { } requiredPlacement)
                    {
                        <p class="mail-placement-warning" role="status">Keep <code>@PlacementToken(requiredPlacement)</code> in the message so Remi knows where to insert @requiredPlacement.Label.ToLowerInvariant().</p>
                    }
                </div>
                @if (selectedTemplate.EventType == MailEventTypes.PostSubmissionReport)
                {
                    <div class="mail-manual-capture">
                        <RemiPicklist Id="post-submission-month"
                                      Label="Reporting month"
                                      Items="@postSubmissionMonths"
                                      Value="@postSubmissionMonth"
                                      ValueChanged="@(value => postSubmissionMonth = value)"
                                      ItemLabel="ReportingMonthLabel"
                                      Searchable="true"
                                      Required="true" />
                        <p class="caption">Remi uses the latest retained image evidence for every submitted framework in this month. Missing submissions or screenshots prevent capture.</p>
                    </div>
                }
                <div class="action-row">
                    <button class="button primary" disabled="@(saving || !CanSave)" @onclick="SaveAsync">@(saving ? "Saving..." : "Save")</button>
                    @if (selectedTemplate.EventType == MailEventTypes.MonthlyActiveContracts)
                    {
                        <button class="button secondary" disabled="@(working || !selectedTemplate.Enabled || !selectedTemplate.Recipients.Any(recipient => recipient.Type == MailRecipientType.To))" @onclick="CaptureCurrentMonthlyInventoryAsync">Capture current monthly message</button>
                    }
                    else if (selectedTemplate.EventType == MailEventTypes.PostSubmissionReport)
                    {
                        <button class="button secondary" disabled="@(working || string.IsNullOrWhiteSpace(postSubmissionMonth) || !selectedTemplate.Enabled || !selectedTemplate.Recipients.Any(recipient => recipient.Type == MailRecipientType.To))" @onclick="CapturePostSubmissionReportAsync">Capture post-submission message</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <p class="notice @(succeeded ? "success" : "error")" role="status">@message</p>
                }
            </div>
        }
    </div>
</section>

<section class="panel maintenance-panel">
    <h2>Captured messages</h2>
    <p>Each row is the exact message Remi composed. Download the `.eml` to inspect it in Outlook or another mail client. Captured files are part of Remi's data backup.</p>
    @if (messages.Count == 0)
    {
        <div class="contract-empty-inline"><strong>No messages captured</strong><span>Configure an event above. Nothing has been sent.</span></div>
    }
    else
    {
        <div class="table-wrap maintenance-table"><table><thead><tr><th>Captured</th><th>Event</th><th>Subject</th><th>Recipients</th><th>Mode</th><th></th></tr></thead><tbody>
        @foreach (var item in messages)
        {
            <tr><td>@item.CreatedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</td><td>@EventName(item.EventType)</td><td><strong>@item.Subject</strong>@if (!string.IsNullOrWhiteSpace(item.SourcePeriod)) { <span class="cell-secondary">Period @item.SourcePeriod</span> }</td><td>@RecipientSummary(item)</td><td><span class="mail-capture-state">Captured</span></td><td><a class="button secondary" href="@($"/mail/{item.Id:D}/download")">Download .eml</a></td></tr>
        }
        </tbody></table></div>
    }
</section>

@code {
    private IReadOnlyList<MailTemplateDefinition> templates = [];
    private IReadOnlyList<MailMessageSummary> messages = [];
    private MailTemplateDefinition? selectedTemplate;
    private string? selectedEventType;
    private bool editEnabled;
    private string editSubject = string.Empty, editBody = string.Empty;
    private string editTo = string.Empty, editCc = string.Empty, editBcc = string.Empty;
    private IReadOnlyList<string> postSubmissionMonths = [];
    private string postSubmissionMonth = string.Empty;
    private bool saving, working, succeeded;
    private string? message;
    private ElementReference messageEditor;
    private IJSObjectReference? editorModule;
    private IReadOnlyList<MailTemplatePlacement> AvailablePlacements => PlacementsFor(selectedEventType);
    private MailTemplatePlacement? RequiredPlacement => AvailablePlacements.SingleOrDefault(placement => placement.Required);
    private bool HasRequiredPlacement => RequiredPlacement is null || editBody.Contains(PlacementToken(RequiredPlacement), StringComparison.Ordinal);
    private bool CanSave => !string.IsNullOrWhiteSpace(editSubject)
        && !string.IsNullOrWhiteSpace(editBody)
        && HasRequiredPlacement
        && (!editEnabled || TryRecipients(out var recipients, out _) && recipients.Any(recipient => recipient.Type == MailRecipientType.To));

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var templatesTask = MailStore.GetTemplatesAsync();
        var messagesTask = MailStore.GetMessagesAsync();
        var returnsTask = Workspace.GetMonthlyReturnRegisterAsync();
        await Task.WhenAll(templatesTask, messagesTask, returnsTask);
        templates = await templatesTask;
        messages = await messagesTask;
        postSubmissionMonths = (await returnsTask).ReportingMonths;
        if (!postSubmissionMonths.Contains(postSubmissionMonth, StringComparer.Ordinal))
        {
            var previousMonth = DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime).AddMonths(-1).ToString("yyyy-MM", CultureInfo.InvariantCulture);
            postSubmissionMonth = postSubmissionMonths.Contains(previousMonth, StringComparer.Ordinal)
                ? previousMonth
                : postSubmissionMonths.FirstOrDefault() ?? string.Empty;
        }
        var selection = templates.SingleOrDefault(template => template.EventType == selectedEventType) ?? templates.FirstOrDefault();
        if (selection is not null) SelectTemplate(selection);
    }

    private void SelectTemplate(MailTemplateDefinition template)
    {
        selectedTemplate = template;
        selectedEventType = template.EventType;
        editEnabled = template.Enabled;
        editSubject = template.SubjectTemplate;
        editBody = template.BodyTemplate;
        editTo = RecipientInput(template, MailRecipientType.To);
        editCc = RecipientInput(template, MailRecipientType.Cc);
        editBcc = RecipientInput(template, MailRecipientType.Bcc);
        message = null;
    }

    private async Task SaveAsync()
    {
        if (selectedTemplate is null)
        {
            succeeded = false;
            message = "Choose a mail event first.";
            return;
        }
        if (!TryRecipients(out var recipients, out var recipientError))
        {
            succeeded = false;
            message = recipientError ?? "Check the recipient addresses.";
            return;
        }
        if (editEnabled && !recipients.Any(recipient => recipient.Type == MailRecipientType.To))
        {
            succeeded = false;
            message = "Add at least one To recipient before enabling this event.";
            return;
        }
        if (!HasRequiredPlacement && RequiredPlacement is { } requiredPlacement)
        {
            succeeded = false;
            message = $"Keep {PlacementToken(requiredPlacement)} in the message before saving this event.";
            return;
        }

        saving = true;
        try
        {
            await MailStore.SaveTemplateAsync(new MailTemplateUpdate(
                selectedTemplate.EventType,
                editEnabled,
                editSubject,
                editBody,
                recipients), TimeProvider.GetUtcNow());
            var savedMessage = editEnabled
                ? "The manual Capture event is enabled. Use its Capture action when you want Remi to retain a message; Remi cannot send it."
                : "The template has been saved and remains disabled.";
            await ReloadAsync();
            succeeded = true;
            message = savedMessage;
        }
        finally { saving = false; }
    }

    private async Task CaptureCurrentMonthlyInventoryAsync()
    {
        working = true;
        try
        {
            var now = TimeProvider.GetUtcNow();
            var previousMonth = DateOnly.FromDateTime(now.LocalDateTime).AddMonths(-1).ToString("yyyy-MM", CultureInfo.InvariantCulture);
            var result = await MailEvents.CaptureMonthlyActiveContractsAsync(previousMonth, now);
            succeeded = result.Succeeded;
            message = result.Message;
            messages = await MailStore.GetMessagesAsync();
        }
        finally { working = false; }
    }

    private async Task CapturePostSubmissionReportAsync()
    {
        working = true;
        try
        {
            var result = await MailEvents.CapturePostSubmissionReportAsync(postSubmissionMonth);
            succeeded = result.Succeeded;
            message = result.Message;
            messages = await MailStore.GetMessagesAsync();
        }
        finally { working = false; }
    }

    private async Task InsertPlacementAsync(MailTemplatePlacement placement)
    {
        editorModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/mail-template-editor.js");
        await editorModule.InvokeVoidAsync("insertPlacement", messageEditor, PlacementToken(placement), placement.Block);
    }

    private bool TryRecipients(out IReadOnlyList<MailRecipient> recipients, out string? error)
    {
        var result = new List<MailRecipient>();
        foreach (var (type, input) in new[] { (MailRecipientType.To, editTo), (MailRecipientType.Cc, editCc), (MailRecipientType.Bcc, editBcc) })
        {
            var values = input.Split([',', ';', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            for (var index = 0; index < values.Length; index++)
            {
                try
                {
                    var address = new MailAddress(values[index]);
                    result.Add(new MailRecipient(Guid.NewGuid(), type, string.IsNullOrWhiteSpace(address.DisplayName) ? null : address.DisplayName, address.Address, index));
                }
                catch (FormatException)
                {
                    recipients = [];
                    error = $"'{values[index]}' is not a valid email address.";
                    return false;
                }
            }
        }
        recipients = result;
        error = null;
        return true;
    }

    private static string RecipientInput(MailTemplateDefinition template, MailRecipientType type) =>
        string.Join("; ", template.Recipients.Where(recipient => recipient.Type == type).OrderBy(recipient => recipient.SortOrder).Select(recipient => string.IsNullOrWhiteSpace(recipient.DisplayName) ? recipient.EmailAddress : $"{recipient.DisplayName} <{recipient.EmailAddress}>"));
    private static string TemplateStatus(MailTemplateDefinition template) => template.Enabled ? $"Enabled · {template.TriggerMode}" : "Disabled";
    private static string TemplateExplanation(string eventType) => eventType switch
    {
        MailEventTypes.MonthlyActiveContracts => "Manually captured for the preceding reporting month. Unreported inventory is prefixed NEW.",
        MailEventTypes.CustomerGoLive => "Manually captured from a contract after one or more parts receive an actual go-live date.",
        MailEventTypes.PostSubmissionReport => "Manually captured after GCA accepts the month's returns. The retained portal screenshots are embedded beneath their framework headings.",
        MailEventTypes.ExpiringContracts => "Reserved for a manual three-month expiry watch. The detailed selection rules will be agreed before enabling it.",
        MailEventTypes.SubmissionDeadlineReminder => "Reserved for a manual monthly submission-deadline reminder. Its exact deadline rules are not yet configured.",
        _ => "Remi mail event.",
    };
    private string EventName(string eventType) => templates.SingleOrDefault(template => template.EventType == eventType)?.DisplayName ?? eventType;
    private static string RecipientSummary(MailMessageSummary message) => string.Join(" · ", message.Recipients.GroupBy(recipient => recipient.Type).Select(group => $"{group.Key} {group.Count()}"));
    private static string PlacementToken(MailTemplatePlacement placement) => $"{{{{{placement.Token}}}}}";
    private static IReadOnlyList<MailTemplatePlacement> PlacementsFor(string? eventType) => eventType switch
    {
        MailEventTypes.MonthlyActiveContracts =>
        [
            new("active_contracts", "Active contract inventory", true, true),
            new("reporting_month", "Reporting month", false, false),
        ],
        MailEventTypes.CustomerGoLive =>
        [
            new("operational_parts", "Operational systems and dates", true, true),
            new("customer_name", "Customer name", false, false),
            new("contract_reference", "Contract reference", false, false),
            new("framework_name", "Framework name", false, false),
        ],
        MailEventTypes.PostSubmissionReport =>
        [
            new("submission_evidence", "Submission evidence", true, true),
            new("reporting_month", "Reporting month", false, false),
        ],
        MailEventTypes.ExpiringContracts =>
        [new("expiring_contracts", "Contracts approaching expiry", true, true)],
        MailEventTypes.SubmissionDeadlineReminder =>
        [new("reporting_month", "Reporting month", false, false)],
        _ => [],
    };
    private static string ReportingMonthLabel(string value) =>
        DateOnly.TryParseExact($"{value}-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? parsed.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("en-GB"))
            : value;

    public async ValueTask DisposeAsync()
    {
        if (editorModule is null) return;
        try { await editorModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private sealed record MailTemplatePlacement(string Token, string Label, bool Required, bool Block);
}
