@inject ReportingPeriodContext ReportingPeriod
@inject TimeProvider Clock
<nav class="home-view-links invoice-view-links" aria-label="Invoices view">
    <a href="@ReportingRoutes.WithPeriod("/invoices", ReportingPeriod.SelectedPeriod)" aria-current="@(!Planned ? "page" : null)">Registered</a>
    <a href="@ReportingRoutes.WithPeriod(HomeRoutes.Planned(Month ?? ContractPortfolioRules.Today(Clock)), ReportingPeriod.SelectedPeriod)" aria-current="@(Planned ? "page" : null)">Planned</a>
</nav>
@code {
    [Parameter] public bool Planned { get; set; }
    [Parameter] public DateOnly? Month { get; set; }
}
