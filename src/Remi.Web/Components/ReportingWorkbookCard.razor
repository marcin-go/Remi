<article class="return-workbook-card">
    <div class="return-workbook-card-copy">
        <strong>@Workbook.FileName</strong>
        <span>Generated <time datetime="@Workbook.ArchivedAtUtc.ToString("O")">@Workbook.ArchivedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</time> · @FormatFileSize(Workbook.FileSizeBytes)</span>
    </div>
    <a class="remi-action remi-action--section" href="@($"/evidence/{Workbook.Id}")" target="_blank">Download workbook</a>
</article>

@code {
    [Parameter, EditorRequired]
    public ReportingEvidence Workbook { get; set; } = default!;

    private static string FormatFileSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes:N0} bytes",
        < 1024 * 1024 => $"{bytes / 1024d:N1} KB",
        _ => $"{bytes / (1024d * 1024d):N1} MB",
    };
}
