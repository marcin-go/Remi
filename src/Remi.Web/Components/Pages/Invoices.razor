@page "/invoices"
@using Remi.Domain
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@implements IDisposable

<PageTitle>Remi · Invoices</PageTitle>

@if (invoices is null)
{
    <p class="loading">Loading invoice register…</p>
}
else
{
    <section class="register-page">
        <header class="dashboard-header register-page-header-compact">
            <div>
                <h1>Invoices</h1>
            </div>
            <a class="remi-action remi-action--primary" href="@PeriodRoute("invoices/new")">Register</a>
        </header>

        <section class="register-workspace register-workspace-full" id="invoice-register">
            <article class="register-card">
                <header class="register-card-header register-card-header-compact">
                    <div><h2>Find invoices and resolve issues</h2><p>Reporting failures and document gaps are shown here.</p></div>
                    <div class="register-result-count"><strong>@FilteredInvoices.Count</strong><span>matching invoices</span></div>
                </header>

                <div class="register-filters invoice-filters">
                    <label class="register-search floating-field floating-field--static"><input @bind="searchTerm" @bind:event="oninput" @bind:after="ResetPage" placeholder="Invoice, contract or customer" /><span class="floating-label">Search invoices</span></label>
                    <RemiPicklist Id="invoice-framework-filter-options" Label="Framework" Items="@FrameworkFilterItems" Value="@frameworkFilter" ValueChanged="SetFrameworkFilter" ItemLabel="FrameworkFilterLabel" />
                    <RemiPicklist Id="invoice-contract-filter-options" Label="Contract match" Items="@ContractMatchFilterItems" Value="@matchFilter" ValueChanged="SetMatchFilter" ItemLabel="ContractMatchFilterLabel" />
                    <RemiPicklist Id="invoice-document-filter-options" Label="Documents" Items="@DocumentFilterItems" Value="@evidenceFilter" ValueChanged="SetEvidenceFilter" ItemLabel="DocumentFilterLabel" />
                    <div class="filter-actions"><button class="remi-action remi-action--compact register-reset" @onclick="ResetFilters">Reset</button></div>
                    <div class="quick-filters" aria-label="Quick filters">
                        <span>Quick filters</span>
                        <button class="@QuickButtonClass("current")" @onclick="@(() => SetQuickFilter("current"))">Selected period</button>
                        <button class="@QuickButtonClass("unmatched")" @onclick="@(() => SetQuickFilter("unmatched"))">Needs a contract</button>
                        <button class="@QuickButtonClass("missing")" @onclick="@(() => SetQuickFilter("missing"))">Documents missing</button>
                    </div>
                </div>

                <div class="register-table-scroll">
                    <table class="register-table invoice-register-table">
                        <thead><tr>
                            <th aria-sort="@SortAria("invoice")"><button class="table-sort" @onclick="@(() => SortBy("invoice"))">Invoice designation <span aria-hidden="true">@SortIndicator("invoice")</span></button></th>
                            <th aria-sort="@SortAria("customer")"><button class="table-sort" @onclick="@(() => SortBy("customer"))">Customer &amp; contract <span aria-hidden="true">@SortIndicator("customer")</span></button></th>
                            <th aria-sort="@SortAria("invoiceDate")"><button class="table-sort" @onclick="@(() => SortBy("invoiceDate"))">Invoice date <span aria-hidden="true">@SortIndicator("invoiceDate")</span></button></th>
                            <th aria-sort="@SortAria("reportMonth")"><button class="table-sort" @onclick="@(() => SortBy("reportMonth"))">Reporting month <span aria-hidden="true">@SortIndicator("reportMonth")</span></button></th>
                            <th aria-sort="@SortAria("value")"><button class="table-sort" @onclick="@(() => SortBy("value"))">Value <span aria-hidden="true">@SortIndicator("value")</span></button></th>
                            <th aria-sort="@SortAria("issues")"><button class="table-sort" @onclick="@(() => SortBy("issues"))">Check <span aria-hidden="true">@SortIndicator("issues")</span></button></th>
                        </tr></thead>
                        <tbody>
                        @if (PagedInvoices.Count == 0)
                        {
                            <tr><td colspan="6" class="register-empty">No invoices match these filters.</td></tr>
                        }
                        @foreach (var invoice in PagedInvoices)
                        {
                            <tr>
                                <td><a class="register-reference" href="@InvoiceRoute(invoice.InvoiceId)">@invoice.InvoiceNumber</a></td>
                                <td><strong>@invoice.CustomerName</strong><span>@invoice.SupplierReference</span></td>
                                <td class="register-date">@DisplayDate(invoice.InvoiceDate)</td>
                                <td>@invoice.ReportMonth</td>
                                <td class="register-currency"><strong>@Currency(invoice.TotalCostExVat)</strong></td>
                                <td>
                                    @if (IssueCount(invoice) == 0)
                                    {
                                        <span class="register-status good"><i aria-hidden="true"></i>Pass</span>
                                    }
                                    else
                                    {
                                        <span class="register-status error"><i aria-hidden="true"></i>@IssueCount(invoice) issue@(IssueCount(invoice) == 1 ? string.Empty : "s")</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <footer class="register-pagination">
                    <span>Showing @FirstItem–@LastItem of @FilteredInvoices.Count invoices</span>
                    <div><button disabled="@(page == 1)" @onclick="PreviousPage" aria-label="Previous page">‹</button><strong>@(page)</strong><span>of @TotalPages</span><button disabled="@(page == TotalPages)" @onclick="NextPage" aria-label="Next page">›</button></div>
                </footer>
            </article>
        </section>
    </section>
}

@code {
    private const int PageSize = 10;
    private static readonly IReadOnlyList<string> FrameworkFilterItems = [string.Empty, .. Frameworks.All.Select(item => item.Code.ToString())];
    private static readonly IReadOnlyList<string> ContractMatchFilterItems = [string.Empty, "matched", "unmatched"];
    private static readonly IReadOnlyList<string> DocumentFilterItems = [string.Empty, "available", "missing"];
    private IReadOnlyList<InvoiceRegisterItem>? invoices;
    private string reportingMonth = string.Empty;
    private string searchTerm = string.Empty;
    private string frameworkFilter = string.Empty;
    private string matchFilter = string.Empty;
    private string evidenceFilter = string.Empty;
    private string quickFilter = string.Empty;
    private int page = 1;
    private string sortColumn = "invoice";
    private bool sortDescending = true;

    protected override async Task OnInitializedAsync()
    {
        ReportingPeriod.Changed += ReportingPeriodChanged;
        await ReloadAsync();
    }

    public void Dispose() => ReportingPeriod.Changed -= ReportingPeriodChanged;

    private async void ReportingPeriodChanged()
    {
        await InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        invoices = await Workspace.GetInvoiceRegisterAsync();
        reportingMonth = ReportingPeriod.SelectedPeriod;
    }

    private IReadOnlyList<InvoiceRegisterItem> FilteredInvoices => invoices is null
        ? []
        : SortInvoices(invoices.Where(MatchesFilters)).ToList();
    private IReadOnlyList<InvoiceRegisterItem> PagedInvoices => FilteredInvoices.Skip((page - 1) * PageSize).Take(PageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredInvoices.Count / (double)PageSize));
    private int FirstItem => FilteredInvoices.Count == 0 ? 0 : ((page - 1) * PageSize) + 1;
    private int LastItem => Math.Min(page * PageSize, FilteredInvoices.Count);

    private bool MatchesFilters(InvoiceRegisterItem invoice) =>
        (string.IsNullOrWhiteSpace(searchTerm) || invoice.InvoiceNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || invoice.SupplierReference.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || invoice.CustomerName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(frameworkFilter) || invoice.Framework.ToString() == frameworkFilter)
        && (string.IsNullOrWhiteSpace(matchFilter) || (matchFilter == "matched" && invoice.HasMatchingContract) || (matchFilter == "unmatched" && !invoice.HasMatchingContract))
        && (string.IsNullOrWhiteSpace(evidenceFilter) || (evidenceFilter == "available" && invoice.EvidenceCount > 0) || (evidenceFilter == "missing" && invoice.EvidenceCount == 0))
        && (string.IsNullOrWhiteSpace(quickFilter) || (quickFilter == "current" && invoice.ReportMonth == reportingMonth) || (quickFilter == "unmatched" && !invoice.HasMatchingContract) || (quickFilter == "missing" && invoice.EvidenceCount == 0));

    private void SetQuickFilter(string filter) { quickFilter = quickFilter == filter ? string.Empty : filter; ResetPage(); }
    private void SetFrameworkFilter(string value) { frameworkFilter = value; ResetPage(); }
    private void SetMatchFilter(string value) { matchFilter = value; ResetPage(); }
    private void SetEvidenceFilter(string value) { evidenceFilter = value; ResetPage(); }
    private static string FrameworkFilterLabel(string value) => string.IsNullOrEmpty(value)
        ? "All frameworks"
        : Enum.TryParse<FrameworkCode>(value, out var framework) ? Frameworks.Get(framework).DisplayName : value;
    private static string ContractMatchFilterLabel(string value) => value switch { "matched" => "Matched", "unmatched" => "Needs a contract", _ => "All records" };
    private static string DocumentFilterLabel(string value) => value switch { "available" => "Documents linked", "missing" => "Documents missing", _ => "All documents" };
    private void SortBy(string column)
    {
        if (sortColumn == column) sortDescending = !sortDescending;
        else { sortColumn = column; sortDescending = false; }
        ResetPage();
    }
    private string SortIndicator(string column) => sortColumn == column ? sortDescending ? "↓" : "↑" : "↕";
    private string SortAria(string column) => sortColumn == column ? sortDescending ? "descending" : "ascending" : "none";
    private IOrderedEnumerable<InvoiceRegisterItem> SortInvoices(IEnumerable<InvoiceRegisterItem> items) => (sortColumn, sortDescending) switch
    {
        ("invoice", false) => items.OrderBy(item => item.InvoiceNumber, InvoiceDesignationComparer),
        ("invoice", true) => items.OrderByDescending(item => item.InvoiceNumber, InvoiceDesignationComparer),
        ("customer", false) => items.OrderBy(item => item.CustomerName, StringComparer.OrdinalIgnoreCase).ThenBy(item => item.SupplierReference, StringComparer.OrdinalIgnoreCase),
        ("customer", true) => items.OrderByDescending(item => item.CustomerName, StringComparer.OrdinalIgnoreCase).ThenByDescending(item => item.SupplierReference, StringComparer.OrdinalIgnoreCase),
        ("invoiceDate", false) => items.OrderBy(item => item.InvoiceDate is null).ThenBy(item => item.InvoiceDate).ThenBy(item => item.InvoiceNumber, StringComparer.OrdinalIgnoreCase),
        ("invoiceDate", true) => items.OrderBy(item => item.InvoiceDate is null).ThenByDescending(item => item.InvoiceDate).ThenBy(item => item.InvoiceNumber, StringComparer.OrdinalIgnoreCase),
        ("reportMonth", false) => items.OrderBy(item => item.ReportMonth, StringComparer.Ordinal),
        ("reportMonth", true) => items.OrderByDescending(item => item.ReportMonth, StringComparer.Ordinal),
        ("value", false) => items.OrderBy(item => item.TotalCostExVat),
        ("value", true) => items.OrderByDescending(item => item.TotalCostExVat),
        ("issues", false) => items.OrderBy(IssueCount).ThenBy(item => item.InvoiceNumber, InvoiceDesignationComparer),
        ("issues", true) => items.OrderByDescending(IssueCount).ThenBy(item => item.InvoiceNumber, InvoiceDesignationComparer),
        _ => items.OrderBy(item => item.InvoiceNumber, InvoiceDesignationComparer),
    };
    private static readonly Comparer<string> InvoiceDesignationComparer = Comparer<string>.Create(CompareInvoiceDesignations);
    private static int IssueCount(InvoiceRegisterItem item) => item.Findings.Count + (item.EvidenceCount == 0 ? 1 : 0);
    private static int CompareInvoiceDesignations(string left, string right)
    {
        var leftIsNumber = long.TryParse(left, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var leftNumber);
        var rightIsNumber = long.TryParse(right, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var rightNumber);
        if (leftIsNumber && rightIsNumber)
        {
            var comparison = leftNumber.CompareTo(rightNumber);
            return comparison != 0 ? comparison : StringComparer.OrdinalIgnoreCase.Compare(left, right);
        }

        return leftIsNumber != rightIsNumber
            ? leftIsNumber ? -1 : 1
            : StringComparer.OrdinalIgnoreCase.Compare(left, right);
    }
    private void ResetPage() => page = 1;
    private void ResetFilters() { searchTerm = frameworkFilter = matchFilter = evidenceFilter = quickFilter = string.Empty; ResetPage(); }
    private void PreviousPage() => page = Math.Max(1, page - 1);
    private void NextPage() => page = Math.Min(TotalPages, page + 1);
    private string QuickButtonClass(string filter) => quickFilter == filter ? "quick-filter active" : "quick-filter";
    private static string DisplayDate(DateOnly? value) => value?.ToString("dd MMM yyyy") ?? "Not recorded";
    private static string Currency(decimal value) => value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    private string InvoiceRoute(Guid invoiceId) => PeriodRoute($"invoices/{invoiceId}");
    private string PeriodRoute(string path) => ReportingRoutes.WithPeriod($"/{path.TrimStart('/')}", ReportingPeriod.SelectedPeriod);
    private static string DisplayPeriod(string value) => DateOnly.TryParseExact($"{value}-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date) ? date.ToString("MMMM yyyy") : value;
}
