@page "/contracts/new"
@using Remi.Domain
@using Microsoft.JSInterop
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>Remi · Register contract</PageTitle>

<ClipboardImageEvidence @ref="clipboardEvidence" OnDocumentsChanged="SetClipboardImageCount">
<section class="invoice-intake-page contract-intake-page">
    <header class="invoice-intake-header">
        <div><h1>Register contract</h1><p>Choose a framework and enter the signed contract details.</p></div>
        <button type="button" class="invoice-command" @onclick="ConfirmCancelAsync">Back <span aria-hidden="true">←</span></button>
    </header>

    @if (submission is not null)
    {
        <p class="notice @(submission.Succeeded ? "success" : "error")" role="status">@submission.Message</p>
    }

    <section class="invoice-intake-surface">
        <section class="invoice-contract-section">
            <h2>Framework</h2>
            <label class="floating-field floating-field--static">
                <select aria-label="Framework" value="@selectedFramework?.ToString()" @onchange="SelectFramework">
                    <option value="">Select a framework</option>
                    @foreach (var definition in availableFrameworks)
                    {
                        <option value="@definition.Code">@definition.DisplayName (@definition.AgreementNumber)</option>
                    }
                </select>
                <span class="floating-label">Framework</span>
            </label>
        </section>

        @if (selectedFramework is FrameworkCode framework)
        {
            <section class="invoice-contract-summary contract-framework-summary">
                <div>
                    <strong>@Frameworks.Get(framework).DisplayName</strong>
                    <span>@Frameworks.Get(framework).AgreementNumber</span>
                </div>
            </section>

            <section class="invoice-details-section">
                <header><h2>Contract details</h2></header>
                <div class="invoice-details-grid">
                    <label class="floating-field"><input required @bind="supplierReference" @bind:event="oninput" placeholder=" " /><span class="floating-label">Supplier reference</span></label>
                    <div class="urn-customer-field">
                        <label class="floating-field"><input required @bind="customerName" @bind:event="oninput" @bind:after="SearchCustomerUrnsAsync" autocomplete="off" aria-autocomplete="list" aria-controls="customer-urn-suggestions" placeholder=" " /><span class="floating-label">Customer organisation</span></label>
                        @if (urnSuggestions.Count != 0)
                        {
                            <div id="customer-urn-suggestions" class="urn-suggestions" role="listbox" aria-label="Customer URN suggestions">
                                @foreach (var suggestion in urnSuggestions)
                                {
                                    <button type="button" role="option" @onclick="@(() => UseCustomerUrnSuggestion(suggestion))"><strong>@suggestion.OrganisationName</strong><span>URN @suggestion.Urn</span></button>
                                }
                            </div>
                        }
                    </div>
                    <label class="floating-field floating-field--static">
                        <select required @bind="reportingMonth">
                            @foreach (var month in ReportingMonthOptions)
                            {
                                <option value="@month">@DisplayReportingMonth(month)</option>
                            }
                        </select>
                        <span class="floating-label">Reporting month</span>
                    </label>
                    <label class="floating-field floating-field--static"><input required type="date" @bind="startDate" /><span class="floating-label">Contract start date</span></label>
                    <label class="floating-field floating-field--static"><input required type="date" @bind="endDate" /><span class="floating-label">Contract end date</span></label>
                    <label class="floating-field floating-field--static floating-field--currency"><b aria-hidden="true">£</b><input required type="number" min="0.01" step="0.01" @bind="contractValue" /><span class="floating-label">Contract value, ex VAT</span></label>
                </div>
            </section>

            <section class="invoice-details-section contract-framework-details">
                <header><h2>@(IsGCloud ? "G-Cloud details" : "VAS details")</h2></header>
                <div class="invoice-details-grid">
                    @if (IsGCloud)
                    {
                        <label class="floating-field"><input required placeholder=" " @bind="serviceGroup" @bind:event="oninput" /><span class="floating-label">Service group</span></label>
                        <label class="floating-field"><input required placeholder=" " @bind="digitalMarketplaceServiceId" @bind:event="oninput" /><span class="floating-label">Digital Marketplace service ID</span></label>
                    }
                    else
                    {
                        <label class="floating-field"><input required placeholder=" " @bind="serviceDescription" @bind:event="oninput" /><span class="floating-label">Product or service description</span></label>
                        <label class="floating-field"><input required placeholder=" " @bind="orderChannel" @bind:event="oninput" /><span class="floating-label">Order channel</span></label>
                    }
                </div>
            </section>

            <footer class="invoice-intake-actions">
                <button type="button" class="invoice-command invoice-command-muted" @onclick="ConfirmCancelAsync">Cancel</button>
                <button type="button" class="invoice-command invoice-command-save" disabled="@(!CanCreate || working)" @onclick="CreateContractAsync">@(working ? "Saving…" : "Save contract")</button>
            </footer>
        }
    </section>
</section>
</ClipboardImageEvidence>

@code {
    private FrameworkCode? selectedFramework;
    private string supplierReference = string.Empty;
    private string customerName = string.Empty;
    private string customerUrn = string.Empty;
    private string reportingMonth = string.Empty;
    private string initialReportingMonth = string.Empty;
    private DateOnly? startDate;
    private DateOnly? endDate;
    private decimal contractValue;
    private string serviceGroup = string.Empty;
    private string digitalMarketplaceServiceId = string.Empty;
    private string serviceDescription = string.Empty;
    private string orderChannel = string.Empty;
    private ReturnActionResult? submission;
    private bool working;
    private IReadOnlyList<CustomerUrnSuggestion> urnSuggestions = [];
    private ClipboardImageEvidence? clipboardEvidence;
    private int clipboardImageCount;

    private bool IsGCloud => selectedFramework is FrameworkCode framework && Frameworks.IsGCloud(framework);
    private IReadOnlyList<FrameworkDefinition> availableFrameworks =>
        Frameworks.All.Where(item => item.AllowsNewContracts).ToList();
    private bool IsValidReportingMonth => DateOnly.TryParseExact($"{reportingMonth}-01", "yyyy-MM-dd", out _);
    private bool CanCreate => selectedFramework is FrameworkCode framework && Frameworks.AllowsNewContracts(framework) && IsValidReportingMonth && !string.IsNullOrWhiteSpace(supplierReference) && !string.IsNullOrWhiteSpace(customerName) && startDate is not null && endDate is not null && contractValue > 0 && (IsGCloud ? !string.IsNullOrWhiteSpace(serviceGroup) && !string.IsNullOrWhiteSpace(digitalMarketplaceServiceId) : !string.IsNullOrWhiteSpace(serviceDescription) && !string.IsNullOrWhiteSpace(orderChannel));
    private bool HasUnsavedContractChanges => !string.IsNullOrWhiteSpace(supplierReference) || !string.IsNullOrWhiteSpace(customerName) || startDate is not null || endDate is not null || contractValue != 0 || !string.IsNullOrWhiteSpace(serviceGroup) || !string.IsNullOrWhiteSpace(digitalMarketplaceServiceId) || !string.IsNullOrWhiteSpace(serviceDescription) || !string.IsNullOrWhiteSpace(orderChannel) || reportingMonth != initialReportingMonth || clipboardImageCount != 0;
    private string ClipboardEvidenceMessage => clipboardImageCount == 0 ? "Paste images here to retain them as contract evidence." : $"{clipboardImageCount} image{(clipboardImageCount == 1 ? string.Empty : "s")} ready to add as evidence.";
    private IReadOnlyList<string> ReportingMonthOptions
    {
        get
        {
            var selectedMonth = DateOnly.TryParseExact($"{reportingMonth}-01", "yyyy-MM-dd", out var parsed)
                ? parsed
                : DateOnly.FromDateTime(DateTime.Today);
            var firstMonth = new DateOnly(selectedMonth.Year, selectedMonth.Month, 1).AddMonths(-36);
            return Enumerable.Range(0, 61).Select(offset => firstMonth.AddMonths(offset).ToString("yyyy-MM")).ToList();
        }
    }

    protected override void OnInitialized() => reportingMonth = initialReportingMonth = ReportingPeriod.SelectedPeriod;

    private void SelectFramework(ChangeEventArgs args)
    {
        if (!Enum.TryParse<FrameworkCode>(args.Value?.ToString(), out var framework) || !Frameworks.AllowsNewContracts(framework))
        {
            selectedFramework = null;
            return;
        }

        selectedFramework = framework;
        submission = null;
    }

    private async Task SearchCustomerUrnsAsync()
    {
        if (customerName.Trim().Length < 3)
        {
            urnSuggestions = [];
            return;
        }

        urnSuggestions = await Workspace.SearchCustomerUrnsAsync(customerName);
    }

    private void UseCustomerUrnSuggestion(CustomerUrnSuggestion suggestion)
    {
        customerName = suggestion.OrganisationName;
        customerUrn = suggestion.Urn;
        urnSuggestions = [];
    }

    private async Task CreateContractAsync()
    {
        if (!CanCreate || selectedFramework is null) return;
        working = true;
        try
        {
            submission = await Workspace.CreateContractAsync(new ContractEntry(selectedFramework.Value, supplierReference, customerName, customerUrn, startDate, endDate, null, IsGCloud ? serviceGroup : null, null, serviceDescription, IsGCloud ? null : orderChannel, IsGCloud ? digitalMarketplaceServiceId : null, contractValue, reportingMonth, "Manual contract registration", null));
            if (submission.Succeeded)
            {
                if (clipboardImageCount != 0 && submission.EntityId is Guid contractId)
                {
                    await clipboardEvidence!.ArchiveAsync("contract", contractId);
                }
                ResetForm();
            }
        }
        finally { working = false; }
    }

    private void ResetForm()
    {
        supplierReference = customerName = customerUrn = serviceGroup = digitalMarketplaceServiceId = serviceDescription = orderChannel = string.Empty;
        urnSuggestions = [];
        startDate = endDate = null;
        contractValue = 0;
        reportingMonth = initialReportingMonth = ReportingPeriod.SelectedPeriod;
        clipboardImageCount = 0;
    }

    private async Task ConfirmCancelAsync()
    {
        if (HasUnsavedContractChanges && !await JsRuntime.InvokeAsync<bool>("confirm", "Discard the contract details you have entered?")) return;
        Navigation.NavigateTo("/contracts");
    }

    private void SetClipboardImageCount(int count) => clipboardImageCount = count;

    private static string DisplayReportingMonth(string month) => DateOnly.TryParseExact($"{month}-01", "yyyy-MM-dd", out var parsed) ? parsed.ToString("MMMM yyyy") : month;
}
