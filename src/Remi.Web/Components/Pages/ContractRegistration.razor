@page "/contracts/new"
@using Remi.Domain
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod

<PageTitle>Remi · Register contract</PageTitle>

<section class="registration-page">
    <nav class="register-breadcrumbs" aria-label="Breadcrumb"><a href="/contracts">Contracts</a><span aria-hidden="true">›</span><span>Register contract</span></nav>

    <header class="registration-heading">
        <div><p class="eyebrow">Contract intake</p><h1>Register a signed contract</h1><p class="lede">Start with the framework, then record the required contract details.</p></div>
        <a class="button secondary" href="/contracts">Back ←</a>
    </header>

    @if (selectedFramework is null)
    {
        <section class="framework-choice-panel" aria-labelledby="choose-framework">
            <p class="eyebrow">Step 1 of 2</p>
            <h2 id="choose-framework">Which framework is this contract for?</h2>
            <p>Choose an agreement that is open to new contracts to load the right set of fields. Reporting-only frameworks remain available for invoices against existing contract records.</p>
            <div class="framework-choice-grid">
                @foreach (var definition in availableFrameworks)
                {
                    <button class="framework-choice" @onclick="@(() => SelectFramework(definition.Code))">
                        <span>@definition.AgreementNumber</span><strong>@definition.DisplayName</strong><small>@FrameworkFieldsSummary(definition.Code)</small><b>Continue <span aria-hidden="true">→</span></b>
                    </button>
                }
            </div>
        </section>
    }
    else
    {
        <section class="registration-framework-context">
            <span>Framework</span><strong>@Frameworks.Get(selectedFramework.Value).DisplayName (@Frameworks.Get(selectedFramework.Value).AgreementNumber)</strong><button @onclick="ChooseAnotherFramework">Change</button>
        </section>

        @if (submission is not null)
        {
            <p class="notice @(submission.Succeeded ? "success" : "error")" role="status">@submission.Message</p>
        }

        <section class="registration-form-panel">
            <header><p class="eyebrow">Step 2 of 2</p><h2>Contract information</h2><p>All fields below are required to create a usable contract record.</p></header>
            <div class="registration-section"><h3>Shared register details</h3>
                <div class="form-grid">
                    <label>Supplier reference <span class="required">required</span><input required @bind="supplierReference" @bind:event="oninput" placeholder="e.g. ABC_202608_GMS" /></label>
                    <div class="urn-customer-field">
                        <label>Customer organisation <span class="required">required</span><input required @bind="customerName" @bind:event="oninput" @bind:after="SearchCustomerUrnsAsync" autocomplete="off" aria-autocomplete="list" aria-controls="customer-urn-suggestions" /></label>
                        @if (urnSuggestions.Count != 0)
                        {
                            <div id="customer-urn-suggestions" class="urn-suggestions" role="listbox" aria-label="Customer URN suggestions">
                                @foreach (var suggestion in urnSuggestions)
                                {
                                    <button type="button" role="option" @onclick="@(() => UseCustomerUrnSuggestion(suggestion))"><strong>@suggestion.OrganisationName</strong><span>URN @suggestion.Urn</span></button>
                                }
                            </div>
                        }
                    </div>
                    <label>Reporting month <span class="required">required</span><input required inputmode="numeric" pattern="[0-9]{4}-[0-9]{2}" placeholder="YYYY-MM" @bind="reportingMonth" @bind:event="oninput" /></label>
                    <label>Contract start date <span class="required">required</span><input required type="date" @bind="startDate" /></label>
                    <label>Contract end date <span class="required">required</span><input required type="date" @bind="endDate" /></label>
                    <label>Contract value, ex VAT <span class="required">required</span><input required type="number" min="0.01" step="0.01" @bind="contractValue" /></label>
                </div>
            </div>

            @if (IsGCloud)
            {
                <section class="registration-section framework-fields"><h3>G-Cloud contract details</h3>
                    <div class="form-grid">
                        <label>Service group <span class="required">required</span><input required @bind="serviceGroup" @bind:event="oninput" /></label>
                        <label>Digital Marketplace service ID <span class="required">required</span><input required @bind="digitalMarketplaceServiceId" @bind:event="oninput" /></label>
                    </div>
                </section>
            }
            else
            {
                <section class="registration-section framework-fields"><h3>VAS contract details</h3>
                    <div class="form-grid">
                        <label>Product or service description <span class="required">required</span><input required @bind="serviceDescription" @bind:event="oninput" /></label>
                        <label>Order channel <span class="required">required</span><input required @bind="orderChannel" @bind:event="oninput" /></label>
                    </div>
                </section>
            }

            <div class="action-row"><button class="button primary" disabled="@(!CanCreate || working)" @onclick="CreateContractAsync">@(working ? "Registering…" : "Register")</button><a class="button secondary" href="/contracts">Cancel</a></div>
        </section>
    }
</section>

@code {
    private FrameworkCode? selectedFramework;
    private string supplierReference = string.Empty;
    private string customerName = string.Empty;
    private string customerUrn = string.Empty;
    private string reportingMonth = string.Empty;
    private DateOnly? startDate;
    private DateOnly? endDate;
    private decimal contractValue;
    private string serviceGroup = string.Empty;
    private string digitalMarketplaceServiceId = string.Empty;
    private string serviceDescription = string.Empty;
    private string orderChannel = string.Empty;
    private ReturnActionResult? submission;
    private bool working;
    private IReadOnlyList<CustomerUrnSuggestion> urnSuggestions = [];

    private bool IsGCloud => selectedFramework is FrameworkCode framework && Frameworks.IsGCloud(framework);
    private IReadOnlyList<FrameworkDefinition> availableFrameworks =>
        Frameworks.All.Where(item => item.AllowsNewContracts).ToList();
    private bool IsValidReportingMonth => DateOnly.TryParseExact($"{reportingMonth}-01", "yyyy-MM-dd", out _);
    private bool CanCreate => selectedFramework is FrameworkCode framework && Frameworks.AllowsNewContracts(framework) && IsValidReportingMonth && !string.IsNullOrWhiteSpace(supplierReference) && !string.IsNullOrWhiteSpace(customerName) && startDate is not null && endDate is not null && contractValue > 0 && (IsGCloud ? !string.IsNullOrWhiteSpace(serviceGroup) && !string.IsNullOrWhiteSpace(digitalMarketplaceServiceId) : !string.IsNullOrWhiteSpace(serviceDescription) && !string.IsNullOrWhiteSpace(orderChannel));

    protected override void OnInitialized() => reportingMonth = ReportingPeriod.SelectedPeriod;

    private void SelectFramework(FrameworkCode framework)
    {
        if (!Frameworks.AllowsNewContracts(framework))
        {
            return;
        }

        selectedFramework = framework;
        submission = null;
    }
    private void ChooseAnotherFramework() { selectedFramework = null; submission = null; }

    private async Task SearchCustomerUrnsAsync()
    {
        if (customerName.Trim().Length < 3)
        {
            urnSuggestions = [];
            return;
        }

        urnSuggestions = await Workspace.SearchCustomerUrnsAsync(customerName);
    }

    private void UseCustomerUrnSuggestion(CustomerUrnSuggestion suggestion)
    {
        customerName = suggestion.OrganisationName;
        customerUrn = suggestion.Urn;
        urnSuggestions = [];
    }

    private async Task CreateContractAsync()
    {
        if (!CanCreate || selectedFramework is null) return;
        working = true;
        try
        {
            submission = await Workspace.CreateContractAsync(new ContractEntry(selectedFramework.Value, supplierReference, customerName, customerUrn, startDate, endDate, null, IsGCloud ? serviceGroup : null, null, serviceDescription, IsGCloud ? null : orderChannel, IsGCloud ? digitalMarketplaceServiceId : null, contractValue, reportingMonth, "Manual contract registration", null));
            if (submission.Succeeded) ResetForm();
        }
        finally { working = false; }
    }

    private void ResetForm()
    {
        supplierReference = customerName = customerUrn = serviceGroup = digitalMarketplaceServiceId = serviceDescription = orderChannel = string.Empty;
        urnSuggestions = [];
        startDate = endDate = null;
        contractValue = 0;
    }

    private static string FrameworkFieldsSummary(FrameworkCode framework) => Frameworks.IsGCloud(framework) ? "Shared details, service group and Digital Marketplace service ID" : "Shared details, product/service description and order channel";
}
