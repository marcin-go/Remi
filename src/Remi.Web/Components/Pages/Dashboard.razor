@page "/home"
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@implements IDisposable

<PageTitle>Remi · Home</PageTitle>

@if (model is not null)
{
    <section class="dashboard-page">
        <header class="dashboard-header">
            <div>
                <h1>Reporting overview</h1>
                <p class="lede">Review return readiness, resolve exceptions and retain a clear audit trail for <strong>@DisplayPeriod(model.CurrentReportingMonth)</strong>.</p>
            </div>
            <a class="remi-action remi-action--primary" href="@PeriodRoute("/reports")">Prepare →</a>
        </header>

        <section class="dashboard-period-summary" aria-label="Current reporting period">
            <div class="dashboard-period-current"><span>Reporting period</span><strong>@DisplayPeriod(model.CurrentReportingMonth)</strong></div>
            <dl class="dashboard-metrics">
                <div><dt>Contracts</dt><dd>@model.FrameworkReadiness.Sum(item => item.ContractCount)</dd></div>
                <div><dt>Invoices</dt><dd>@model.FrameworkReadiness.Sum(item => item.InvoiceCount)</dd></div>
                <div><dt>Ready</dt><dd>@model.FrameworkReadiness.Count(IsReady)</dd></div>
                <div class="@ExceptionMetricClass()"><dt>Exceptions</dt><dd>@model.Findings.Count</dd></div>
            </dl>
        </section>

        <section class="dashboard-layout">
            <article class="dashboard-readiness">
                <header class="dashboard-section-heading">
                    <div><h2>Return readiness</h2><p>Frameworks included in the @DisplayPeriod(model.CurrentReportingMonth) reporting period.</p></div>
                </header>
                <div class="dashboard-table-scroll">
                    <table class="dashboard-table">
                        <thead><tr><th>Framework</th><th>Contracts</th><th>Invoices</th><th>Readiness</th><th class="table-action-cell"><span class="visually-hidden">Action</span></th></tr></thead>
                        <tbody>
                            @foreach (var summary in model.FrameworkReadiness)
                            {
                                <tr>
                                    <td><strong>@summary.Framework.DisplayName</strong><span>@summary.Framework.AgreementNumber</span></td>
                                    <td>@summary.ContractCount</td>
                                    <td>@summary.InvoiceCount</td>
                                    <td><span class="@ReadinessClass(summary)">@ReadinessLabel(summary)</span></td>
                                    <td class="table-action-cell"><a class="remi-action remi-action--table dashboard-row-action" href="@ReturnWorkspaceRoute(summary)">@ReadinessAction(summary)</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>

            <div class="dashboard-secondary">
                <article class="dashboard-attention">
                    <header class="dashboard-section-heading">
                        <div><h2>Needs attention</h2></div>
                    </header>
                    @if (model.AttentionItems.Count == 0)
                    {
                        <p class="dashboard-empty">No validation issues have been found for this reporting period.</p>
                    }
                    else
                    {
                        @if (BlockingItems.Count != 0)
                        {
                            <section class="attention-group blocking"><h3>Blocking preparation</h3><ul>
                                @foreach (var attention in BlockingItems)
                                {
                                    <li><a href="@PeriodRoute(attention.Route)"><strong>@FriendlyFinding(attention.Finding.Code)</strong><span>@attention.Finding.Message</span></a></li>
                                }
                            </ul></section>
                        }
                        @if (ReviewItems.Count != 0)
                        {
                            <section class="attention-group review"><h3>Review recommended</h3><ul>
                                @foreach (var attention in ReviewItems)
                                {
                                    <li><a href="@PeriodRoute(attention.Route)"><strong>@FriendlyFinding(attention.Finding.Code)</strong><span>@attention.Finding.Message</span></a></li>
                                }
                            </ul></section>
                        }
                    }
                </article>

                <article class="dashboard-activity">
                    <header class="dashboard-section-heading">
                        <div><h2>Recent activity</h2></div>
                        <a class="remi-action remi-action--section" href="@PeriodRoute("/settings?section=audit")">View →</a>
                    </header>
                    @if (model.RecentActivity.Count == 0)
                    {
                        <p class="dashboard-empty">No material activity has been recorded yet.</p>
                    }
                    else
                    {
                        <ol class="dashboard-activity-list">
                            @foreach (var activity in model.RecentActivity)
                            {
                                <li><time>@activity.OccurredAtUtc.LocalDateTime.ToString("dd MMM, HH:mm")</time><span><strong>@FriendlyActivity(activity.Action)</strong>@activity.Summary</span></li>
                            }
                        </ol>
                    }
                </article>
            </div>
        </section>
    </section>
}
else if (model is null)
{
    <p class="loading">Loading your reporting workspace…</p>
}
else
{
    <section class="page-heading">
        <div>
            <p class="eyebrow">Monthly management information</p>
            <h1>Keep every return defensible.</h1>
            <p class="lede">Remi keeps the contract, invoice and submission trail together. The current reporting month is <strong>@model.CurrentReportingMonth</strong>.</p>
        </div>
        <a class="button primary" href="/reports">Prepare →</a>
    </section>

    <section class="framework-grid" aria-label="Framework reporting summary">
        @foreach (var summary in model.Frameworks)
        {
            <article class="framework-card">
                <p class="eyebrow">@summary.Framework.AgreementNumber</p>
                <h2>@summary.Framework.DisplayName</h2>
                <p class="muted">@ReturnLabel(summary.CurrentReturnStatus)</p>
                <dl class="metric-list">
                    <div><dt>Contracts</dt><dd>@summary.ContractCount</dd></div>
                    <div><dt>Invoices</dt><dd>@summary.InvoiceCount</dd></div>
                    <div><dt>Submitted</dt><dd>@summary.SubmittedReturnCount</dd></div>
                </dl>
            </article>
        }
    </section>

    <section class="two-column">
        <article class="panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Contract progress</p>
                    <h2>Reported invoicing</h2>
                </div>
                <a href="contracts">View all contracts</a>
            </div>
            @if (model.ContractProgress.Count == 0)
            {
                <div class="empty-state">
                    <p>No contract data yet.</p>
                    <a class="button secondary" href="/reports">Import →</a>
                </div>
            }
            else
            {
                <div class="progress-list">
                    @foreach (var contract in model.ContractProgress.OrderByDescending(IsOverrun).ThenBy(item => item.CompletionRatio).Take(6))
                    {
                        <div class="progress-row @(IsOverrun(contract) ? "overrun-progress" : null)">
                            <div class="progress-label">
                                <strong><a href="@($"/contracts/{contract.ContractId}")">@contract.SupplierReference</a></strong>
                                <span>@contract.CustomerName</span>
                            </div>
                            <div class="progress-track" aria-label="@contract.SupplierReference">
                                <span class="progress-fill @(IsOverrun(contract) ? "overrun" : null)" style="width: @ProgressWidth(contract.CompletionRatio)"></span>
                            </div>
                            <div class="progress-value">@Percentage(contract.CompletionRatio)</div>
                        </div>
                    }
                </div>
                    <p class="caption">Progress compares reported invoices with the contract value until an invoice plan is added. Values above 100% need review.</p>
            }
        </article>

        <article class="panel findings-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Data quality</p>
                    <h2>Needs attention</h2>
                </div>
                <a href="/reports">Review returns</a>
            </div>
            @if (model.Findings.Count == 0)
            {
                <div class="empty-state compact"><p>No validation issues have been found.</p></div>
            }
            else
            {
                <ul class="findings">
                    @foreach (var attention in model.AttentionItems.Take(6))
                    {
                        <li class="@attention.Finding.Severity.ToString().ToLowerInvariant()">
                            <a class="finding-link" href="@attention.Route">
                                <strong>@FriendlyFinding(attention.Finding.Code)</strong>
                                <span>@attention.Finding.Message</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>
}

@code {
    private DashboardModel? model;

    private IReadOnlyList<AttentionItem> BlockingItems => model?.AttentionItems
        .Where(item => item.Finding.Severity == FindingSeverity.Error)
        .ToList() ?? [];

    private IReadOnlyList<AttentionItem> ReviewItems => model?.AttentionItems
        .Where(item => item.Finding.Severity == FindingSeverity.Warning)
        .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        ReportingPeriod.Changed += ReportingPeriodChanged;
        await ReloadAsync();
    }

    public void Dispose() => ReportingPeriod.Changed -= ReportingPeriodChanged;

    private async void ReportingPeriodChanged()
    {
        await InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync() => model = await Workspace.GetDashboardAsync(ReportingPeriod.SelectedPeriod);

    private string PeriodRoute(string path)
        => ReportingRoutes.WithPeriod(path, ReportingPeriod.SelectedPeriod);

    private string ReturnWorkspaceRoute(FrameworkReadiness summary)
        => $"/reports/{(int)summary.Framework.Code}/{model!.CurrentReportingMonth}?period={model.CurrentReportingMonth}";

    private static bool IsReady(FrameworkReadiness summary) =>
        summary.BlockingFindingCount == 0
        && summary.ContractCount + summary.InvoiceCount > 0
        && summary.ReturnStatus is not ReturnStatus.Submitted;

    private static string ReadinessClass(FrameworkReadiness summary) =>
        summary.BlockingFindingCount > 0 ? "readiness-status error"
        : summary.ReviewFindingCount > 0 ? "readiness-status warning"
        : summary.ReturnStatus == ReturnStatus.Submitted ? "readiness-status complete"
        : summary.ContractCount + summary.InvoiceCount == 0 ? "readiness-status neutral"
        : "readiness-status ready";

    private static string ReadinessLabel(FrameworkReadiness summary)
    {
        if (summary.BlockingFindingCount > 0)
        {
            return $"{summary.BlockingFindingCount} blocking issue{(summary.BlockingFindingCount == 1 ? string.Empty : "s")}";
        }

        if (summary.ReviewFindingCount > 0)
        {
            return $"{summary.ReviewFindingCount} exception{(summary.ReviewFindingCount == 1 ? string.Empty : "s")}";
        }

        return summary.ReturnStatus switch
        {
            ReturnStatus.Submitted => "Submitted",
            ReturnStatus.NilReturn => "Nil return recorded",
            ReturnStatus.CorrectionRequired => "Correction required",
            ReturnStatus.Draft => "In progress",
            _ when summary.ContractCount + summary.InvoiceCount == 0 => "Not started",
            _ => "Ready to review",
        };
    }

    private static string ReadinessAction(FrameworkReadiness summary) =>
        summary.BlockingFindingCount + summary.ReviewFindingCount > 0 ? "Review →" : "Open →";

    private string? ExceptionMetricClass() =>
        BlockingItems.Count != 0 ? "has-blocking-exceptions"
        : ReviewItems.Count != 0 ? "has-review-exceptions"
        : null;

    private static string DisplayPeriod(string period) =>
        DateOnly.ParseExact($"{period}-01", "yyyy-MM-dd").ToString("MMMM yyyy");

    private static string ReturnLabel(ReturnStatus? status) => status switch
    {
        ReturnStatus.Draft => "This month: draft return",
        ReturnStatus.Submitted => "This month: submitted",
        ReturnStatus.NilReturn => "This month: nil return recorded",
        ReturnStatus.CorrectionRequired => "This month: correction required",
        _ => "This month: not started",
    };

    private static bool IsOverrun(ContractProgress contract) => contract.ComparisonValueExVat > 0 && contract.ReportedInvoiceValueExVat > contract.ComparisonValueExVat;

    private static string Percentage(decimal ratio) => $"{Math.Max(ratio * 100, 0):0}%";

    private static string ProgressWidth(decimal ratio) => $"{Math.Clamp(ratio * 100, 0, 100):0}%";

    private static string FriendlyFinding(string code) => code switch
    {
        "ContractEndBeforeStart" => "Contract dates need correcting",
        "InvoiceContractNotFound" => "Invoice needs a matching contract",
        "ContractMissingSupplierReference" => "Contract is missing a supplier reference",
        "ContractMissingCustomer" => "Contract is missing a customer",
        "ContractMissingValue" => "Contract value needs correcting",
        _ => "Data quality issue",
    };

    private static string FriendlyActivity(string action) => action switch
    {
        "ContractCreated" => "Contract registered",
        "ContractUpdated" => "Contract updated",
        "InvoiceImported" => "Invoice imported",
        "InvoiceRecorded" => "Invoice registered",
        "InvoiceUpdated" => "Invoice updated",
        "ReturnExported" => "Review workbook generated",
        "ReturnSubmitted" => "Return submitted",
        "NilReturnRecorded" => "Nil return recorded",
        "CorrectionRequested" => "Correction requested",
        _ => action,
    };
}
