@using Microsoft.AspNetCore.Components
@inject ReportingWorkspace Workspace

@if (IsTemplatesView)
{
<section class="panel template-registration-panel">
    <div class="panel-heading">
        <div>
            <h2>Register a GCA approved workbook</h2>
            <p class="caption">Choose the approved workbook for a framework. The original workbook name is retained in the template history.</p>
        </div>
    </div>
    <div class="template-registration-fields">
        <div class="form-grid">
            <RemiPicklist Id="template-framework-picklist-options"
                          Label="Framework"
                          Items="@TemplateFrameworkOptions"
                          Value="@templateFramework.ToString()"
                          ValueChanged="SetTemplateFramework"
                          ItemLabel="TemplateFrameworkLabel"
                          ItemGroup="TemplateFrameworkGroup"
                          Required="true" />
        </div>
    </div>
    <label class="template-file-dropzone @(selectedTemplateFile is null ? null : "has-selection")">
        <InputFile class="template-file-input" OnChange="SelectTemplateFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
        <span class="template-file-icon" aria-hidden="true">&#8682;</span>
        <strong>Drop approved workbook here</strong>
        <span>or select an .xlsx file</span>
    </label>
    @if (selectedTemplateFile is not null)
    {
        <div class="template-file-selection" role="status">
            <span>Selected workbook</span>
            <strong>@selectedTemplateFile.Name</strong>
            <small>@FormatFileSize(selectedTemplateFile.Size)</small>
        </div>
    }
    <div class="action-row template-registration-actions">
        <button class="button primary" disabled="@(!CanRegisterTemplate || working)" @onclick="RegisterTemplateAsync">REGISTER</button>
    </div>
    <p class="caption">The workbook is retained as immutable evidence. Register a replacement approved workbook when the framework template changes; the prior workbook remains in the archive.</p>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="notice @(succeeded ? "success" : "error")">@message</p>
}
@if (findings.Count != 0)
{
    <ul class="findings inline-findings">
        @foreach (var finding in findings)
        {
            <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li>
        }
    </ul>
}

<section class="panel template-panel">
    <div class="panel-heading">
        <div>
            <h2>Template history</h2>
        </div>
    </div>
    @if (templates.Count == 0)
    {
        <div class="empty-state compact"><p>No approved MI template has been registered yet.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Framework</th><th>Workbook</th><th>Status</th><th>Registered</th></tr></thead>
                <tbody>
                    @foreach (var template in templates)
                    {
                        <tr>
                            <td>@Frameworks.Get(template.Framework).DisplayName</td>
                            <td>@template.WorkbookName</td>
                            <td>@(template.IsActive ? "Active" : "Superseded")</td>
                            <td>@template.RegisteredAtUtc.LocalDateTime.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
}

@if (IsAuditView)
{
<section class="panel audit-panel">
    <div class="panel-heading">
        <div>
            <h2>Recent audit events</h2>
        </div>
    </div>
    @if (auditEvents.Count == 0)
    {
        <div class="empty-state compact"><p>Material reporting actions will appear here.</p></div>
    }
    else
    {
        <div class="audit-controls">
            <RemiPicklist Id="audit-action-picklist-options"
                          Label="Event type"
                          Items="@AuditActionOptions"
                          Value="@auditActionFilter"
                          ValueChanged="SetAuditActionFilter"
                          ItemLabel="AuditActionLabel" />
            <span class="muted">Showing @VisibleAuditEvents.Count of @auditEvents.Count events</span>
        </div>
        <ol class="audit-list">
            @foreach (var item in VisibleAuditEvents.Take(auditLimit))
            {
                <li>
                    <time datetime="@item.OccurredAtUtc.ToString("O")">@item.OccurredAtUtc.LocalDateTime.ToString("dd MMM yyyy HH:mm")</time>
                    <div><strong>@FriendlyAuditAction(item.Action)</strong><span>@item.Summary</span>@if (!string.IsNullOrWhiteSpace(item.Reason)) { <em>Reason: @item.Reason</em> }</div>
                </li>
            }
        </ol>
        @if (VisibleAuditEvents.Count > auditLimit)
        {
            <div class="action-row"><button class="button secondary" @onclick="ShowMoreAuditEvents">Show</button></div>
        }
    }
</section>
}

@code {
    [Parameter]
    public string View { get; set; } = "templates";

    private FrameworkCode templateFramework = FrameworkCode.GCloud14;
    private IBrowserFile? selectedTemplateFile;
    private IReadOnlyList<TemplateConfigurationSummary> templates = [];
    private IReadOnlyList<AuditEventSummary> auditEvents = [];
    private IReadOnlyList<ValidationFinding> findings = [];
    private string? message;
    private bool succeeded;
    private bool working;
    private string auditActionFilter = string.Empty;
    private int auditLimit = 15;

    private bool IsTemplatesView => !string.Equals(View, "audit", StringComparison.OrdinalIgnoreCase);

    private bool IsAuditView => string.Equals(View, "audit", StringComparison.OrdinalIgnoreCase);

    private bool CanRegisterTemplate => selectedTemplateFile is not null;

    private static IReadOnlyList<string> TemplateFrameworkOptions => Frameworks.All
        .OrderBy(definition => definition.IsHistorical)
        .ThenBy(definition => definition.DisplayName, StringComparer.OrdinalIgnoreCase)
        .Select(definition => definition.Code.ToString())
        .ToList();

    private IReadOnlyList<string> AuditActionOptions =>
        [string.Empty, .. auditEvents.Select(item => item.Action).Distinct().OrderBy(FriendlyAuditAction, StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyList<AuditEventSummary> VisibleAuditEvents => auditEvents
        .Where(item => string.IsNullOrWhiteSpace(auditActionFilter) || item.Action == auditActionFilter)
        .ToList();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private void SetTemplateFramework(string value)
    {
        if (Enum.TryParse<FrameworkCode>(value, out var framework))
        {
            templateFramework = framework;
        }
    }

    private void SetAuditActionFilter(string value) => auditActionFilter = value;

    private static string TemplateFrameworkLabel(string value)
    {
        var definition = Frameworks.Get(Enum.Parse<FrameworkCode>(value));
        return $"{definition.DisplayName} ({definition.AgreementNumber})";
    }

    private static string? TemplateFrameworkGroup(string value) =>
        Frameworks.Get(Enum.Parse<FrameworkCode>(value)).IsHistorical ? "Historical" : "Live";

    private static string AuditActionLabel(string value) =>
        string.IsNullOrEmpty(value) ? "All activity" : FriendlyAuditAction(value);

    private void SelectTemplateFile(InputFileChangeEventArgs args)
    {
        selectedTemplateFile = args.File;
        message = null;
        findings = [];
    }

    private async Task RegisterTemplateAsync()
    {
        if (selectedTemplateFile is null)
        {
            return;
        }

        working = true;
        message = null;
        findings = [];
        try
        {
            await using var stream = selectedTemplateFile.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            var result = await Workspace.RegisterTemplateAsync(templateFramework, selectedTemplateFile.Name, stream);
            succeeded = result.Succeeded;
            message = result.Message;
            findings = result.Findings;
            if (result.Succeeded)
            {
                selectedTemplateFile = null;
            }
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            succeeded = false;
            message = $"The template could not be registered: {exception.Message}";
        }
        finally
        {
            working = false;
        }
    }

    private async Task ReloadAsync()
    {
        templates = await Workspace.GetTemplateConfigurationsAsync();
        auditEvents = await Workspace.GetAuditEventsAsync();
    }

    private void ShowMoreAuditEvents() => auditLimit += 15;

    private static string FormatFileSize(long bytes) => bytes < 1024 * 1024
        ? $"{Math.Max(1, Math.Ceiling(bytes / 1024d)):N0} KB"
        : $"{bytes / 1024d / 1024d:N1} MB";

    private static string FriendlyAuditAction(string action) => action switch
    {
        "WorkbookImported" => "Workbook imported",
        "HistoricalWorkbookImported" => "Historical workbook imported",
        "HistoricalReturnRecordedAsSubmitted" => "Historical return recorded as submitted",
        "HistoricalNilReturnRecorded" or "HistoricalDraftReturnRecordedAsNil" => "Historical nil return recorded",
        "ContractImported" => "Contract imported",
        "InvoiceImported" => "Invoice imported",
        "EvidenceArchived" => "Evidence archived",
        "LedgerPaymentScheduleImported" => "Ledger payment schedule imported",
        "ContractCreated" => "Contract created",
        "InvoiceRecorded" => "Invoice recorded",
        "ChargeScheduled" => "Charge scheduled",
        "TemplateRegistered" => "Template registered",
        "ReturnExported" => "Review workbook generated",
        "ReturnSubmitted" => "Return submitted",
        "NilReturnRecorded" => "Nil return recorded",
        "CorrectionRequested" => "Correction requested",
        _ => action,
    };
}
