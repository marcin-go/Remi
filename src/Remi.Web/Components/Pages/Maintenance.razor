@page "/settings"
@using Microsoft.AspNetCore.Components
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod

<PageTitle>Remi · Settings</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Settings</p>
        <h1>Configure Remi.</h1>
        <p class="lede">Manage framework reporting dates, customer reference data and approved workbooks.</p>
    </div>
</section>

<section class="settings-layout">
    <aside class="panel settings-side-menu">
        <p class="eyebrow">Settings menu</p>
        <nav class="settings-side-nav" aria-label="Settings sections">
            <a class="@SectionLinkClass(FrameworksSection)" href="@SectionLink(FrameworksSection)">Frameworks</a>
            <a class="@SectionLinkClass(CustomerUrnsSection)" href="@SectionLink(CustomerUrnsSection)">Customer URNs</a>
            <a class="@SectionLinkClass(TemplatesSection)" href="@SectionLink(TemplatesSection)">Templates</a>
            <a class="@SectionLinkClass(AuditSection)" href="@SectionLink(AuditSection)">Audit</a>
        </nav>
    </aside>
    <div class="settings-content">
@if (ActiveSection == FrameworksSection)
{
<section class="panel maintenance-panel">
    <p class="eyebrow">Framework catalogue</p>
    <h2>Framework reporting start dates</h2>
    <p>These dates determine when Remi includes each supported framework in its report register and dashboard readiness. The calendar month containing a start date is included.</p>
    @if (frameworkConfigurations.Count == 0)
    {
        <p class="muted">Loading framework settings…</p>
    }
    else
    {
        <div class="action-row">
            @if (editingFrameworks)
            {
                <button class="button primary" disabled="@(!CanSaveFrameworkChanges)" @onclick="SaveFrameworkChangesAsync">@(savingFrameworks ? "Saving…" : "Save")</button>
                <button class="button secondary" disabled="@working" @onclick="CancelFrameworkEdit">Cancel</button>
            }
            else
            {
                <button class="button secondary" disabled="@working" @onclick="BeginFrameworkEdit">Edit</button>
            }
        </div>
        <div class="table-wrap maintenance-table">
            <table>
                <thead><tr><th>Framework</th><th>Agreement</th><th>Reporting start date</th></tr></thead>
                <tbody>
                    @foreach (var configuration in frameworkConfigurations)
                    {
                        <tr>
                            <td><strong>@configuration.Framework.DisplayName</strong><span class="cell-secondary">@configuration.Framework.ReportingAuthority</span></td>
                            <td>@configuration.Framework.AgreementNumber</td>
                            @if (editingFrameworks)
                            {
                                var fieldId = $"framework-start-{configuration.Framework.Code}";
                                <td>
                                    <label class="visually-hidden" for="@fieldId">@configuration.Framework.DisplayName reporting start date</label>
                                    <input id="@fieldId" type="date" value="@FrameworkStartDateValue(configuration.Framework.Code)" @onchange="@(args => FrameworkStartDateChanged(configuration.Framework.Code, args))" />
                                </td>
                            }
                            else
                            {
                                <td>@FrameworkStartDateDisplay(configuration.StartDate)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(frameworkMessage))
    {
        <p class="notice @(frameworkSaveSucceeded ? "success" : "error")" role="status">@frameworkMessage</p>
    }
    <p class="caption">The default dates are from the official agreement records. G-Cloud 15 is left blank until a local reporting start date is confirmed.</p>
</section>
}

@if (ActiveSection == CustomerUrnsSection)
{
<section class="panel maintenance-panel">
    <p class="eyebrow">Reference data</p>
    <h2>Customer URN list</h2>
    <p>Refresh from the stable GOV.UK guidance page when you need current customer/URN suggestions during contract registration. Remi resolves the dated ODS file linked there, archives that exact source locally, and records its provenance.</p>
    @if (urnDirectoryStatus is null)
    {
        <p class="muted">No customer URN list has been downloaded yet.</p>
    }
    else
    {
        <dl class="migration-metrics">
            <div><dt>Customer organisations</dt><dd>@urnDirectoryStatus.OrganisationCount.ToString("N0")</dd></div>
            <div><dt>Downloaded</dt><dd>@urnDirectoryStatus.DownloadedAtUtc.LocalDateTime.ToString("dd MMM yyyy HH:mm")</dd></div>
        </dl>
        <p class="caption">Evidence: <a href="/evidence/@urnDirectoryStatus.EvidenceId/download">@urnDirectoryStatus.FileName</a>. The official list is linked from <a href="@urnDirectoryStatus.SourcePageUrl" target="_blank" rel="noreferrer">GOV.UK guidance</a>.</p>
    }
    <div class="action-row">
        <button class="button secondary" disabled="@working" @onclick="RefreshCustomerUrnListAsync">@(urnRefreshing ? "Refreshing…" : "Refresh")</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(urnMessage))
    {
        <p class="notice @(urnRefreshSucceeded ? "success" : "error")" role="status">@urnMessage</p>
    }
</section>
}

@if (ActiveSection == TemplatesSection)
{
    <Templates View="templates" />
}

@if (ActiveSection == AuditSection)
{
    <Templates View="audit" />
}
    </div>
</section>

@code {
    private const string FrameworksSection = "frameworks";
    private const string CustomerUrnsSection = "customer-urns";
    private const string TemplatesSection = "templates";
    private const string AuditSection = "audit";

    [Parameter, SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private CustomerUrnDirectoryStatus? urnDirectoryStatus;
    private IReadOnlyList<FrameworkConfigurationSummary> frameworkConfigurations = [];
    private readonly Dictionary<FrameworkCode, string> frameworkStartDateInputs = [];
    private string? urnMessage;
    private bool working;
    private bool urnRefreshing;
    private bool urnRefreshSucceeded;
    private bool editingFrameworks;
    private bool savingFrameworks;
    private bool frameworkSaveSucceeded;
    private string? frameworkMessage;

    private string ActiveSection => Section switch
    {
        FrameworksSection => FrameworksSection,
        TemplatesSection => TemplatesSection,
        AuditSection => AuditSection,
        _ => CustomerUrnsSection,
    };

    private string SectionLink(string section) => $"/settings?period={Uri.EscapeDataString(ReportingPeriod.SelectedPeriod)}&section={section}";

    private string SectionLinkClass(string section) => ActiveSection == section ? "active" : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var urnDirectoryTask = Workspace.GetCustomerUrnDirectoryStatusAsync();
        var frameworkConfigurationsTask = Workspace.GetFrameworkConfigurationsAsync();
        await Task.WhenAll(urnDirectoryTask, frameworkConfigurationsTask);
        urnDirectoryStatus = await urnDirectoryTask;
        frameworkConfigurations = await frameworkConfigurationsTask;
        ResetFrameworkStartDateInputs();
    }

    private string FrameworkStartDateValue(FrameworkCode framework) =>
        frameworkStartDateInputs.TryGetValue(framework, out var value) ? value : string.Empty;

    private string FrameworkStartDateDisplay(DateOnly? startDate) =>
        startDate?.ToString("d MMM yyyy") ?? "Not set";

    private bool CanSaveFrameworkChanges =>
        !working && frameworkConfigurations.All(configuration =>
            string.IsNullOrWhiteSpace(FrameworkStartDateValue(configuration.Framework.Code))
                ? configuration.StartDate is null
                : DateOnly.TryParseExact(FrameworkStartDateValue(configuration.Framework.Code), "yyyy-MM-dd", out _));

    private void FrameworkStartDateChanged(FrameworkCode framework, ChangeEventArgs args) =>
        frameworkStartDateInputs[framework] = args.Value?.ToString() ?? string.Empty;

    private void BeginFrameworkEdit()
    {
        frameworkMessage = null;
        ResetFrameworkStartDateInputs();
        editingFrameworks = true;
    }

    private void CancelFrameworkEdit()
    {
        frameworkMessage = null;
        ResetFrameworkStartDateInputs();
        editingFrameworks = false;
    }

    private async Task SaveFrameworkChangesAsync()
    {
        if (!CanSaveFrameworkChanges)
        {
            return;
        }

        working = true;
        savingFrameworks = true;
        frameworkMessage = null;
        try
        {
            var changes = frameworkConfigurations
                .Select(configuration => new
                {
                    Configuration = configuration,
                    StartDate = ParsedFrameworkStartDate(configuration.Framework.Code),
                })
                .Where(item => item.StartDate is not null && item.StartDate != item.Configuration.StartDate)
                .ToList();
            foreach (var change in changes)
            {
                var result = await Workspace.UpdateFrameworkStartDateAsync(
                    change.Configuration.Framework.Code,
                    change.StartDate!.Value);
                if (!result.Succeeded)
                {
                    frameworkSaveSucceeded = false;
                    frameworkMessage = result.Message;
                    return;
                }
            }

            frameworkConfigurations = await Workspace.GetFrameworkConfigurationsAsync();
            ResetFrameworkStartDateInputs();
            frameworkSaveSucceeded = true;
            frameworkMessage = changes.Count == 0
                ? "No framework start-date changes were made."
                : $"Saved {changes.Count} framework start-date change(s).";
            editingFrameworks = false;
        }
        catch (Exception exception)
        {
            frameworkSaveSucceeded = false;
            frameworkMessage = $"The framework start date could not be saved: {exception.Message}";
        }
        finally
        {
            savingFrameworks = false;
            working = false;
        }
    }

    private DateOnly? ParsedFrameworkStartDate(FrameworkCode framework) =>
        DateOnly.TryParseExact(FrameworkStartDateValue(framework), "yyyy-MM-dd", out var startDate)
            ? startDate
            : null;

    private void ResetFrameworkStartDateInputs()
    {
        frameworkStartDateInputs.Clear();
        foreach (var configuration in frameworkConfigurations)
        {
            frameworkStartDateInputs[configuration.Framework.Code] = configuration.StartDate?.ToString("yyyy-MM-dd") ?? string.Empty;
        }
    }

    private async Task RefreshCustomerUrnListAsync()
    {
        if (working)
        {
            return;
        }

        working = true;
        urnRefreshing = true;
        urnMessage = null;
        try
        {
            urnDirectoryStatus = await Workspace.RefreshCustomerUrnDirectoryAsync();
            urnRefreshSucceeded = true;
            urnMessage = $"Customer URN list refreshed: {urnDirectoryStatus.OrganisationCount:N0} organisations from {urnDirectoryStatus.FileName}.";
        }
        catch (Exception exception)
        {
            urnRefreshSucceeded = false;
            urnMessage = $"Customer URN refresh stopped: {exception.Message}";
        }
        finally
        {
            urnRefreshing = false;
            working = false;
        }
    }
}
