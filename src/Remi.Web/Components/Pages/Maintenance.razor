@page "/settings"
@using Microsoft.AspNetCore.Components
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod

<PageTitle>Remi · Settings</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Settings</p>
        <h1>Configure Remi.</h1>
        <p class="lede">Manage framework reporting dates, customer reference data and approved workbooks.</p>
    </div>
</section>

<section class="settings-layout">
    <aside class="panel settings-side-menu">
        <p class="eyebrow">Settings menu</p>
        <nav class="settings-side-nav" aria-label="Settings sections">
            <a class="@SectionLinkClass(FrameworksSection)" href="@SectionLink(FrameworksSection)">Frameworks</a>
            <a class="@SectionLinkClass(DigitalMarketplaceSection)" href="@SectionLink(DigitalMarketplaceSection)">Digital Marketplace</a>
            <a class="@SectionLinkClass(CustomerUrnsSection)" href="@SectionLink(CustomerUrnsSection)">Customer URNs</a>
            <a class="@SectionLinkClass(TemplatesSection)" href="@SectionLink(TemplatesSection)">Templates</a>
            <a class="@SectionLinkClass(AuditSection)" href="@SectionLink(AuditSection)">Audit</a>
            <a class="@SectionLinkClass(DataTransferSection)" href="@SectionLink(DataTransferSection)">Import / Export</a>
        </nav>
    </aside>
    <div class="settings-content">
@if (ActiveSection == FrameworksSection)
{
<section class="panel maintenance-panel">
    <p class="eyebrow">Framework catalogue</p>
    <h2>Framework reporting start dates</h2>
    <p>These dates determine when Remi includes each supported framework in its report register and dashboard readiness. The calendar month containing a start date is included.</p>
    @if (frameworkConfigurations.Count == 0)
    {
        <p class="muted">Loading framework settings…</p>
    }
    else
    {
        <div class="action-row">
            @if (editingFrameworks)
            {
                <button class="button primary" disabled="@(!CanSaveFrameworkChanges)" @onclick="SaveFrameworkChangesAsync">@(savingFrameworks ? "Saving…" : "Save")</button>
                <button class="button secondary" disabled="@working" @onclick="CancelFrameworkEdit">Cancel</button>
            }
            else
            {
                <button class="button secondary" disabled="@working" @onclick="BeginFrameworkEdit">Edit</button>
            }
        </div>
        <div class="table-wrap maintenance-table">
            <table>
                <thead><tr><th>Framework</th><th>Agreement</th><th>Reporting start date</th></tr></thead>
                <tbody>
                    @foreach (var configuration in frameworkConfigurations)
                    {
                        <tr>
                            <td><strong>@configuration.Framework.DisplayName</strong><span class="cell-secondary">@configuration.Framework.ReportingAuthority</span></td>
                            <td>@configuration.Framework.AgreementNumber</td>
                            @if (editingFrameworks)
                            {
                                var fieldId = $"framework-start-{configuration.Framework.Code}";
                                <td>
                                    <label class="visually-hidden" for="@fieldId">@configuration.Framework.DisplayName reporting start date</label>
                                    <input id="@fieldId" type="date" value="@FrameworkStartDateValue(configuration.Framework.Code)" @onchange="@(args => FrameworkStartDateChanged(configuration.Framework.Code, args))" />
                                </td>
                            }
                            else
                            {
                                <td>@FrameworkStartDateDisplay(configuration.StartDate)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(frameworkMessage))
    {
        <p class="notice @(frameworkSaveSucceeded ? "success" : "error")" role="status">@frameworkMessage</p>
    }
    <p class="caption">The default dates are from the official agreement records. G-Cloud 15 is left blank until a local reporting start date is confirmed.</p>
</section>
}

@if (ActiveSection == CustomerUrnsSection)
{
<section class="panel maintenance-panel">
    <p class="eyebrow">Reference data</p>
    <h2>Customer URN list</h2>
    <p>Refresh from the stable GOV.UK guidance page when you need current customer/URN suggestions during contract registration. Remi resolves the dated ODS file linked there, archives that exact source locally, and records its provenance.</p>
    @if (urnDirectoryStatus is null)
    {
        <p class="muted">No customer URN list has been downloaded yet.</p>
    }
    else
    {
        <dl class="migration-metrics">
            <div><dt>Customer organisations</dt><dd>@urnDirectoryStatus.OrganisationCount.ToString("N0")</dd></div>
            <div><dt>Downloaded</dt><dd>@urnDirectoryStatus.DownloadedAtUtc.LocalDateTime.ToString("dd MMM yyyy HH:mm")</dd></div>
        </dl>
        <p class="caption">Evidence: <a href="/evidence/@urnDirectoryStatus.EvidenceId/download">@urnDirectoryStatus.FileName</a>. The official list is linked from <a href="@urnDirectoryStatus.SourcePageUrl" target="_blank" rel="noreferrer">GOV.UK guidance</a>.</p>
    }
    <div class="action-row">
        <button class="button secondary" disabled="@working" @onclick="RefreshCustomerUrnListAsync">@(urnRefreshing ? "Refreshing…" : "Refresh")</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(urnMessage))
    {
        <p class="notice @(urnRefreshSucceeded ? "success" : "error")" role="status">@urnMessage</p>
    }
</section>
}

@if (ActiveSection == DigitalMarketplaceSection)
{
<section class="panel maintenance-panel">
    <p class="eyebrow">Reference data</p>
    <h2>G-Cloud 14 Digital Marketplace services</h2>
    <p>These StatMap Ltd products are suggested when entering a Digital Marketplace Service ID for a contract. You can maintain the list when the supplier catalogue changes; choosing a suggestion is optional.</p>
    <div class="action-row">
        @if (editingDigitalMarketplaceServices)
        {
            <button class="button primary" disabled="@(!CanSaveDigitalMarketplaceServices)" @onclick="SaveDigitalMarketplaceServicesAsync">@(savingDigitalMarketplaceServices ? "Saving…" : "Save")</button>
            <button class="button secondary" disabled="@working" @onclick="CancelDigitalMarketplaceServiceEdit">Cancel</button>
        }
        else
        {
            <button class="button secondary" disabled="@working" @onclick="BeginDigitalMarketplaceServiceEdit">Edit</button>
        }
    </div>
    <div class="table-wrap maintenance-table">
        <table>
            <thead><tr><th>Product</th><th>Digital Marketplace Service ID</th>@if (editingDigitalMarketplaceServices) { <th><span class="visually-hidden">Actions</span></th> }</tr></thead>
            <tbody>
                @foreach (var service in digitalMarketplaceServices)
                {
                    <tr>
                        @if (editingDigitalMarketplaceServices)
                        {
                            <td><input aria-label="Product name" @bind="service.Name" /></td>
                            <td><input aria-label="Digital Marketplace Service ID" @bind="service.ServiceId" /></td>
                            <td><button class="button secondary" type="button" @onclick="@(() => RemoveDigitalMarketplaceService(service))">Remove</button></td>
                        }
                        else
                        {
                            <td><strong>@service.Name</strong></td>
                            <td>@service.ServiceId</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (editingDigitalMarketplaceServices)
    {
        <div class="action-row"><button class="button secondary" type="button" @onclick="AddDigitalMarketplaceService">Add service</button></div>
    }
    @if (!string.IsNullOrWhiteSpace(digitalMarketplaceMessage))
    {
        <p class="notice @(digitalMarketplaceSaveSucceeded ? "success" : "error")" role="status">@digitalMarketplaceMessage</p>
    }
    <p class="caption">Seeded from the <a href="https://www.applytosupply.digitalmarketplace.service.gov.uk/g-cloud/search?q=StatMap&amp;lot=cloud-software" target="_blank" rel="noreferrer">UK Government Digital Marketplace</a> G-Cloud 14 StatMap search (verified 6 August 2026).</p>
</section>
}

@if (ActiveSection == TemplatesSection)
{
    <Templates View="templates" />
}

@if (ActiveSection == AuditSection)
{
    <Templates View="audit" />
}

@if (ActiveSection == DataTransferSection)
{
<section class="panel maintenance-panel data-transfer-panel">
    <p class="eyebrow">Data transfer</p>
    <h2>Export complete Remi data</h2>
    <p>Download a portable Remi data-transfer ZIP to move this instance to another computer. It includes the register, all retained evidence, approved templates, reference data and other persistent Remi data.</p>
    <div class="action-row">
        <a class="button primary" href="/data-transfer/export">Export Remi data</a>
    </div>
    <p class="caption">Keep the ZIP secure. It can contain customer, contract, invoice and evidence information. Runtime logs are not included.</p>
</section>

<section class="panel maintenance-panel data-transfer-panel data-transfer-panel--danger">
    <p class="eyebrow">Destructive action</p>
    <h2>Import and replace this Remi datastore</h2>
    <p><strong>Warning:</strong> importing permanently replaces every item currently stored by this Remi instance with the contents of the selected ZIP. This includes the register, evidence, templates and locally stored reference data. It cannot be undone.</p>
    <p>Export this computer's current data first if there is any chance you will need to recover it. Only import ZIPs exported by Remi.</p>
    <form class="data-transfer-import" method="post" action="/data-transfer/import" enctype="multipart/form-data">
        <AntiforgeryToken />
        <label for="data-transfer-package">Remi data-transfer ZIP
            <input id="data-transfer-package" name="package" type="file" accept=".zip,application/zip" required />
        </label>
        <label class="review-confirmation destructive-confirmation">
            <input name="confirmDestructiveImport" type="checkbox" required />
            <span>I understand that the current Remi datastore on this computer will be permanently destroyed and replaced.</span>
        </label>
        <label class="review-confirmation destructive-confirmation">
            <input name="confirmTransferPackage" type="checkbox" required />
            <span>I have exported a backup of the current data and have checked that this is the correct Remi transfer package.</span>
        </label>
        <label for="data-transfer-replacement-phrase">To make the replacement, type <strong>REPLACE</strong>
            <input id="data-transfer-replacement-phrase" name="replacementPhrase" type="text" autocomplete="off" spellcheck="false" pattern="REPLACE" required />
        </label>
        <div class="action-row">
            <button class="button danger" type="submit">Import and replace all data</button>
        </div>
    </form>
    @if (ImportCompleted)
    {
        <p class="notice success" role="status">The Remi datastore was imported and replaced successfully. Refresh the page if you have an earlier Remi screen open.</p>
    }
</section>
}
    </div>
</section>

@code {
    private const string FrameworksSection = "frameworks";
    private const string DigitalMarketplaceSection = "digital-marketplace";
    private const string CustomerUrnsSection = "customer-urns";
    private const string TemplatesSection = "templates";
    private const string AuditSection = "audit";
    private const string DataTransferSection = "data-transfer";

    [Parameter, SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "import")]
    public string? Import { get; set; }

    private CustomerUrnDirectoryStatus? urnDirectoryStatus;
    private IReadOnlyList<FrameworkConfigurationSummary> frameworkConfigurations = [];
    private List<EditableDigitalMarketplaceService> digitalMarketplaceServices = [];
    private readonly Dictionary<FrameworkCode, string> frameworkStartDateInputs = [];
    private string? urnMessage;
    private bool working;
    private bool urnRefreshing;
    private bool urnRefreshSucceeded;
    private bool editingFrameworks;
    private bool savingFrameworks;
    private bool frameworkSaveSucceeded;
    private string? frameworkMessage;
    private bool editingDigitalMarketplaceServices;
    private bool savingDigitalMarketplaceServices;
    private bool digitalMarketplaceSaveSucceeded;
    private string? digitalMarketplaceMessage;

    private string ActiveSection => Section switch
    {
        FrameworksSection => FrameworksSection,
        DigitalMarketplaceSection => DigitalMarketplaceSection,
        TemplatesSection => TemplatesSection,
        AuditSection => AuditSection,
        DataTransferSection => DataTransferSection,
        _ => CustomerUrnsSection,
    };

    private bool ImportCompleted => string.Equals(Import, "complete", StringComparison.Ordinal);

    private string SectionLink(string section) => $"/settings?period={Uri.EscapeDataString(ReportingPeriod.SelectedPeriod)}&section={section}";

    private string SectionLinkClass(string section) => ActiveSection == section ? "active" : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var urnDirectoryTask = Workspace.GetCustomerUrnDirectoryStatusAsync();
        var frameworkConfigurationsTask = Workspace.GetFrameworkConfigurationsAsync();
        var digitalMarketplaceServicesTask = Workspace.GetDigitalMarketplaceServicesAsync();
        await Task.WhenAll(urnDirectoryTask, frameworkConfigurationsTask, digitalMarketplaceServicesTask);
        urnDirectoryStatus = await urnDirectoryTask;
        frameworkConfigurations = await frameworkConfigurationsTask;
        digitalMarketplaceServices = (await digitalMarketplaceServicesTask).Select(service => new EditableDigitalMarketplaceService(service)).ToList();
        ResetFrameworkStartDateInputs();
    }

    private string FrameworkStartDateValue(FrameworkCode framework) =>
        frameworkStartDateInputs.TryGetValue(framework, out var value) ? value : string.Empty;

    private string FrameworkStartDateDisplay(DateOnly? startDate) =>
        startDate?.ToString("d MMM yyyy") ?? "Not set";

    private bool CanSaveFrameworkChanges =>
        !working && frameworkConfigurations.All(configuration =>
            string.IsNullOrWhiteSpace(FrameworkStartDateValue(configuration.Framework.Code))
                ? configuration.StartDate is null
                : DateOnly.TryParseExact(FrameworkStartDateValue(configuration.Framework.Code), "yyyy-MM-dd", out _));

    private void FrameworkStartDateChanged(FrameworkCode framework, ChangeEventArgs args) =>
        frameworkStartDateInputs[framework] = args.Value?.ToString() ?? string.Empty;

    private void BeginFrameworkEdit()
    {
        frameworkMessage = null;
        ResetFrameworkStartDateInputs();
        editingFrameworks = true;
    }

    private void CancelFrameworkEdit()
    {
        frameworkMessage = null;
        ResetFrameworkStartDateInputs();
        editingFrameworks = false;
    }

    private async Task SaveFrameworkChangesAsync()
    {
        if (!CanSaveFrameworkChanges)
        {
            return;
        }

        working = true;
        savingFrameworks = true;
        frameworkMessage = null;
        try
        {
            var changes = frameworkConfigurations
                .Select(configuration => new
                {
                    Configuration = configuration,
                    StartDate = ParsedFrameworkStartDate(configuration.Framework.Code),
                })
                .Where(item => item.StartDate is not null && item.StartDate != item.Configuration.StartDate)
                .ToList();
            foreach (var change in changes)
            {
                var result = await Workspace.UpdateFrameworkStartDateAsync(
                    change.Configuration.Framework.Code,
                    change.StartDate!.Value);
                if (!result.Succeeded)
                {
                    frameworkSaveSucceeded = false;
                    frameworkMessage = result.Message;
                    return;
                }
            }

            frameworkConfigurations = await Workspace.GetFrameworkConfigurationsAsync();
            ResetFrameworkStartDateInputs();
            frameworkSaveSucceeded = true;
            frameworkMessage = changes.Count == 0
                ? "No framework start-date changes were made."
                : $"Saved {changes.Count} framework start-date change(s).";
            editingFrameworks = false;
        }
        catch (Exception exception)
        {
            frameworkSaveSucceeded = false;
            frameworkMessage = $"The framework start date could not be saved: {exception.Message}";
        }
        finally
        {
            savingFrameworks = false;
            working = false;
        }
    }

    private DateOnly? ParsedFrameworkStartDate(FrameworkCode framework) =>
        DateOnly.TryParseExact(FrameworkStartDateValue(framework), "yyyy-MM-dd", out var startDate)
            ? startDate
            : null;

    private void ResetFrameworkStartDateInputs()
    {
        frameworkStartDateInputs.Clear();
        foreach (var configuration in frameworkConfigurations)
        {
            frameworkStartDateInputs[configuration.Framework.Code] = configuration.StartDate?.ToString("yyyy-MM-dd") ?? string.Empty;
        }
    }

    private bool CanSaveDigitalMarketplaceServices =>
        !working && digitalMarketplaceServices.All(service =>
            !string.IsNullOrWhiteSpace(service.Name) && !string.IsNullOrWhiteSpace(service.ServiceId));

    private void BeginDigitalMarketplaceServiceEdit()
    {
        digitalMarketplaceMessage = null;
        editingDigitalMarketplaceServices = true;
    }

    private async Task CancelDigitalMarketplaceServiceEdit()
    {
        digitalMarketplaceMessage = null;
        editingDigitalMarketplaceServices = false;
        await ReloadDigitalMarketplaceServicesAsync();
    }

    private void AddDigitalMarketplaceService() => digitalMarketplaceServices.Add(new EditableDigitalMarketplaceService());

    private void RemoveDigitalMarketplaceService(EditableDigitalMarketplaceService service) => digitalMarketplaceServices.Remove(service);

    private async Task SaveDigitalMarketplaceServicesAsync()
    {
        if (!CanSaveDigitalMarketplaceServices)
        {
            return;
        }

        working = true;
        savingDigitalMarketplaceServices = true;
        digitalMarketplaceMessage = null;
        try
        {
            var result = await Workspace.UpdateDigitalMarketplaceServicesAsync(
                digitalMarketplaceServices.Select(service => new DigitalMarketplaceService(service.ServiceId, service.Name)));
            digitalMarketplaceSaveSucceeded = result.Succeeded;
            digitalMarketplaceMessage = result.Message;
            if (result.Succeeded)
            {
                digitalMarketplaceServices = result.Services.Select(service => new EditableDigitalMarketplaceService(service)).ToList();
                editingDigitalMarketplaceServices = false;
            }
        }
        catch (Exception exception)
        {
            digitalMarketplaceSaveSucceeded = false;
            digitalMarketplaceMessage = $"The Digital Marketplace services could not be saved: {exception.Message}";
        }
        finally
        {
            savingDigitalMarketplaceServices = false;
            working = false;
        }
    }

    private async Task ReloadDigitalMarketplaceServicesAsync() =>
        digitalMarketplaceServices = (await Workspace.GetDigitalMarketplaceServicesAsync())
            .Select(service => new EditableDigitalMarketplaceService(service))
            .ToList();

    private sealed class EditableDigitalMarketplaceService
    {
        public EditableDigitalMarketplaceService() { }
        public EditableDigitalMarketplaceService(DigitalMarketplaceService service) => (ServiceId, Name) = (service.ServiceId, service.Name);
        public string ServiceId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    private async Task RefreshCustomerUrnListAsync()
    {
        if (working)
        {
            return;
        }

        working = true;
        urnRefreshing = true;
        urnMessage = null;
        try
        {
            urnDirectoryStatus = await Workspace.RefreshCustomerUrnDirectoryAsync();
            urnRefreshSucceeded = true;
            urnMessage = $"Customer URN list refreshed: {urnDirectoryStatus.OrganisationCount:N0} organisations from {urnDirectoryStatus.FileName}.";
        }
        catch (Exception exception)
        {
            urnRefreshSucceeded = false;
            urnMessage = $"Customer URN refresh stopped: {exception.Message}";
        }
        finally
        {
            urnRefreshing = false;
            working = false;
        }
    }
}
