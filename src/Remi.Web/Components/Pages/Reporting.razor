@page "/reports"
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@implements IDisposable

<PageTitle>Remi · Reports</PageTitle>

<header class="dashboard-header">
    <div>
        <h1>Review every reporting cycle in one place.</h1>
        <p class="lede">Browse returns by reporting month or framework, then open a specific cycle to review its data, generate the approved workbook and record the outcome.</p>
    </div>
</header>

<section class="panel return-register-panel">
    <div class="panel-heading return-register-heading">
        <div>
            <h2>Browse reports</h2>
        </div>
    </div>
    <div class="return-register-controls">
        <div class="return-register-views" role="tablist" aria-label="Reports view">
            <button class="button secondary @(registerView == "month" ? "active" : null)" role="tab" aria-selected="@(registerView == "month" ? "true" : "false")" @onclick="@(() => registerView = "month")">By reporting month</button>
            <button class="button secondary @(registerView == "framework" ? "active" : null)" role="tab" aria-selected="@(registerView == "framework" ? "true" : "false")" @onclick="@(() => registerView = "framework")">By framework</button>
        </div>
        @if (registerView == "month")
        {
            <label class="return-register-filter">Reporting month
                <select @bind="registerMonth">
                    @foreach (var month in returnRegister?.ReportingMonths ?? [])
                    {
                        <option value="@month">@month</option>
                    }
                </select>
            </label>
        }
        else
        {
            <label class="return-register-filter">Framework
                <select @bind="registerFramework">
                    @foreach (var definition in RegisterFrameworks)
                    {
                        <option value="@definition.Code">@definition.DisplayName (@definition.AgreementNumber)</option>
                    }
                </select>
            </label>
        }
    </div>
    @if (returnRegister is null)
    {
        <p class="muted">Loading the return register…</p>
    }
    else
    {
        <div class="table-wrap return-register-table">
            <table>
                <thead>
                    <tr>
                        @if (registerView == "month") { <th aria-sort="@SortAria("framework")"><button class="table-sort" @onclick="@(() => SortRegisterBy("framework"))">Framework <span aria-hidden="true">@SortIndicator("framework")</span></button></th> } else { <th aria-sort="@SortAria("reportingMonth")"><button class="table-sort" @onclick="@(() => SortRegisterBy("reportingMonth"))">Reporting month <span aria-hidden="true">@SortIndicator("reportingMonth")</span></button></th> }
                        <th aria-sort="@SortAria("status")"><button class="table-sort" @onclick="@(() => SortRegisterBy("status"))">Status <span aria-hidden="true">@SortIndicator("status")</span></button></th>
                        <th aria-sort="@SortAria("activity")"><button class="table-sort" @onclick="@(() => SortRegisterBy("activity"))">Activity <span aria-hidden="true">@SortIndicator("activity")</span></button></th>
                        <th aria-sort="@SortAria("readiness")"><button class="table-sort" @onclick="@(() => SortRegisterBy("readiness"))">Readiness <span aria-hidden="true">@SortIndicator("readiness")</span></button></th>
                        <th aria-sort="@SortAria("submission")"><button class="table-sort" @onclick="@(() => SortRegisterBy("submission"))">Submission <span aria-hidden="true">@SortIndicator("submission")</span></button></th>
                        <th class="table-action-cell"><span class="visually-hidden">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in VisibleReturnEntries)
                    {
                        <tr>
                            @if (registerView == "month")
                            {
                                <td><strong>@item.Framework.DisplayName</strong><span class="cell-secondary">@item.Framework.AgreementNumber</span></td>
                            }
                            else
                            {
                                <td><strong>@item.ReportingMonth</strong></td>
                            }
                            <td><span class="@ReturnStatusClass(item.ReturnStatus)">@ReturnStatusLabel(item.ReturnStatus)</span></td>
                            <td>@item.ContractCount contract(s) · @item.InvoiceCount invoice(s)</td>
                            <td>@RegisterReadiness(item)</td>
                            <td>@SubmissionLabel(item)</td>
                            <td class="table-action-cell"><button class="remi-action remi-action--table" @onclick="@(() => ManageReturnAsync(item))">Open <span aria-hidden="true">→</span></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (showReturnEditor)
{
<section class="selected-return-heading">
    <div>
        <p class="eyebrow">Selected return</p>
        <h2>@Frameworks.Get(framework).DisplayName · @reportingMonth</h2>
        <p class="muted">Review the registered data, generate the approved workbook and record the outcome for this reporting cycle.</p>
    </div>
    <button class="remi-action remi-action--compact" @onclick="CloseReturnEditor">Close</button>
</section>

@if (SelectedReturn is not null)
{
<section class="gca-return-summary" aria-labelledby="gca-return-summary-heading">
    <p class="eyebrow">GCA submission summary</p>
    <h3 id="gca-return-summary-heading">@SelectedReturn.Framework.AgreementNumber @SelectedReturn.Framework.DisplayName for @DisplayReportingMonth(SelectedReturn.ReportingMonth)</h3>
    <table>
        <thead>
            <tr><th>Submitted</th><th>Rows</th><th>Total</th></tr>
        </thead>
        <tbody>
            <tr><th scope="row">Invoices</th><td>@SelectedReturn.InvoiceCount</td><td>@Currency(SelectedReturn.InvoiceTotalExVat)</td></tr>
            <tr><th scope="row">Contracts</th><td>@SelectedReturn.ContractCount</td><td>@Currency(SelectedReturn.ContractTotalExVat)</td></tr>
            <tr><th scope="row">Others</th><td>0</td><td></td></tr>
        </tbody>
    </table>
</section>
}

<section class="panel return-outcome-panel">
    <p class="eyebrow">Prepare and record</p>
    <h2>@Frameworks.Get(framework).DisplayName · @reportingMonth</h2>
    <p class="caption">Generate the reporting workbook from the registered contracts and invoices using the active approved template, then upload it to the GCA portal.</p>
    <p class="muted">Current status: <strong>@CurrentStatus</strong></p>
    <div class="return-readiness">
        <strong>Readiness</strong>
        <span>@ReadinessMessage</span>
    </div>
    <label>
        Portal submission reference <span class="optional">(optional)</span>
        <input @bind="submissionReference" @bind:event="oninput" placeholder="e.g. portal confirmation or ticket ID" />
    </label>
    <div class="action-row">
        <button class="remi-action remi-action--primary" disabled="@(!CanGenerateReturn || working)" @onclick="GenerateReturnAsync">Generate</button>
        <button class="remi-action remi-action--primary" disabled="@(!CanMarkSubmitted || working)" @onclick="MarkSubmittedAsync">Submit</button>
        <button class="remi-action remi-action--section" disabled="@(!CanMarkNilReturn || working)" @onclick="MarkNilReturnAsync">Record</button>
    </div>
    <label class="correction-reason">
        Correction reason <span class="optional">(required to request review)</span>
        <input @bind="correctionReason" @bind:event="oninput" placeholder="What needs to be corrected and why?" />
    </label>
    <div class="action-row">
        <button class="remi-action remi-action--section" disabled="@(!CanRequestCorrection || working)" @onclick="RequestCorrectionAsync">Request</button>
        <a class="remi-action remi-action--section" href="@($"/settings?period={reportingMonth}&section=templates")">Prepare <span aria-hidden="true">→</span></a>
    </div>
        @if (actionResult is not null)
        {
            <p class="notice @(actionResult.Succeeded ? "success" : "error")" role="status">@actionResult.Message</p>
            @if (actionResult.Findings.Count != 0)
            {
                <ul class="findings inline-findings">
                    @foreach (var finding in actionResult.Findings)
                    {
                        <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li>
                    }
                </ul>
            }
        }
</section>

<section class="panel evidence-panel">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">Evidence archive</p>
            <h2>Files retained for this return</h2>
        </div>
        <span class="muted">@evidence.Count file(s) retained</span>
    </div>
    @if (evidence.Count == 0)
    {
        <div class="empty-state compact">
            <p>No files are archived for the selected framework and month yet.</p>
        </div>
    }
    else
    {
        <div class="evidence-list">
            @foreach (var item in evidence)
            {
                <a class="evidence-item" href="@($"/evidence/{item.Id}")" target="_blank">
                    <span>
                        <strong>@item.FileName</strong>
                        <span class="cell-secondary">@item.OriginalRelativePath</span>
                    </span>
                    <span class="muted">@item.FileSizeBytes.ToString("N0") bytes</span>
                </a>
            }
        </div>
    }
</section>

<section class="panel reporting-card-panel">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">Reviewable reporting card</p>
            <h2>Month-end MI staging</h2>
        </div>
        <a class="remi-action remi-action--section" href="@($"/reports/card/{(int)framework}/{reportingMonth}")" target="_blank">Download</a>
    </div>
    @if (reportingCard is null || (reportingCard.Contracts.Count == 0 && reportingCard.Invoices.Count == 0))
    {
        <div class="empty-state compact"><p>No reportable activity has been recorded for this framework and month.</p></div>
    }
    else
    {
        <p class="caption">Review these fields against the contract and accounting invoice before generating the framework workbook.</p>
        @if (reportingCard.Contracts.Count != 0)
        {
            <div class="reporting-card-section">
                <h3>Contracts</h3>
                @foreach (var item in reportingCard.Contracts)
                {
                    <article class="reporting-card-item">
                        <h4>@item.Title</h4>
                        <dl>
                            @foreach (var field in item.Fields)
                            {
                                <div><dt>@field.Label</dt><dd>@field.Value</dd></div>
                            }
                        </dl>
                    </article>
                }
            </div>
        }
        @if (reportingCard.Invoices.Count != 0)
        {
            <div class="reporting-card-section">
                <h3>Invoices</h3>
                @foreach (var item in reportingCard.Invoices)
                {
                    <article class="reporting-card-item">
                        <h4>@item.Title</h4>
                        <dl>
                            @foreach (var field in item.Fields)
                            {
                                <div><dt>@field.Label</dt><dd>@field.Value</dd></div>
                            }
                        </dl>
                    </article>
                }
            </div>
        }
    }
</section>

<section class="panel guidance-panel">
    <p class="eyebrow">What Remi checks today</p>
    <ul class="checklist">
        <li>Every contract has a supplier reference, customer, valid dates and a positive total value.</li>
        <li>Every invoice is linked to a registered contract in the same framework.</li>
        <li>Duplicate contract and invoice records are held back instead of creating a second reportable entry.</li>
        <li>A nil return cannot be recorded for a month that contains imported activity.</li>
    </ul>
    <p class="caption">Remi retains both the approved workbook and every generated return.</p>
</section>
}

@code {
    private DashboardModel? model;
    private MonthlyReturnRegisterModel? returnRegister;
    private FrameworkCode framework = FrameworkCode.GCloud14;
    private FrameworkCode registerFramework = FrameworkCode.GCloud14;
    private string reportingMonth = string.Empty;
    private string registerMonth = string.Empty;
    private string registerView = "month";
    private string? submissionReference;
    private string? correctionReason;
    private ReturnActionResult? actionResult;
    private IReadOnlyList<ReportingEvidence> evidence = [];
    private ReportingCardModel? reportingCard;
    private bool working;
    private bool showReturnEditor;
    private string registerSortColumn = "reportingMonth";
    private bool registerSortDescending = true;

    protected override async Task OnInitializedAsync()
    {
        ReportingPeriod.Changed += ReportingPeriodChanged;
        reportingMonth = ReportingPeriod.SelectedPeriod;
        registerMonth = reportingMonth;
        model = await Workspace.GetDashboardAsync(reportingMonth);
        returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
        EnsureRegisterFrameworkSelection();
    }

    public void Dispose() => ReportingPeriod.Changed -= ReportingPeriodChanged;

    private async void ReportingPeriodChanged()
    {
        await InvokeAsync(async () =>
        {
            reportingMonth = ReportingPeriod.SelectedPeriod;
            registerMonth = reportingMonth;
            model = await Workspace.GetDashboardAsync(reportingMonth);
            returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
            EnsureRegisterFrameworkSelection();
            if (showReturnEditor)
            {
                await LoadReportingPeriodAsync();
            }
            StateHasChanged();
        });
    }

    private string CurrentStatus =>
        model?.Frameworks.Single(summary => summary.Framework.Code == framework).CurrentReturnStatus switch
        {
            ReturnStatus.Draft => "Draft",
            ReturnStatus.Submitted => "Submitted",
            ReturnStatus.NilReturn => "Nil return recorded",
            ReturnStatus.CorrectionRequired => "Correction required",
            _ => "Not started",
        };

    private bool HasActivity => reportingCard is not null
        && (reportingCard.Contracts.Count != 0 || reportingCard.Invoices.Count != 0);

    private bool HasEvidence => evidence.Count != 0;

    private bool CanMarkSubmitted => HasActivity && HasEvidence && CurrentStatus is "Draft" or "Correction required";

    private bool CanGenerateReturn => HasActivity && CurrentStatus is "Draft" or "Correction required";

    private bool CanMarkNilReturn => !HasActivity && CurrentStatus is not "Submitted";

    private bool CanRequestCorrection => CurrentStatus == "Submitted" && !string.IsNullOrWhiteSpace(correctionReason);

    private string ReadinessMessage => CanMarkSubmitted
        ? "The generated workbook evidence and reportable activity are ready for submission."
        : HasActivity && !HasEvidence
            ? "Generate and archive the reporting workbook before recording submission."
            : !HasActivity
                ? "No reportable activity is present. You can record a nil return if this is correct."
                : "Resolve the current return status before recording a new outcome.";

    private async Task MarkSubmittedAsync()
    {
        working = true;
        actionResult = await Workspace.MarkSubmittedAsync(framework, reportingMonth, submissionReference);
        model = await Workspace.GetDashboardAsync(reportingMonth);
        returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
        working = false;
    }

    private async Task GenerateReturnAsync()
    {
        working = true;
        try
        {
            var exported = await Workspace.ExportReturnAsync(framework, reportingMonth);
            actionResult = exported is null
                ? new ReturnActionResult(false, "Register an active approved template for this framework before generating a return.", [])
                : new ReturnActionResult(true, $"Generated {exported.FileName}. It is now retained in the evidence archive.", exported.Findings);
            model = await Workspace.GetDashboardAsync(reportingMonth);
            returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
            await LoadReportingPeriodAsync();
        }
        catch (Exception exception)
        {
            actionResult = new ReturnActionResult(false, $"The MI workbook could not be generated: {exception.Message}", []);
        }
        finally
        {
            working = false;
        }
    }

    private async Task MarkNilReturnAsync()
    {
        working = true;
        actionResult = await Workspace.MarkNilReturnAsync(framework, reportingMonth);
        model = await Workspace.GetDashboardAsync(reportingMonth);
        returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
        working = false;
    }

    private async Task RequestCorrectionAsync()
    {
        working = true;
        actionResult = await Workspace.RequestCorrectionAsync(framework, reportingMonth, correctionReason ?? string.Empty);
        model = await Workspace.GetDashboardAsync(reportingMonth);
        returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
        working = false;
    }

    private async Task LoadReportingPeriodAsync()
    {
        if (!DateOnly.TryParseExact($"{reportingMonth}-01", "yyyy-MM-dd", out _))
        {
            evidence = [];
            reportingCard = null;
            return;
        }

        var evidenceTask = Workspace.GetReportingEvidenceAsync(framework, reportingMonth);
        var cardTask = Workspace.GetReportingCardAsync(framework, reportingMonth);
        await Task.WhenAll(evidenceTask, cardTask);
        evidence = await evidenceTask;
        reportingCard = await cardTask;
    }

    private IEnumerable<MonthlyReturnRegisterEntry> VisibleReturnEntries => SortReturnEntries((returnRegister?.Entries ?? [])
        .Where(item => registerView == "month"
            ? item.ReportingMonth == registerMonth
            : item.Framework.Code == registerFramework));

    private void SortRegisterBy(string column)
    {
        if (registerSortColumn == column) registerSortDescending = !registerSortDescending;
        else { registerSortColumn = column; registerSortDescending = false; }
    }
    private string SortIndicator(string column) => registerSortColumn == column ? registerSortDescending ? "↓" : "↑" : "↕";
    private string SortAria(string column) => registerSortColumn == column ? registerSortDescending ? "descending" : "ascending" : "none";
    private IOrderedEnumerable<MonthlyReturnRegisterEntry> SortReturnEntries(IEnumerable<MonthlyReturnRegisterEntry> entries) => (registerSortColumn, registerSortDescending) switch
    {
        ("framework", false) => entries.OrderBy(item => item.Framework.DisplayName, StringComparer.OrdinalIgnoreCase),
        ("framework", true) => entries.OrderByDescending(item => item.Framework.DisplayName, StringComparer.OrdinalIgnoreCase),
        ("reportingMonth", false) => entries.OrderBy(item => item.ReportingMonth, StringComparer.Ordinal),
        ("reportingMonth", true) => entries.OrderByDescending(item => item.ReportingMonth, StringComparer.Ordinal),
        ("status", false) => entries.OrderBy(item => ReturnStatusLabel(item.ReturnStatus), StringComparer.OrdinalIgnoreCase),
        ("status", true) => entries.OrderByDescending(item => ReturnStatusLabel(item.ReturnStatus), StringComparer.OrdinalIgnoreCase),
        ("activity", false) => entries.OrderBy(item => item.ContractCount + item.InvoiceCount),
        ("activity", true) => entries.OrderByDescending(item => item.ContractCount + item.InvoiceCount),
        ("readiness", false) => entries.OrderBy(item => item.BlockingFindingCount).ThenBy(item => item.ReviewFindingCount),
        ("readiness", true) => entries.OrderByDescending(item => item.BlockingFindingCount).ThenByDescending(item => item.ReviewFindingCount),
        ("submission", false) => entries.OrderBy(item => item.SubmittedAtUtc is null).ThenBy(item => item.SubmittedAtUtc),
        ("submission", true) => entries.OrderBy(item => item.SubmittedAtUtc is null).ThenByDescending(item => item.SubmittedAtUtc),
        _ => entries.OrderByDescending(item => item.ReportingMonth, StringComparer.Ordinal).ThenBy(item => item.Framework.DisplayName, StringComparer.Ordinal),
    };

    private IReadOnlyList<FrameworkDefinition> RegisterFrameworks => (returnRegister?.Entries ?? [])
        .Select(item => item.Framework)
        .DistinctBy(item => item.Code)
        .OrderBy(item => item.DisplayName, StringComparer.Ordinal)
        .ToList();

    private void EnsureRegisterFrameworkSelection()
    {
        if (RegisterFrameworks.All(item => item.Code != registerFramework))
        {
            registerFramework = RegisterFrameworks.FirstOrDefault()?.Code ?? registerFramework;
        }
    }

    private async Task ManageReturnAsync(MonthlyReturnRegisterEntry item)
    {
        framework = item.Framework.Code;
        reportingMonth = item.ReportingMonth;
        registerFramework = framework;
        registerMonth = reportingMonth;
        actionResult = null;
        correctionReason = null;
        submissionReference = item.SubmissionReference;
        model = await Workspace.GetDashboardAsync(reportingMonth);
        await LoadReportingPeriodAsync();
        showReturnEditor = true;
    }

    private void CloseReturnEditor() => showReturnEditor = false;

    private static string ReturnStatusLabel(ReturnStatus? status) => status switch
    {
        ReturnStatus.Draft => "Draft",
        ReturnStatus.Submitted => "Submitted",
        ReturnStatus.NilReturn => "Nil return",
        ReturnStatus.CorrectionRequired => "Correction required",
        _ => "Not started",
    };

    private static string ReturnStatusClass(ReturnStatus? status) => status switch
    {
        ReturnStatus.Submitted or ReturnStatus.NilReturn => "readiness-status complete",
        ReturnStatus.CorrectionRequired => "readiness-status warning",
        ReturnStatus.Draft => "readiness-status neutral",
        _ => "readiness-status neutral",
    };

    private static string RegisterReadiness(MonthlyReturnRegisterEntry item) => item.BlockingFindingCount > 0
        ? $"{item.BlockingFindingCount} blocking issue(s)"
        : item.ReviewFindingCount > 0
            ? $"{item.ReviewFindingCount} review item(s)"
            : item.ContractCount == 0 && item.InvoiceCount == 0
                ? "No activity"
                : "Ready for review";

    private static string SubmissionLabel(MonthlyReturnRegisterEntry item) => item.SubmittedAtUtc is not null
        ? item.SubmittedAtUtc.Value.ToLocalTime().ToString("d MMM yyyy")
        : string.IsNullOrWhiteSpace(item.SubmissionReference)
            ? "—"
            : item.SubmissionReference;

    private MonthlyReturnRegisterEntry? SelectedReturn => returnRegister?.Entries.SingleOrDefault(item =>
        item.Framework.Code == framework && item.ReportingMonth == reportingMonth);

    private static string DisplayReportingMonth(string month) =>
        DateOnly.ParseExact($"{month}-01", "yyyy-MM-dd").ToString("MMMM yyyy");

    private static string Currency(decimal value) =>
        value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));

}
