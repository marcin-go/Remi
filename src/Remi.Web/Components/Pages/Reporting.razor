@page "/reports"
@page "/reports/{FrameworkValue:int}/{WorkspaceMonth}"
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@implements IDisposable

<PageTitle>Remi · Reports</PageTitle>

@if (IsWorkspace)
{
    <header class="return-workspace-header">
        <div class="return-workspace-title">
            <div>
                <h1>@Frameworks.Get(framework).DisplayName</h1>
                <p class="lede">@DisplayReportingMonth(reportingMonth) return</p>
            </div>
            <a class="remi-action remi-action--compact" href="@QueueRoute">Back to reports</a>
        </div>
    </header>

    <section class="gca-return-summary gca-return-summary--workspace" aria-labelledby="gca-return-summary-heading">
        <div class="gca-return-summary-heading">
            <div>
                <h2 id="gca-return-summary-heading">@Frameworks.Get(framework).AgreementNumber reporting summary</h2>
            </div>
        </div>
        <div class="gca-summary-content">
            <div class="table-wrap"><table>
                <thead><tr><th>Report section</th><th>Rows</th><th>Total (ex VAT)</th></tr></thead>
                <tbody>
                    <tr><th class="gca-summary-section" scope="row">Invoices</th><td>@(SelectedReturn?.InvoiceCount ?? 0)</td><td>@Currency(SelectedReturn?.InvoiceTotalExVat ?? 0)</td></tr>
                    <tr><th class="gca-summary-section" scope="row">Contracts</th><td>@(SelectedReturn?.ContractCount ?? 0)</td><td>@Currency(SelectedReturn?.ContractTotalExVat ?? 0)</td></tr>
                    <tr><th class="gca-summary-section" scope="row">Others</th><td>0</td><td>@Currency(0)</td></tr>
                </tbody>
            </table></div>
            @if (PurchaseOrderNumber is not null)
            {
                <div class="gca-purchase-order"><span>Purchase order number</span><strong>@PurchaseOrderNumber</strong></div>
            }
        </div>
    </section>

    <section class="return-workflow" aria-labelledby="return-workflow-heading">
        <div class="return-workflow-heading">
            <div>
                <p class="eyebrow">Monthly return</p>
                <h2 id="return-workflow-heading">@CurrentStatus</h2>
                <p class="muted">@ReadinessMessage</p>
            </div>
            <span class="@ReturnStatusClass(SelectedReturn?.ReturnStatus)">@CurrentStatus</span>
        </div>
        <ol class="return-workflow-steps">
            <li class="@WorkflowStepClass(1)"><span>1</span><strong>Review data</strong></li>
            <li class="@WorkflowStepClass(2)"><span>2</span><strong>Generate workbook</strong></li>
            <li class="@WorkflowStepClass(3)"><span>3</span><strong>Upload to GCA portal</strong></li>
            <li class="@WorkflowStepClass(4)"><span>4</span><strong>Record submission</strong></li>
        </ol>
        <div class="return-next-action">
            <div>
                <p class="eyebrow">Next action</p>
                <h3>@NextActionLabel</h3>
                <p class="muted">@NextActionMessage</p>
            </div>
            <div class="return-next-action-control">
                @if (CanGenerateReturn)
                {
                    <button class="remi-action remi-action--primary" disabled="@working" @onclick="GenerateReturnAsync">Generate workbook</button>
                }
                else if (CanMarkSubmitted)
                {
                    <label class="submission-reference">Portal submission reference <span class="optional">(optional)</span><input @bind="submissionReference" @bind:event="oninput" placeholder="Portal confirmation or ticket ID" /></label>
                    <button class="remi-action remi-action--primary" disabled="@working" @onclick="MarkSubmittedAsync">Record submission</button>
                }
                else if (CanMarkNilReturn)
                {
                    <button class="remi-action remi-action--primary" disabled="@working" @onclick="MarkNilReturnAsync">Record nil return</button>
                }
                else if (CurrentStatus == "Submitted")
                {
                    <span class="readiness-status complete">No further action</span>
                }
            </div>
        </div>
        @if (actionResult is not null)
        {
            <p class="notice @(actionResult.Succeeded ? "success" : "error")" role="status">@actionResult.Message</p>
        }
    </section>

    <section class="return-disclosures" aria-label="Return detail">
        <details class="return-disclosure">
            <summary><span><strong>Data review</strong><small>@ActivitySummary</small></span></summary>
            @if (!HasActivity)
            {
                <p class="muted">No reportable contracts or invoices have been recorded for this framework and month.</p>
            }
            else if (!HasReviewData)
            {
                <p class="muted">This return has reportable activity, but its review rows are not available yet. Open the Contracts or Invoices register to review the recorded data.</p>
            }
            else
            {
                @if (reportingCard?.Contracts.Count > 0)
                {
                    <h3>Contracts</h3>
                    @foreach (var item in reportingCard.Contracts)
                    {
                        <details class="reporting-card-row"><summary>@item.Title</summary><dl>@foreach (var field in item.Fields) { <div><dt>@field.Label</dt><dd>@field.Value</dd></div> }</dl></details>
                    }
                }
                @if (reportingCard?.Invoices.Count > 0)
                {
                    <h3>Invoices</h3>
                    @foreach (var item in reportingCard.Invoices)
                    {
                        <details class="reporting-card-row"><summary>@item.Title</summary><dl>@foreach (var field in item.Fields) { <div><dt>@field.Label</dt><dd>@field.Value</dd></div> }</dl></details>
                    }
                }
            }
        </details>

        <details class="return-disclosure">
            <summary><span><strong>Checks</strong><small>@ChecksSummary</small></span></summary>
            @if (actionResult?.Findings.Count > 0)
            {
                <ul class="findings inline-findings">@foreach (var finding in actionResult.Findings) { <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li> }</ul>
            }
            else
            {
                <p class="muted">Open the relevant contract or invoice from the register to correct any reported issue.</p>
            }
        </details>

        <details class="return-disclosure">
            <summary><span><strong>Generated files</strong><small>@GeneratedFilesSummary</small></span></summary>
            @if (GeneratedFiles.Count == 0)
            {
                <p class="muted">No workbook has been generated for this return.</p>
            }
            else
            {
                <div class="evidence-list">@foreach (var item in GeneratedFiles) { <a class="evidence-item" href="@($"/evidence/{item.Id}")" target="_blank"><span><strong>@item.FileName</strong><span class="cell-secondary">Created <time datetime="@item.ArchivedAtUtc.ToString("O")">@item.ArchivedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</time></span></span></a> }</div>
                @if (CanRegenerateReturn)
                {
                    <div class="return-regenerate-action">
                        <p class="muted">Regenerate only after changing the registered data or approved template. The previous unsubmitted generated workbook is superseded in the evidence archive.</p>
                        <button class="remi-action remi-action--section" disabled="@working" @onclick="GenerateReturnAsync">Regenerate workbook</button>
                    </div>
                }
            }
        </details>

        @if (CurrentStatus == "Submitted")
        {
            <details class="return-disclosure return-disclosure--secondary">
                <summary><span><strong>Correction</strong><small>Use only when the submitted return needs amendment</small></span></summary>
                <label class="correction-reason">Correction reason <input @bind="correctionReason" @bind:event="oninput" placeholder="What needs correcting and why?" /></label>
                <button class="remi-action remi-action--section" disabled="@(!CanRequestCorrection || working)" @onclick="RequestCorrectionAsync">Request correction</button>
            </details>
        }

        <details class="return-disclosure return-disclosure--secondary">
            <summary><span><strong>Help</strong><small>What Remi validates and retains</small></span></summary>
            <p class="muted">Remi checks contract, invoice and duplicate-reporting data. It retains approved templates and generated workbooks in the evidence archive.</p>
            <a class="remi-action remi-action--section" href="@($"/settings?period={reportingMonth}&section=templates")">Manage approved templates</a>
        </details>
    </section>
}
else
{
    <header class="dashboard-header">
        <div>
            <h1>Monthly returns</h1>
            <p class="lede">Choose a framework return to see the one action needed for this reporting month.</p>
        </div>
    </header>

    <section class="panel return-register-panel">
        <div class="panel-heading return-register-heading"><div><h2>Browse reports</h2></div></div>
        <div class="return-register-controls">
            <div class="return-register-views" role="tablist" aria-label="Reports view">
                <button class="button secondary @(registerView == "month" ? "active" : null)" role="tab" aria-selected="@(registerView == "month" ? "true" : "false")" @onclick="@(() => registerView = "month")">By reporting month</button>
                <button class="button secondary @(registerView == "framework" ? "active" : null)" role="tab" aria-selected="@(registerView == "framework" ? "true" : "false")" @onclick="@(() => registerView = "framework")">By framework</button>
            </div>
            @if (registerView == "month")
            {
                <label class="return-register-filter">Reporting month<select @bind="registerMonth">@foreach (var month in returnRegister?.ReportingMonths ?? []) { <option value="@month">@DisplayReportingMonth(month)</option> }</select></label>
            }
            else
            {
                <label class="return-register-filter">Framework<select @bind="registerFramework">@foreach (var definition in RegisterFrameworks) { <option value="@definition.Code">@definition.DisplayName (@definition.AgreementNumber)</option> }</select></label>
            }
        </div>
        @if (returnRegister is null)
        {
            <p class="muted">Loading the return register...</p>
        }
        else
        {
            <div class="table-wrap return-register-table"><table><thead><tr>
                @if (registerView == "month") { <th>Framework</th> } else { <th>Reporting month</th> }
                <th>Status</th><th>Activity</th><th>Readiness</th><th class="table-action-cell"><span class="visually-hidden">Open</span></th>
            </tr></thead><tbody>
            @foreach (var item in VisibleReturnEntries)
            {
                <tr>
                    @if (registerView == "month") { <td><strong>@item.Framework.DisplayName</strong><span class="cell-secondary">@item.Framework.AgreementNumber</span></td> } else { <td><strong>@DisplayReportingMonth(item.ReportingMonth)</strong></td> }
                    <td><span class="@ReturnStatusClass(item.ReturnStatus)">@ReturnStatusLabel(item.ReturnStatus)</span></td>
                    <td>@item.ContractCount contract(s) · @item.InvoiceCount invoice(s) · @Currency(item.ContractTotalExVat + item.InvoiceTotalExVat)</td>
                    <td>@RegisterReadiness(item)</td>
                    <td class="table-action-cell"><a class="remi-action remi-action--table" href="@WorkspaceRoute(item)">Open <span aria-hidden="true">→</span></a></td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}

@code {
    [Parameter] public int? FrameworkValue { get; set; }
    [Parameter] public string? WorkspaceMonth { get; set; }

    private DashboardModel? model;
    private MonthlyReturnRegisterModel? returnRegister;
    private FrameworkCode framework = FrameworkCode.GCloud14;
    private FrameworkCode registerFramework = FrameworkCode.GCloud14;
    private string reportingMonth = string.Empty;
    private string registerMonth = string.Empty;
    private string registerView = "month";
    private string? submissionReference;
    private string? correctionReason;
    private ReturnActionResult? actionResult;
    private IReadOnlyList<ReportingEvidence> evidence = [];
    private ReportingCardModel? reportingCard;
    private bool working;

    private bool IsWorkspace => FrameworkValue is not null && !string.IsNullOrWhiteSpace(WorkspaceMonth);
    private MonthlyReturnRegisterEntry? SelectedReturn => returnRegister?.Entries.SingleOrDefault(item => item.Framework.Code == framework && item.ReportingMonth == reportingMonth);
    private IReadOnlyList<ReportingEvidence> GeneratedFiles => evidence.Where(item => item.Kind == EvidenceKind.GeneratedMiWorkbook).OrderByDescending(item => item.ArchivedAtUtc).ToList();
    private string QueueRoute => ReportingRoutes.WithPeriod("/reports", reportingMonth);
    private string CurrentStatus => SelectedReturn?.ReturnStatus switch
    {
        ReturnStatus.Draft => "Draft",
        ReturnStatus.Submitted => "Submitted",
        ReturnStatus.NilReturn => "Nil return recorded",
        ReturnStatus.CorrectionRequired => "Correction required",
        _ => "Not started",
    };
    private bool HasActivity => (SelectedReturn?.ContractCount ?? 0) + (SelectedReturn?.InvoiceCount ?? 0) > 0;
    private bool HasReviewData => reportingCard is not null && (reportingCard.Contracts.Count != 0 || reportingCard.Invoices.Count != 0);
    private string? PurchaseOrderNumber => (SelectedReturn?.InvoiceCount ?? 0) > 0
        ? $"GCA_{FrameworkAbbreviation(framework)}_{reportingMonth.Replace("-", string.Empty, StringComparison.Ordinal)}"
        : null;
    private bool HasEvidence => GeneratedFiles.Count != 0;
    private bool CanMarkSubmitted => HasActivity && HasEvidence && CurrentStatus is "Draft" or "Correction required";
    private bool CanGenerateReturn => HasActivity && !HasEvidence && CurrentStatus is "Draft" or "Correction required";
    private bool CanRegenerateReturn => HasActivity && HasEvidence && CurrentStatus is "Draft" or "Correction required";
    private bool CanMarkNilReturn => !HasActivity && CurrentStatus is not "Submitted" and not "Nil return recorded";
    private bool CanRequestCorrection => CurrentStatus == "Submitted" && !string.IsNullOrWhiteSpace(correctionReason);
    private string ActivitySummary => $"{SelectedReturn?.ContractCount ?? 0} contract(s) · {SelectedReturn?.InvoiceCount ?? 0} invoice(s)";
    private string ChecksSummary => SelectedReturn is null ? "Loading checks" : SelectedReturn.BlockingFindingCount > 0 ? $"{SelectedReturn.BlockingFindingCount} blocking issue(s)" : SelectedReturn.ReviewFindingCount > 0 ? $"{SelectedReturn.ReviewFindingCount} review item(s)" : "No reported issues";
    private string GeneratedFilesSummary => GeneratedFiles.Count == 0 ? "No workbook" : $"{GeneratedFiles.Count} retained workbook(s)";
    private string ReadinessMessage => CanMarkSubmitted ? "The workbook is ready to upload to the GCA portal and record as submitted." : HasActivity && !HasEvidence ? "Review the data, then generate the approved workbook." : !HasActivity ? "No reportable activity is present. Record a nil return only when that is correct." : CurrentStatus == "Submitted" ? "This return has been recorded as submitted." : "Review the return status and data before continuing.";
    private string NextActionLabel => CanGenerateReturn ? "Generate the workbook" : CanMarkSubmitted ? "Record the portal submission" : CanMarkNilReturn ? "Record a nil return" : CurrentStatus == "Submitted" ? "Return complete" : "Review data";
    private string NextActionMessage => CanGenerateReturn ? "This creates and retains a review copy using the active approved template." : CanMarkSubmitted ? "Upload the retained workbook in the GCA portal first, then record its confirmation here." : CanMarkNilReturn ? "This records that there was no activity for the selected return." : CurrentStatus == "Submitted" ? "Use Correction only when the submitted return needs amendment." : "Open Data review and Checks to resolve the next step.";

    protected override void OnInitialized() => ReportingPeriod.Changed += ReportingPeriodChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (IsWorkspace && FrameworkValue is int routeFramework && Enum.IsDefined(typeof(FrameworkCode), routeFramework) && ReportingPeriodContext.IsValidPeriod(WorkspaceMonth))
        {
            framework = (FrameworkCode)routeFramework;
            reportingMonth = WorkspaceMonth!;
            registerFramework = framework;
        }
        else
        {
            reportingMonth = ReportingPeriod.SelectedPeriod;
        }
        registerMonth = reportingMonth;
        await ReloadAsync();
    }

    public void Dispose() => ReportingPeriod.Changed -= ReportingPeriodChanged;

    private async void ReportingPeriodChanged()
    {
        await InvokeAsync(async () =>
        {
            if (!IsWorkspace) { reportingMonth = ReportingPeriod.SelectedPeriod; registerMonth = reportingMonth; }
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        model = await Workspace.GetDashboardAsync(reportingMonth);
        returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
        EnsureRegisterFrameworkSelection();
        if (IsWorkspace) await LoadReportingPeriodAsync();
    }

    private async Task MarkSubmittedAsync()
    {
        working = true;
        actionResult = await Workspace.MarkSubmittedAsync(framework, reportingMonth, submissionReference);
        working = false;
        await ReloadAsync();
    }

    private async Task GenerateReturnAsync()
    {
        working = true;
        try
        {
            var exported = await Workspace.ExportReturnAsync(framework, reportingMonth);
            actionResult = exported is null ? new ReturnActionResult(false, "Register an active approved template before generating this return.", []) : new ReturnActionResult(true, $"Generated {exported.FileName}. It is retained in the evidence archive.", exported.Findings);
        }
        catch (Exception exception) { actionResult = new ReturnActionResult(false, $"The MI workbook could not be generated: {exception.Message}", []); }
        finally { working = false; }
        await ReloadAsync();
    }

    private async Task MarkNilReturnAsync()
    {
        working = true;
        actionResult = await Workspace.MarkNilReturnAsync(framework, reportingMonth);
        working = false;
        await ReloadAsync();
    }

    private async Task RequestCorrectionAsync()
    {
        working = true;
        actionResult = await Workspace.RequestCorrectionAsync(framework, reportingMonth, correctionReason ?? string.Empty);
        working = false;
        await ReloadAsync();
    }

    private async Task LoadReportingPeriodAsync()
    {
        if (!ReportingPeriodContext.IsValidPeriod(reportingMonth)) { evidence = []; reportingCard = null; return; }
        var evidenceTask = Workspace.GetReportingEvidenceAsync(framework, reportingMonth);
        var cardTask = Workspace.GetReportingCardAsync(framework, reportingMonth);
        await Task.WhenAll(evidenceTask, cardTask);
        evidence = await evidenceTask;
        reportingCard = await cardTask;
        submissionReference = SelectedReturn?.SubmissionReference;
    }

    private IEnumerable<MonthlyReturnRegisterEntry> VisibleReturnEntries => (returnRegister?.Entries ?? []).Where(item => registerView == "month" ? item.ReportingMonth == registerMonth : item.Framework.Code == registerFramework).OrderBy(item => item.Framework.DisplayName, StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<FrameworkDefinition> RegisterFrameworks => (returnRegister?.Entries ?? []).Select(item => item.Framework).DistinctBy(item => item.Code).OrderBy(item => item.DisplayName, StringComparer.Ordinal).ToList();
    private void EnsureRegisterFrameworkSelection() { if (RegisterFrameworks.All(item => item.Code != registerFramework)) registerFramework = RegisterFrameworks.FirstOrDefault()?.Code ?? registerFramework; }
    private static string ReturnStatusLabel(ReturnStatus? status) => status switch { ReturnStatus.Draft => "Draft", ReturnStatus.Submitted => "Submitted", ReturnStatus.NilReturn => "Nil return", ReturnStatus.CorrectionRequired => "Correction required", _ => "Not started" };
    private static string ReturnStatusClass(ReturnStatus? status) => status switch { ReturnStatus.Submitted or ReturnStatus.NilReturn => "readiness-status complete", ReturnStatus.CorrectionRequired => "readiness-status warning", ReturnStatus.Draft => "readiness-status neutral", _ => "readiness-status neutral" };
    private static string RegisterReadiness(MonthlyReturnRegisterEntry item) => item.BlockingFindingCount > 0 ? $"{item.BlockingFindingCount} blocking issue(s)" : item.ReviewFindingCount > 0 ? $"{item.ReviewFindingCount} review item(s)" : item.ContractCount == 0 && item.InvoiceCount == 0 ? "No activity" : "Ready for review";
    private string WorkspaceRoute(MonthlyReturnRegisterEntry item) => $"/reports/{(int)item.Framework.Code}/{item.ReportingMonth}?period={item.ReportingMonth}";
    private int CurrentWorkflowStep => CanGenerateReturn ? 2 : CanMarkSubmitted ? 4 : CanMarkNilReturn ? 4 : CurrentStatus == "Submitted" ? 4 : 1;
    private string WorkflowStepClass(int step) => step < CurrentWorkflowStep ? "complete" : step == CurrentWorkflowStep ? "current" : string.Empty;
    private static string DisplayReportingMonth(string month) => DateOnly.ParseExact($"{month}-01", "yyyy-MM-dd").ToString("MMMM yyyy");
    private static string FrameworkAbbreviation(FrameworkCode framework) => framework switch
    {
        FrameworkCode.GCloud13 => "G13",
        FrameworkCode.GCloud14 => "G14",
        FrameworkCode.VerticalApplicationSolutions => "VAS",
        FrameworkCode.GCloud15 => "G15",
        _ => throw new ArgumentOutOfRangeException(nameof(framework), framework, null),
    };
    private static string Currency(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
}
