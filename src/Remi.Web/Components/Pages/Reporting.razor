@page "/reports"
@page "/reports/{FrameworkValue:int}/{WorkspaceMonth}"
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@implements IDisposable

<PageTitle>Remi · Reports</PageTitle>

@if (IsWorkspace)
{
    <header class="return-workspace-header">
        <div class="return-workspace-title">
            <div>
                <h1>@Frameworks.Get(framework).DisplayName</h1>
                <p class="lede">@DisplayReportingMonth(reportingMonth) return · @Frameworks.Get(framework).AgreementNumber</p>
            </div>
        </div>
    </header>

    <section class="gca-return-summary gca-return-summary--workspace" aria-label="Return totals">
        <div class="gca-summary-content">
            <div class="table-wrap"><table>
                <thead><tr><th>Report section</th><th>Rows</th><th>Total (ex VAT)</th></tr></thead>
                <tbody>
                    <tr><th class="gca-summary-section" scope="row">Invoices</th><td>@(SelectedReturn?.InvoiceCount ?? 0)</td><td>@Currency(SelectedReturn?.InvoiceTotalExVat ?? 0)</td></tr>
                    <tr><th class="gca-summary-section" scope="row">Contracts</th><td>@(SelectedReturn?.ContractCount ?? 0)</td><td>@Currency(SelectedReturn?.ContractTotalExVat ?? 0)</td></tr>
                    <tr><th class="gca-summary-section" scope="row">Others</th><td>0</td><td>@Currency(0)</td></tr>
                </tbody>
            </table></div>
            <p class="gca-purchase-order"><span>Purchase order</span><strong>@PurchaseOrderNumber</strong></p>
        </div>
    </section>

    <section class="return-workflow" aria-labelledby="return-workflow-heading">
        <div class="return-workflow-heading">
            <div>
                <h2 id="return-workflow-heading">Submission workflow</h2>
                @if (IsCorrectionRequired) { <p class="muted">A correction has been requested. The earlier submission remains in the record below.</p> }
            </div>
            <div class="return-workflow-statuses">
                <span class="@LifecycleBadgeClass">@LifecycleHeading</span>
                @if (IsNilReturn || IsNilReturnDraft) { <span class="nil-return-badge">Nil return</span> }
            </div>
        </div>
        <div class="return-workflow-tabs" role="tablist" aria-label="Report submission stages">
            @foreach (var stage in WorkflowStages)
            {
                <button type="button"
                        id="@($"return-stage-tab-{stage.Number}")"
                        class="@WorkflowTabClass(stage.Number)"
                        role="tab"
                        aria-selected="@(activeWorkflowStage == stage.Number ? "true" : "false")"
                        data-stage="@stage.Number"
                        @onclick="@(() => SelectWorkflowStage(stage.Number))">
                    <span>@stage.Label</span>
                    @if (WorkflowStageMark(stage.Number) is { } statusMark)
                    {
                        <span class="return-workflow-tab-status" aria-label="Completed">@statusMark</span>
                    }
                </button>
            }
        </div>
        <section id="@($"return-stage-panel-{activeWorkflowStage}")" class="return-stage-panel" role="tabpanel" aria-labelledby="@($"return-stage-tab-{activeWorkflowStage}")">
        @if (activeWorkflowStage == 2)
        {
            <section class="return-stage-workbook" aria-label="Generate workbook">
                @if (IsNilReturnDraft)
                {
                    <p class="return-stage-intro">Nil returns do not need a workbook. Report no business in GCA, then return to Remi to record the confirmation.</p>
                    <button class="remi-action remi-action--primary" @onclick="@(() => SelectWorkflowStage(3))">Continue to upload</button>
                }
                else if (GeneratedFiles.Count == 0)
                {
                    <p class="return-stage-intro">Create the workbook that will be uploaded to GCA. Reporting checks run before generation.</p>
                    <button class="remi-action remi-action--primary" disabled="@(working || !CanPrepareWorkbook)" @onclick="GenerateReturnAsync">Generate workbook</button>
                }
                else
                {
                    <p class="return-stage-intro">The retained workbook is ready for GCA.</p>
                    <div class="return-workbook-list">@foreach (var item in GeneratedFiles) { <ReportingWorkbookCard Workbook="item" /> }</div>
                    <div class="return-stage-actions">@if (CanPrepareWorkbook) { <button class="remi-action remi-action--section" disabled="@working" @onclick="GenerateReturnAsync">Regenerate workbook</button> }<button class="remi-action remi-action--primary" @onclick="@(() => SelectWorkflowStage(3))">Continue to upload</button></div>
                }
            </section>
        }
        else if (activeWorkflowStage == 3)
        {
            <section class="return-stage-upload" aria-label="Upload to GCA">
                <p class="return-stage-intro">Upload the retained workbook in GCA, then return here to record the confirmation.</p>
                @if (CanProceedToUpload)
                {
                    @if (GeneratedFiles.FirstOrDefault() is { } workbook)
                    {
                        <ReportingWorkbookCard Workbook="workbook" />
                    }
                    else
                    {
                        <p class="return-stage-empty">This is a nil return, so no workbook needs to be uploaded.</p>
                    }
                    <ol class="return-upload-steps"><li>Sign in to the GCA reporting portal.</li><li>@(IsNilReturnDraft ? "Report no business for this period." : "Upload the workbook above.")</li><li>Complete the GCA submission.</li><li>Return here to record the confirmation.</li></ol>
                    <div class="return-stage-actions"><a class="remi-action remi-action--section" href="https://www.reportmi.gca.gov.uk/" target="_blank" rel="noreferrer">Open GCA portal</a><button class="remi-action remi-action--primary" @onclick="@(() => SelectWorkflowStage(4))">Continue to record submission</button></div>
                }
                else
                {
                    <p class="return-stage-empty">Generate the reporting workbook before uploading it to GCA.</p>
                    <button class="remi-action remi-action--primary" @onclick="@(() => SelectWorkflowStage(2))">Go to workbook</button>
                }
            </section>
        }
        else if (activeWorkflowStage == 4 && (CanRecordPortalSubmission || pendingSubmission is not null))
        {
            <ClipboardImageEvidence @ref="submissionClipboardEvidence"
                                    LayoutClass="return-submission-evidence-layout"
                                    OnDocumentsChanged="SetSubmissionClipboardImageCount"
                                    Heading="Submission evidence"
                                    DropZoneTitle="Submission evidence"
                                    EmptyMessage="Add the GCA submission confirmation screenshot."
                                    ShowHeader="false">
                <section class="return-current-action return-submission-capture" id="submission-record" aria-label="@SubmissionActionHeading">
                    <p class="return-stage-intro">@(pendingSubmission is not null ? "The submission is recorded. Retry its unfinished documents; the submission will not be recorded again." : SubmissionActionGuidance)</p>
                    <div class="return-submission-capture-actions">
                        <label class="submission-reference floating-field floating-field--static"><input @bind="submissionReference" @bind:event="oninput" disabled="@(working || pendingSubmission is not null)" placeholder="e0303f95-3441-4d48-bd32-e028a66f87db" /><span class="floating-label">GCA task reference (optional)</span></label>
                        <label class="submission-timestamp floating-field floating-field--static"><input @bind="submissionTimestampInput" @bind:event="oninput" disabled="@(working || pendingSubmission is not null)" placeholder="6 August 2026 13:45 UTC" aria-label="Submission date and time" /><span class="floating-label">Submission date and time (UTC)</span></label>
                        <button class="remi-action remi-action--primary" disabled="@(working || !SubmissionTimestampIsValid)" @onclick="RecordCurrentSubmissionAsync">@(pendingSubmission is not null ? "Retry documents" : IsNilReturnDraft ? "Record nil submission" : IsCorrectionRequired ? "Record corrected submission" : "Record submission")</button>
                    </div>
                    @if (!SubmissionTimestampIsValid) { <p class="field-validation-message" role="status">Use a date and time such as 6 August 2026 13:45 UTC.</p> }
                </section>
            </ClipboardImageEvidence>
        }
        else if (activeWorkflowStage == 4 && HasSubmissionRecord)
        {
            @if (!editingSubmissionRecord)
            {
                <section class="return-submission-record" aria-labelledby="submission-record-heading">
                    <div class="return-submission-record-heading">
                        <div><h3 id="submission-record-heading">Submission record</h3></div>
                        <div class="return-submission-record-actions">@if (IsNilReturn) { <span class="nil-return-badge">Nil return</span> }<button class="remi-action remi-action--section" @onclick="EditSubmissionRecord">Edit</button></div>
                    </div>
                    <div class="return-submission-record-grid">
                        <div class="return-submission-evidence-view">
                            @if (SubmissionEvidenceDocuments.Count == 0)
                            {
                                <div class="return-submission-evidence-empty"><strong>No submission evidence</strong><span>Edit the record to paste or upload the GCA confirmation image.</span></div>
                            }
                            else
                            {
                                <EvidenceGallery Documents="SubmissionEvidenceDocuments" />
                            }
                        </div>
                        <div class="return-submission-metadata">
                            <dl class="return-submission-facts">
                                <div><dt>GCA task reference</dt><dd>@if (!string.IsNullOrWhiteSpace(SelectedReturn?.SubmissionReference)) { <code>@SelectedReturn!.SubmissionReference</code> } else { <span class="not-recorded">Not recorded</span> }</dd></div>
                                <div><dt>Date and time of submission</dt><dd>@if (SelectedReturn?.SubmittedAtUtc is { } submittedAt) { <time datetime="@submittedAt.ToString("O")">@SubmissionTimestampParser.FormatUtc(submittedAt)</time> } else { <span class="not-recorded">Not recorded</span> }</dd></div>
                            </dl>
                            @if (GcaSubmissionTaskUrl is { } gcaSubmissionTaskUrl) { <a class="remi-action remi-action--section" href="@gcaSubmissionTaskUrl" target="_blank" rel="noreferrer">Open GCA submission</a> }
                        </div>
                    </div>
                    @if (submissionHistory.Count > 1) { <details class="submission-history"><summary>Previous submission history (@(submissionHistory.Count - 1))</summary><ul>@foreach (var item in submissionHistory.Skip(1)) { <li>@SubmissionHistoryDescription(item)</li> }</ul></details> }
                </section>
            }
            else
            {
                <ClipboardImageEvidence @ref="submissionEditClipboardEvidence"
                                        LayoutClass="return-submission-evidence-layout return-submission-evidence-layout--edit"
                                        OnDocumentsChanged="SetSubmissionEditClipboardImageCount"
                                        Heading="Submission evidence"
                                        DropZoneTitle="Submission evidence"
                                        EmptyMessage="Add the GCA submission confirmation screenshot."
                                        ShowHeader="false">
                    <section class="return-current-action return-submission-edit" aria-labelledby="submission-edit-heading" inert="@working">
                        <div><h3 id="submission-edit-heading">Edit submission record</h3><p class="muted">Update the retained GCA details and documents without reopening the return.</p></div>
                        <div class="submission-evidence-details">
                            <label class="submission-reference floating-field floating-field--static"><input @bind="submissionReference" @bind:event="oninput" placeholder="e0303f95-3441-4d48-bd32-e028a66f87db" /><span class="floating-label">GCA task reference</span></label>
                            <label class="submission-timestamp floating-field floating-field--static"><input @bind="submissionTimestampInput" @bind:event="oninput" placeholder="6 August 2026 13:45 UTC" aria-label="Submission date and time" /><span class="floating-label">Submission date and time (UTC)</span></label>
                            @if (!SubmissionTimestampIsValid) { <p class="field-validation-message" role="status">Use a date and time such as 6 August 2026 13:45 UTC.</p> }
                        </div>
                        @if (submissionEvidenceEdits.Count != 0)
                        {
                            <section class="submission-document-editor" aria-labelledby="submission-document-editor-heading">
                                <header><div><h4 id="submission-document-editor-heading">Retained documents</h4><p>Change a title or mark a document for deletion. Changes take effect when you save.</p></div><span>@SubmissionEvidenceEditStatus</span></header>
                                <div class="submission-document-edit-list">
                                    @foreach (var document in submissionEvidenceEdits)
                                    {
                                        <article class="submission-document-edit-item @(document.MarkedForDeletion ? "submission-document-edit-item--remove" : null)">
                                            @if (EvidencePreviewPolicy.GetKind(document.FileName) == EvidencePreviewKind.Image)
                                            {
                                                <img src="@($"/evidence/{document.EvidenceId}/preview")" alt="" />
                                            }
                                            else
                                            {
                                                <span class="submission-document-edit-icon" aria-hidden="true">▧</span>
                                            }
                                            <div>
                                                <label class="floating-field floating-field--static"><input @bind="document.Title" @bind:event="oninput" placeholder="Document title" aria-label="Document title for @document.FileName" disabled="@document.MarkedForDeletion" /><span class="floating-label">Document title</span></label>
                                                <small>@document.FileName</small>
                                                @if (document.MarkedForDeletion) { <span class="submission-document-removal-note">Will be permanently deleted when you save.</span> }
                                                else if (!IsValidEvidenceTitle(document.Title)) { <span class="field-validation-message">Enter a valid document title.</span> }
                                            </div>
                                            <button type="button"
                                                    class="remi-action remi-action--compact @(document.MarkedForDeletion ? "remi-action--quiet" : "remi-action--danger") submission-document-remove"
                                                    aria-label="@(document.MarkedForDeletion ? $"Undo removal of {document.FileName}" : $"Remove {document.FileName}")"
                                                    aria-pressed="@(document.MarkedForDeletion ? "true" : "false")"
                                                    @onclick="@(() => ToggleSubmissionEvidenceRemoval(document))">@(document.MarkedForDeletion ? "Undo" : "Remove")</button>
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                        <div class="submission-evidence-save"><button class="remi-action remi-action--primary" disabled="@(!CanSaveSubmissionRecord)" @onclick="SaveSubmissionRecordAsync">@(working ? "Saving..." : "Save")</button><button class="remi-action remi-action--compact" disabled="@working" @onclick="CancelSubmissionEdit">Cancel</button></div>
                    </section>
                </ClipboardImageEvidence>
            }
            @if (IsSubmitted && !editingSubmissionRecord)
            {
                <section class="return-stage-correction" aria-labelledby="return-correction-heading"><header><div><h3 id="return-correction-heading">Correction</h3><p>Use only when the submitted return needs amendment.</p></div></header><label class="correction-reason floating-field floating-field--static"><input @bind="correctionReason" @bind:event="oninput" placeholder="What needs correcting and why?" /><span class="floating-label">Correction reason</span></label><button class="remi-action remi-action--section" disabled="@(!CanRequestCorrection || working)" @onclick="RequestCorrectionAsync">Request correction</button></section>
            }
        }
        else if (activeWorkflowStage == 4)
        {
            <section class="return-stage-record-gate" aria-label="Record submission"><p class="return-stage-intro">Complete the GCA upload stage before recording its confirmation.</p><button class="remi-action remi-action--primary" @onclick="@(() => SelectWorkflowStage(3))">Go to upload</button></section>
        }
        else
        {
            <section class="return-stage-review" aria-label="Review data">
                <div class="return-stage-toolbar"><p class="return-stage-intro">Inspect the data that will be included in this reporting period.</p><button class="remi-action remi-action--section" @onclick="@(() => SelectWorkflowStage(2))">Continue to workbook</button></div>
                <section class="return-stage-checks @(HasReportingIssues ? "return-stage-checks--issues" : null)" aria-labelledby="return-checks-heading">
                    <h3 id="return-checks-heading">Checks</h3>
                    @if (reportingFindings.Count != 0)
                    {
                        <ul class="findings inline-findings">@foreach (var finding in reportingFindings) { <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li> }</ul>
                    }
                    else
                    {
                        <p>No reporting issues found.</p>
                    }
                </section>
                <section class="return-stage-review-data" aria-labelledby="return-review-data-heading">
                    <header><h3 id="return-review-data-heading">Report contents</h3><span>@ActivitySummary</span></header>
                    @if (IsNilReturn || IsNilReturnDraft)
                    {
                        <p class="return-stage-empty">Nil return. No contracts, invoices or other reportable items were present for this reporting period.</p>
                    }
                    else if (!HasActivity)
                    {
                        <p class="return-stage-empty">No reportable contracts or invoices have been recorded for this framework and month.</p>
                    }
                    else if (!HasReviewData)
                    {
                        <p class="return-stage-empty">The review rows are not available yet. Open the Contracts or Invoices register to inspect the recorded data.</p>
                    }
                    else
                    {
                        @if (reportingCard?.Contracts.Count > 0)
                        {
                            <h4>Contracts <span>@reportingCard.Contracts.Count</span></h4>
                            @foreach (var item in reportingCard.Contracts)
                            {
                                <details class="reporting-card-row"><summary>@item.Title</summary><dl>@foreach (var field in item.Fields) { <div><dt>@field.Label</dt><dd>@field.Value</dd></div> }</dl></details>
                            }
                        }
                        @if (reportingCard?.Invoices.Count > 0)
                        {
                            <h4>Invoices <span>@reportingCard.Invoices.Count</span></h4>
                            @foreach (var item in reportingCard.Invoices)
                            {
                                <details class="reporting-card-row"><summary>@item.Title</summary><dl>@foreach (var field in item.Fields) { <div><dt>@field.Label</dt><dd>@field.Value</dd></div> }</dl></details>
                            }
                        }
                    }
                </section>
            </section>
        }
        </section>
        @if (actionResult is not null) { <p class="notice @(actionResult.Succeeded ? "success" : "error")" role="status">@actionResult.Message</p> }
    </section>

}
else
{
    <header class="dashboard-header">
        <div>
            <h1>Monthly returns</h1>
            <p class="lede">Browse the historical register or open a framework return for its reporting workflow.</p>
        </div>
    </header>

    <section class="panel return-register-panel">
        <div class="panel-heading return-register-heading"><div><h2>Browse reports</h2></div></div>
        <div class="return-register-controls">
            <div class="return-register-views" role="tablist" aria-label="Reports view">
                <button class="button secondary @(registerView == "month" ? "active" : null)" role="tab" aria-selected="@(registerView == "month" ? "true" : "false")" @onclick="@(() => registerView = "month")">By reporting month</button>
                <button class="button secondary @(registerView == "framework" ? "active" : null)" role="tab" aria-selected="@(registerView == "framework" ? "true" : "false")" @onclick="@(() => registerView = "framework")">By framework</button>
            </div>
            @if (registerView == "month")
            {
                <RemiPicklist Id="return-register-month-picklist-options"
                              Label="Reporting month"
                              Items="@(returnRegister?.ReportingMonths ?? [])"
                              Value="@registerMonth"
                              ValueChanged="SetRegisterMonth"
                              ItemLabel="DisplayReportingMonth"
                              CssClass="return-register-filter" />
            }
            else
            {
                <RemiPicklist Id="return-register-framework-picklist-options"
                              Label="Framework"
                              Items="@RegisterFrameworkOptions"
                              Value="@registerFramework.ToString()"
                              ValueChanged="SetRegisterFramework"
                              ItemLabel="RegisterFrameworkLabel"
                              ItemGroup="RegisterFrameworkGroup"
                              CssClass="return-register-filter" />
            }
        </div>
        @if (returnRegister is null)
        {
            <p class="muted">Loading the return register...</p>
        }
        else
        {
            <div class="table-wrap return-register-table"><table><thead><tr>
                @if (registerView == "month") { <th>Framework</th> } else { <th>Reporting month</th> }
                <th>Status</th><th>Contracts</th><th>Invoices</th><th>Submission</th><th class="table-action-cell"><span class="visually-hidden">Open</span></th>
            </tr></thead><tbody>
            @foreach (var item in VisibleReturnEntries)
            {
                <tr>
                    @if (registerView == "month") { <td><strong>@item.Framework.DisplayName</strong><span class="cell-secondary">@item.Framework.AgreementNumber</span></td> } else { <td><strong>@DisplayReportingMonth(item.ReportingMonth)</strong></td> }
                    <td><span class="@LifecycleClass(item.LifecycleStatus)">@LifecycleLabel(item.LifecycleStatus)</span></td>
                    <td class="return-register-measure"><strong>@item.ContractCount</strong><span class="cell-secondary">@Currency(item.ContractTotalExVat)</span></td>
                    <td class="return-register-measure"><strong>@item.InvoiceCount</strong><span class="cell-secondary">@Currency(item.InvoiceTotalExVat)</span></td>
                    <td class="return-register-submission">
                        @if (item.LifecycleStatus == ReportLifecycleStatus.Draft)
                        {
                            <span>Not submitted</span>
                        }
                        else
                        {
                            @if (item.IsNilReturn) { <span class="nil-return-badge">Nil return</span> }
                            <span>@SubmissionRegisterTiming(item)</span>
                            @if (!string.IsNullOrWhiteSpace(item.SubmissionReference)) { <span class="cell-secondary">GCA ref @ShortReference(item.SubmissionReference)</span> }
                        }
                    </td>
                    <td class="table-action-cell"><a class="remi-action remi-action--table" href="@WorkspaceRoute(item)">Open</a></td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}

@code {
    [Parameter] public int? FrameworkValue { get; set; }
    [Parameter] public string? WorkspaceMonth { get; set; }

    private MonthlyReturnRegisterModel? returnRegister;
    private FrameworkCode framework = FrameworkCode.GCloud14;
    private FrameworkCode registerFramework = FrameworkCode.GCloud14;
    private string reportingMonth = string.Empty;
    private string registerMonth = string.Empty;
    private string registerView = "month";
    private string? submissionReference;
    private string submissionTimestampInput = string.Empty;
    private string? correctionReason;
    private ReturnActionResult? actionResult;
    private IReadOnlyList<ReportingEvidence> evidence = [];
    private IReadOnlyList<ValidationFinding> reportingFindings = [];
    private IReadOnlyList<ReturnSubmissionHistoryItem> submissionHistory = [];
    private ReportingCardModel? reportingCard;
    private ClipboardImageEvidence? submissionClipboardEvidence;
    private ClipboardImageEvidence? submissionEditClipboardEvidence;
    private ReturnActionResult? pendingSubmission;
    private int submissionClipboardImageCount;
    private int submissionEditClipboardImageCount;
    private readonly List<SubmissionEvidenceEditModel> submissionEvidenceEdits = [];
    private int activeWorkflowStage;
    private bool editingSubmissionRecord;
    private bool working;

    private bool IsWorkspace => FrameworkValue is not null && !string.IsNullOrWhiteSpace(WorkspaceMonth);
    private MonthlyReturnRegisterEntry? SelectedReturn => returnRegister?.Entries.SingleOrDefault(item => item.Framework.Code == framework && item.ReportingMonth == reportingMonth);
    private ReportLifecycleStatus LifecycleStatus => SelectedReturn?.LifecycleStatus ?? ReportLifecycleStatus.Draft;
    private bool IsSubmitted => LifecycleStatus == ReportLifecycleStatus.Submitted;
    private bool IsCorrectionRequired => LifecycleStatus == ReportLifecycleStatus.CorrectionRequired;
    private bool IsNilReturn => SelectedReturn?.IsNilReturn ?? false;
    private bool IsNilReturnDraft => !HasActivity && LifecycleStatus == ReportLifecycleStatus.Draft;
    private bool HasSubmissionRecord => IsSubmitted || IsCorrectionRequired;
    private IReadOnlyList<ReportingEvidence> GeneratedFiles => evidence.Where(item => item.Kind == EvidenceKind.GeneratedMiWorkbook).OrderByDescending(item => item.ArchivedAtUtc).ToList();
    private IReadOnlyList<ReportingEvidence> SubmissionEvidence => evidence.Where(item => item.Kind == EvidenceKind.SubmissionEvidence).OrderByDescending(item => item.ArchivedAtUtc).ToList();
    private IReadOnlyList<EvidenceLink> SubmissionEvidenceDocuments => SubmissionEvidence
        .Select(item => new EvidenceLink(item.Id, item.Kind, item.FileName, item.OriginalRelativePath, item.ContentType, item.FileSizeBytes, reportingMonth, item.ArchivedAtUtc))
        .ToList();
    private string LifecycleHeading => LifecycleLabel(LifecycleStatus);
    private string LifecycleBadgeClass => LifecycleClass(LifecycleStatus);
    private bool HasActivity => (SelectedReturn?.ContractCount ?? 0) + (SelectedReturn?.InvoiceCount ?? 0) > 0;
    private bool HasReviewData => reportingCard is not null && (reportingCard.Contracts.Count != 0 || reportingCard.Invoices.Count != 0);
    private string PurchaseOrderNumber => $"GCA_{FrameworkAbbreviation(framework)}_{reportingMonth.Replace("-", string.Empty, StringComparison.Ordinal)}";
    private bool HasEvidence => GeneratedFiles.Count != 0;
    private bool CanMarkSubmitted => HasActivity && HasEvidence && LifecycleStatus is ReportLifecycleStatus.Draft or ReportLifecycleStatus.CorrectionRequired;
    private bool CanGenerateReturn => HasActivity && !HasEvidence && LifecycleStatus is ReportLifecycleStatus.Draft or ReportLifecycleStatus.CorrectionRequired;
    private bool CanRegenerateReturn => HasActivity && HasEvidence && LifecycleStatus is ReportLifecycleStatus.Draft or ReportLifecycleStatus.CorrectionRequired;
    private bool CanPrepareWorkbook => CanGenerateReturn || CanRegenerateReturn;
    private bool CanMarkNilReturn => !HasActivity && LifecycleStatus == ReportLifecycleStatus.Draft;
    private bool CanRecordPortalSubmission => CanMarkSubmitted || CanMarkNilReturn;
    private bool CanProceedToUpload => HasEvidence || IsNilReturnDraft;
    private bool CanRequestCorrection => IsSubmitted && !string.IsNullOrWhiteSpace(correctionReason);
    private bool HasReportingIssues => reportingFindings.Count != 0;
    private bool HasSubmissionReferenceChanged => !string.Equals(NormalizeSubmissionReference(submissionReference), NormalizeSubmissionReference(SelectedReturn?.SubmissionReference), StringComparison.Ordinal);
    private bool SubmissionTimestampIsValid => string.IsNullOrWhiteSpace(submissionTimestampInput) || SubmissionTimestampParser.TryParseUtc(submissionTimestampInput, out _);
    private bool HasSubmissionTimestampChanged => SubmissionTimestampParser.TryParseUtc(submissionTimestampInput, out var parsed)
        && SelectedReturn?.SubmittedAtUtc?.ToUniversalTime() != parsed;
    private bool HasSubmissionEvidenceChanged => submissionEvidenceEdits.Any(item => item.HasChanged);
    private bool SubmissionEvidenceTitlesAreValid => submissionEvidenceEdits.All(item => item.MarkedForDeletion || IsValidEvidenceTitle(item.Title));
    private string SubmissionEvidenceEditStatus
    {
        get
        {
            var removalCount = submissionEvidenceEdits.Count(item => item.MarkedForDeletion);
            var retainedCount = submissionEvidenceEdits.Count - removalCount;
            return removalCount == 0 ? $"{retainedCount} retained" : $"{retainedCount} retained · {removalCount} to delete";
        }
    }
    private bool CanSaveSubmissionRecord => !working
        && SubmissionTimestampIsValid
        && SubmissionEvidenceTitlesAreValid
        && SelectedReturn?.ReturnId is Guid
        && (HasSubmissionReferenceChanged || HasSubmissionTimestampChanged || HasSubmissionEvidenceChanged || submissionEditClipboardImageCount != 0);
    private string ActivitySummary => DescribeActivity(SelectedReturn?.ContractCount ?? 0, SelectedReturn?.InvoiceCount ?? 0);
    private string ChecksSummary => reportingFindings.Count == 0 ? "✓ No reporting issues found" : $"{reportingFindings.Count} {Pluralize(reportingFindings.Count, "issue", "issues")} require attention";
    private string GeneratedFilesSummary => GeneratedFiles.Count switch { 0 => "No workbook", 1 => GeneratedFiles[0].FileName, _ => $"{GeneratedFiles.Count} retained files" };
    private string? GcaSubmissionTaskUrl => GcaTaskUrl(SelectedReturn?.SubmissionReference);
    private string SubmissionActionHeading => IsNilReturnDraft ? "Record nil submission" : IsCorrectionRequired ? "Record corrected submission" : "Record submission";
    private string SubmissionActionGuidance => IsNilReturnDraft
        ? "After reporting no business in GCA, record its task reference and confirmation screenshot here."
        : IsCorrectionRequired
            ? "Review the correction, upload the revised workbook in GCA, then record the replacement submission."
            : "Upload the retained workbook in GCA, then record its task reference and confirmation screenshot here.";
    private static readonly WorkflowStageDefinition[] WorkflowStages =
    [
        new(1, "Review data"),
        new(2, "Generate workbook"),
        new(3, "Upload to GCA"),
        new(4, "Record submission"),
    ];

    protected override void OnInitialized() => ReportingPeriod.Changed += ReportingPeriodChanged;

    protected override async Task OnParametersSetAsync()
    {
        activeWorkflowStage = 0;
        if (IsWorkspace && FrameworkValue is int routeFramework && Enum.IsDefined(typeof(FrameworkCode), routeFramework) && ReportingPeriodContext.IsValidPeriod(WorkspaceMonth))
        {
            framework = (FrameworkCode)routeFramework;
            reportingMonth = WorkspaceMonth!;
            registerFramework = framework;
        }
        else
        {
            reportingMonth = ReportingPeriod.SelectedPeriod;
        }
        registerMonth = reportingMonth;
        await ReloadAsync();
    }

    public void Dispose() => ReportingPeriod.Changed -= ReportingPeriodChanged;

    private async void ReportingPeriodChanged()
    {
        await InvokeAsync(async () =>
        {
            if (!IsWorkspace) { reportingMonth = ReportingPeriod.SelectedPeriod; registerMonth = reportingMonth; }
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
        EnsureRegisterFrameworkSelection();
        if (IsWorkspace) await LoadReportingPeriodAsync();
    }

    private async Task GenerateReturnAsync()
    {
        working = true;
        try
        {
            var exported = await Workspace.ExportReturnAsync(framework, reportingMonth);
            actionResult = exported is null ? new ReturnActionResult(false, "Register an active approved template before generating this return.", []) : new ReturnActionResult(true, $"Generated {exported.FileName}. It is retained in the evidence archive.", exported.Findings);
        }
        catch (Exception exception) { actionResult = new ReturnActionResult(false, $"The MI workbook could not be generated: {exception.Message}", []); }
        finally { working = false; }
        await ReloadAsync();
    }

    private async Task RecordCurrentSubmissionAsync()
    {
        if (!TryGetSubmissionTimestamp(out var submittedAtUtc))
        {
            actionResult = new ReturnActionResult(false, "Enter the submission date and time as, for example, 6 August 2026 13:45 UTC.", []);
            return;
        }

        if (IsNilReturnDraft)
        {
            await RecordSubmissionAsync(() => Workspace.MarkNilReturnAsync(framework, reportingMonth, submissionReference, submittedAtUtc));
        }
        else
        {
            await RecordSubmissionAsync(() => Workspace.MarkSubmittedAsync(framework, reportingMonth, submissionReference, submittedAtUtc));
        }
    }

    private async Task RecordSubmissionAsync(Func<Task<ReturnActionResult>> recordSubmission)
    {
        if (working) return;
        working = true;
        try
        {
            await submissionClipboardEvidence!.PrepareAsync();
            actionResult = pendingSubmission ?? await recordSubmission();
            if (actionResult.Succeeded)
            {
                pendingSubmission = actionResult;
                await ArchiveSubmissionEvidenceAsync(actionResult);
                pendingSubmission = null;
            }
        }
        catch (Exception exception)
        {
            actionResult = new ReturnActionResult(false, pendingSubmission is null ? $"The submission could not be recorded: {exception.Message}" : $"The submission was recorded, but some documents remain unsaved: {exception.Message}", []);
        }
        finally
        {
            working = false;
        }

        await ReloadAsync();
    }

    private async Task ArchiveSubmissionEvidenceAsync(ReturnActionResult recorded)
    {
        if (recorded.EntityId is not Guid monthlyReturnId || submissionClipboardEvidence is null)
            throw new InvalidOperationException("The submission documents could not be linked to the saved return.");
        if (await submissionClipboardEvidence.ArchiveAsync("monthly-return", monthlyReturnId))
            actionResult = recorded with { Message = $"{recorded.Message} Submission evidence was retained." };
    }

    private void EditSubmissionRecord()
    {
        submissionReference = SelectedReturn?.SubmissionReference;
        submissionTimestampInput = SelectedReturn?.SubmittedAtUtc is { } submittedAt
            ? SubmissionTimestampParser.FormatUtc(submittedAt)
            : string.Empty;
        submissionEditClipboardImageCount = 0;
        ResetSubmissionEvidenceEdits();
        actionResult = null;
        editingSubmissionRecord = true;
    }

    private void CancelSubmissionEdit()
    {
        if (working) return;
        submissionReference = SelectedReturn?.SubmissionReference;
        submissionTimestampInput = SelectedReturn?.SubmittedAtUtc is { } submittedAt
            ? SubmissionTimestampParser.FormatUtc(submittedAt)
            : string.Empty;
        submissionEditClipboardImageCount = 0;
        submissionEvidenceEdits.Clear();
        editingSubmissionRecord = false;
    }

    private async Task SaveSubmissionRecordAsync()
    {
        if (!CanSaveSubmissionRecord || SelectedReturn?.ReturnId is not Guid monthlyReturnId || !TryGetSubmissionTimestamp(out var submittedAtUtc)) return;
        var evidenceEditsSaved = false;
        working = true;
        try
        {
            await submissionEditClipboardEvidence!.PrepareAsync();
            actionResult = HasSubmissionReferenceChanged || HasSubmissionTimestampChanged
                ? await Workspace.UpdateSubmissionDetailsAsync(framework, reportingMonth, submissionReference, submittedAtUtc)
                : new ReturnActionResult(true, "The submission record has been saved.", [], monthlyReturnId);
            if (actionResult.Succeeded && HasSubmissionEvidenceChanged)
            {
                var detailsChanged = HasSubmissionReferenceChanged || HasSubmissionTimestampChanged;
                var detailsMessage = actionResult.Message;
                var evidenceResult = await Workspace.UpdateSubmissionEvidenceAsync(
                    monthlyReturnId,
                    submissionEvidenceEdits
                        .Where(item => item.HasChanged)
                        .Select(item => new SubmissionEvidenceEdit(item.EvidenceId, item.Title, item.MarkedForDeletion))
                        .ToList());
                actionResult = evidenceResult.Succeeded && detailsChanged
                    ? evidenceResult with { Message = $"{detailsMessage} {evidenceResult.Message}" }
                    : evidenceResult;
                if (evidenceResult.Succeeded)
                {
                    // These edits are committed even if a later new-file upload fails.
                    // In particular, retry must not attempt to delete an already removed document.
                    evidenceEditsSaved = true;
                    submissionEvidenceEdits.Clear();
                }
            }
            if (actionResult.Succeeded)
            {
                await ArchiveSubmissionEditEvidenceAsync(actionResult);
            }

            if (actionResult.Succeeded)
            {
                submissionEvidenceEdits.Clear();
                editingSubmissionRecord = false;
            }
        }
        catch (Exception exception)
        {
            actionResult = new ReturnActionResult(false, $"The submission record could not be saved: {exception.Message}", []);
        }
        finally
        {
            working = false;
        }

        await ReloadAsync();
        if (evidenceEditsSaved && editingSubmissionRecord) ResetSubmissionEvidenceEdits();
    }

    private async Task ArchiveSubmissionEditEvidenceAsync(ReturnActionResult saved)
    {
        if (saved.EntityId is not Guid monthlyReturnId || submissionEditClipboardEvidence is null)
            throw new InvalidOperationException("The submission documents could not be linked to the saved return.");
        if (await submissionEditClipboardEvidence.ArchiveAsync("monthly-return", monthlyReturnId))
            actionResult = saved with { Message = $"{saved.Message} Submission evidence was retained." };
    }

    private async Task RequestCorrectionAsync()
    {
        working = true;
        actionResult = await Workspace.RequestCorrectionAsync(framework, reportingMonth, correctionReason ?? string.Empty);
        working = false;
        await ReloadAsync();
    }

    private async Task LoadReportingPeriodAsync()
    {
        if (!ReportingPeriodContext.IsValidPeriod(reportingMonth))
        {
            evidence = [];
            reportingFindings = [];
            submissionHistory = [];
            reportingCard = null;
            return;
        }

        var evidenceTask = Workspace.GetReportingEvidenceAsync(framework, reportingMonth);
        var cardTask = Workspace.GetReportingCardAsync(framework, reportingMonth);
        var findingsTask = Workspace.GetReportingFindingsAsync(framework, reportingMonth);
        var historyTask = Workspace.GetReturnSubmissionHistoryAsync(SelectedReturn?.ReturnId);
        await Task.WhenAll(evidenceTask, cardTask, findingsTask, historyTask);
        evidence = await evidenceTask;
        reportingCard = await cardTask;
        reportingFindings = await findingsTask;
        submissionHistory = await historyTask;
        submissionReference = SelectedReturn?.SubmissionReference;
        submissionTimestampInput = SelectedReturn?.SubmittedAtUtc is { } submittedAt
            ? SubmissionTimestampParser.FormatUtc(submittedAt)
            : string.Empty;
        if (activeWorkflowStage == 0) activeWorkflowStage = RecommendedWorkflowStage;
    }

    private IEnumerable<MonthlyReturnRegisterEntry> VisibleReturnEntries
    {
        get
        {
            var entries = (returnRegister?.Entries ?? [])
                .Where(item => registerView == "month" ? item.ReportingMonth == registerMonth : item.Framework.Code == registerFramework);

            return registerView == "month"
                ? entries.OrderBy(item => item.Framework.DisplayName, StringComparer.OrdinalIgnoreCase)
                : entries.OrderByDescending(item => item.ReportingMonth, StringComparer.OrdinalIgnoreCase);
        }
    }
    private IReadOnlyList<FrameworkDefinition> RegisterFrameworks => (returnRegister?.Entries ?? [])
        .Select(item => item.Framework)
        .DistinctBy(item => item.Code)
        .OrderBy(item => item.IsHistorical)
        .ThenBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private IReadOnlyList<string> RegisterFrameworkOptions => RegisterFrameworks.Select(item => item.Code.ToString()).ToList();
    private void SetRegisterMonth(string value) => registerMonth = value;
    private void SetRegisterFramework(string value)
    {
        if (Enum.TryParse<FrameworkCode>(value, out var selectedFramework)) registerFramework = selectedFramework;
    }
    private string RegisterFrameworkLabel(string value)
    {
        var definition = RegisterFrameworks.First(item => item.Code == Enum.Parse<FrameworkCode>(value));
        return $"{definition.DisplayName} ({definition.AgreementNumber})";
    }
    private string? RegisterFrameworkGroup(string value) =>
        RegisterFrameworks.First(item => item.Code == Enum.Parse<FrameworkCode>(value)).IsHistorical ? "Historical" : "Live";
    private void EnsureRegisterFrameworkSelection() { if (RegisterFrameworks.All(item => item.Code != registerFramework)) registerFramework = RegisterFrameworks.FirstOrDefault()?.Code ?? registerFramework; }
    private string WorkspaceRoute(MonthlyReturnRegisterEntry item) => $"/reports/{(int)item.Framework.Code}/{item.ReportingMonth}?period={item.ReportingMonth}";
    private int RecommendedWorkflowStage => IsSubmitted ? 4 : IsCorrectionRequired ? 2 : IsNilReturnDraft || HasEvidence ? 3 : 1;
    private bool IsWorkflowStageComplete(int stage) => IsSubmitted || (!IsCorrectionRequired && stage < RecommendedWorkflowStage);
    private string WorkflowTabClass(int stage) => activeWorkflowStage == stage
        ? "return-workflow-tab is-current"
        : IsWorkflowStageComplete(stage) ? "return-workflow-tab is-complete" : "return-workflow-tab";
    private string? WorkflowStageMark(int stage) => IsWorkflowStageComplete(stage) ? "✓" : null;
    private void SelectWorkflowStage(int stage) { if (!working && pendingSubmission is null) activeWorkflowStage = Math.Clamp(stage, 1, 4); }
    private static string LifecycleLabel(ReportLifecycleStatus status) => status switch { ReportLifecycleStatus.Submitted => "Submitted", ReportLifecycleStatus.CorrectionRequired => "Correction required", _ => "Draft" };
    private static string LifecycleClass(ReportLifecycleStatus status) => status switch { ReportLifecycleStatus.Submitted => "readiness-status complete", ReportLifecycleStatus.CorrectionRequired => "readiness-status warning", _ => "readiness-status neutral" };
    private static string SubmissionRegisterTiming(MonthlyReturnRegisterEntry item) => item.SubmittedAtUtc is { } submittedAt
        ? (item.LifecycleStatus == ReportLifecycleStatus.CorrectionRequired ? $"Previously submitted {submittedAt.LocalDateTime:dd MMM yyyy}" : submittedAt.LocalDateTime.ToString("dd MMM yyyy"))
        : item.InferredSubmissionDeadline is { } deadline ? $"Deadline {deadline:dd MMM yyyy}" : "Submission time not retained";
    private static string ShortReference(string submissionReference) => submissionReference.Length <= 12 ? submissionReference : $"{submissionReference[..8]}…";
    private static string DescribeActivity(int contractCount, int invoiceCount) => $"{contractCount} {Pluralize(contractCount, "contract", "contracts")} · {invoiceCount} {Pluralize(invoiceCount, "invoice", "invoices")}";
    private static string Pluralize(int value, string singular, string plural) => value == 1 ? singular : plural;
    private static string DisplayReportingMonth(string month) => DateOnly.ParseExact($"{month}-01", "yyyy-MM-dd").ToString("MMMM yyyy");
    private static string FrameworkAbbreviation(FrameworkCode framework) => framework switch
    {
        FrameworkCode.GCloud13 => "G13",
        FrameworkCode.GCloud14 => "G14",
        FrameworkCode.VerticalApplicationSolutions => "VAS",
        FrameworkCode.GCloud15 => "G15",
        _ => throw new ArgumentOutOfRangeException(nameof(framework), framework, null),
    };
    private static string Currency(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    private void SetSubmissionClipboardImageCount(int count) => submissionClipboardImageCount = count;
    private void SetSubmissionEditClipboardImageCount(int count) => submissionEditClipboardImageCount = count;
    private void ResetSubmissionEvidenceEdits()
    {
        submissionEvidenceEdits.Clear();
        submissionEvidenceEdits.AddRange(SubmissionEvidence.Select(item => new SubmissionEvidenceEditModel(item)));
    }
    private static void ToggleSubmissionEvidenceRemoval(SubmissionEvidenceEditModel document) =>
        document.MarkedForDeletion = !document.MarkedForDeletion;
    private static bool IsValidEvidenceTitle(string title)
    {
        var trimmed = title.Trim();
        return !string.IsNullOrWhiteSpace(trimmed) &&
            trimmed is not ("." or "..") &&
            trimmed.IndexOfAny(Path.GetInvalidFileNameChars()) < 0 &&
            !string.IsNullOrWhiteSpace(Path.GetFileNameWithoutExtension(trimmed));
    }
    private bool TryGetSubmissionTimestamp(out DateTimeOffset? submittedAtUtc)
    {
        submittedAtUtc = null;
        if (string.IsNullOrWhiteSpace(submissionTimestampInput)) return true;
        if (!SubmissionTimestampParser.TryParseUtc(submissionTimestampInput, out var parsed)) return false;
        submittedAtUtc = parsed;
        return true;
    }
    private static string? NormalizeSubmissionReference(string? submissionReference) => string.IsNullOrWhiteSpace(submissionReference) ? null : submissionReference.Trim();
    private static string? GcaTaskUrl(string? submissionReference) => Guid.TryParse(submissionReference?.Trim(), out var taskId)
        ? $"https://www.reportmi.gca.gov.uk/tasks/{taskId:D}"
        : null;
    private static string SubmissionHistoryDescription(ReturnSubmissionHistoryItem item) =>
        $"{(item.IsNilReturn ? "Nil return" : "Submitted return")} recorded {item.OccurredAtUtc.LocalDateTime:dd MMM yyyy, HH:mm}{(string.IsNullOrWhiteSpace(item.SubmissionReference) ? string.Empty : $" · GCA ref {item.SubmissionReference}")}";

    private sealed class SubmissionEvidenceEditModel(ReportingEvidence evidence)
    {
        private readonly string originalTitle = Path.GetFileNameWithoutExtension(evidence.FileName);
        public Guid EvidenceId { get; } = evidence.Id;
        public string FileName { get; } = evidence.FileName;
        public string Title { get; set; } = Path.GetFileNameWithoutExtension(evidence.FileName);
        public bool MarkedForDeletion { get; set; }
        public bool HasChanged => MarkedForDeletion || !string.Equals(Title.Trim(), originalTitle, StringComparison.Ordinal);
    }

    private sealed record WorkflowStageDefinition(int Number, string Label);
}
