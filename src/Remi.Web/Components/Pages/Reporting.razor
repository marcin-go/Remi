@page "/reports"
@page "/reports/{FrameworkValue:int}/{WorkspaceMonth}"
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@implements IDisposable

<PageTitle>Remi · Reports</PageTitle>

@if (IsWorkspace)
{
    <header class="return-workspace-header">
        <div class="return-workspace-title">
            <div>
                <h1>@Frameworks.Get(framework).DisplayName</h1>
                <p class="lede">@DisplayReportingMonth(reportingMonth) return</p>
            </div>
            <div class="return-workspace-actions">
                <details class="return-contextual-help"><summary>? Help</summary><p>Remi retains generated workbooks and submission evidence. Review the return before recording the GCA submission.</p><a href="@($"/settings?period={reportingMonth}&section=templates")">Manage approved templates</a></details>
                <a class="remi-action remi-action--compact" href="@QueueRoute">Back to reports</a>
            </div>
        </div>
    </header>

    <section class="gca-return-summary gca-return-summary--workspace" aria-labelledby="gca-return-summary-heading">
        <div class="gca-return-summary-heading">
            <h2 id="gca-return-summary-heading">@Frameworks.Get(framework).AgreementNumber reporting summary</h2>
        </div>
        <div class="gca-summary-content">
            <div class="table-wrap"><table>
                <thead><tr><th>Report section</th><th>Rows</th><th>Total (ex VAT)</th></tr></thead>
                <tbody>
                    <tr><th class="gca-summary-section" scope="row">Invoices</th><td>@(SelectedReturn?.InvoiceCount ?? 0)</td><td>@Currency(SelectedReturn?.InvoiceTotalExVat ?? 0)</td></tr>
                    <tr><th class="gca-summary-section" scope="row">Contracts</th><td>@(SelectedReturn?.ContractCount ?? 0)</td><td>@Currency(SelectedReturn?.ContractTotalExVat ?? 0)</td></tr>
                    <tr><th class="gca-summary-section" scope="row">Others</th><td>0</td><td>@Currency(0)</td></tr>
                </tbody>
            </table></div>
            @if (PurchaseOrderNumber is not null)
            {
                <p class="gca-purchase-order"><span>Purchase order</span><strong>@PurchaseOrderNumber</strong></p>
            }
        </div>
    </section>

    <section class="return-workflow" aria-labelledby="return-workflow-heading">
        <div class="return-workflow-heading">
            <div>
                <p class="eyebrow">Monthly return</p>
                <h2 id="return-workflow-heading">@LifecycleHeading</h2>
                @if (IsNilReturn) { <p class="nil-return-context">Nil return</p> }
                @if (IsCorrectionRequired) { <p class="muted">A correction has been requested. The earlier submission remains in the record below.</p> }
            </div>
            <span class="@LifecycleBadgeClass">@LifecycleHeading</span>
        </div>
        <ol class="return-workflow-steps" aria-label="Monthly return progress">
            <li class="@WorkflowStepClass(1)"><span>@WorkflowStepMark(1)</span><strong>Review data</strong></li>
            <li class="@WorkflowStepClass(2)"><span>@WorkflowStepMark(2)</span><strong>Generate workbook</strong></li>
            <li class="@WorkflowStepClass(3)"><span>@WorkflowStepMark(3)</span><strong>Upload to GCA portal</strong></li>
            <li class="@WorkflowStepClass(4)"><span>@WorkflowStepMark(4)</span><strong>Record submission</strong></li>
        </ol>
        @if (CanGenerateReturn)
        {
            <section class="return-current-action" aria-labelledby="return-action-heading">
                <div><h3 id="return-action-heading">@(IsCorrectionRequired ? "Generate corrected workbook" : "Generate workbook")</h3><p class="muted">This creates and retains a review copy using the active approved template.</p></div>
                <button class="remi-action remi-action--primary" disabled="@working" @onclick="GenerateReturnAsync">Generate workbook</button>
            </section>
        }
        else if (CanRecordPortalSubmission)
        {
            <ClipboardImageEvidence @ref="submissionClipboardEvidence"
                                    LayoutClass="return-submission-evidence-layout"
                                    OnDocumentsChanged="SetSubmissionClipboardImageCount"
                                    Heading="Submission evidence"
                                    EmptyStatus="Add a confirmation screenshot"
                                    DropZoneTitle="Drop screenshot or file"
                                    EmptyMessage="Paste the GCA submission-details screenshot here, or add it from disk. Remi will retain it when you record this submission.">
                <section class="return-current-action return-submission-capture" id="submission-record" aria-labelledby="return-action-heading">
                    <div><h3 id="return-action-heading">@SubmissionActionHeading</h3><p class="muted">@SubmissionActionGuidance</p></div>
                    <div class="return-submission-capture-actions">
                        <label class="submission-reference">GCA task reference <span class="optional">(optional)</span><input @bind="submissionReference" @bind:event="oninput" placeholder="e0303f95-3441-4d48-bd32-e028a66f87db" /></label>
                        <button class="remi-action remi-action--primary" disabled="@working" @onclick="RecordCurrentSubmissionAsync">@(IsNilReturnDraft ? "Record nil submission" : IsCorrectionRequired ? "Record corrected submission" : "Record submission")</button>
                    </div>
                </section>
            </ClipboardImageEvidence>
        }
        else if (HasSubmissionRecord)
        {
            <section class="return-submission-record" aria-labelledby="submission-record-heading">
                <div class="return-submission-record-heading"><div><h3 id="submission-record-heading">Submission record</h3><p class="muted">@SubmissionTiming</p></div>@if (IsNilReturn) { <span class="nil-return-badge">Nil return</span> }</div>
                @if (!string.IsNullOrWhiteSpace(SelectedReturn?.SubmissionReference))
                {
                    <p class="submission-reference-display">GCA task reference <code>@SelectedReturn!.SubmissionReference</code></p>
                    @if (GcaSubmissionTaskUrl is { } gcaSubmissionTaskUrl) { <a class="remi-action remi-action--section" href="@gcaSubmissionTaskUrl" target="_blank" rel="noreferrer">Open GCA submission <span aria-hidden="true">↗</span></a> }
                }
                else { <p class="muted">No GCA task reference was retained.</p> }
                @if (SubmissionEvidence.Count == 0) { <p class="muted">No submission screenshot has been retained.</p> }
                else { <div class="evidence-list">@foreach (var item in SubmissionEvidence) { <a class="evidence-item" href="@($"/evidence/{item.Id}")" target="_blank"><span><strong>@item.FileName</strong><span class="cell-secondary">Saved <time datetime="@item.ArchivedAtUtc.ToString("O")">@item.ArchivedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</time></span></span></a> }</div> }
                @if (submissionHistory.Count > 1) { <details class="submission-history"><summary>Previous submission history (@(submissionHistory.Count - 1))</summary><ul>@foreach (var item in submissionHistory.Skip(1)) { <li>@SubmissionHistoryDescription(item)</li> }</ul></details> }
                @if (!showMissingSubmissionEvidence)
                {
                    <button class="remi-action remi-action--section remi-action--quiet" @onclick="ShowMissingSubmissionEvidence">Add missing submission evidence</button>
                }
                else
                {
                    <ClipboardImageEvidence @ref="recordedSubmissionClipboardEvidence"
                                            LayoutClass="return-submission-evidence-layout return-submission-evidence-layout--recovery"
                                            OnDocumentsChanged="SetRecordedSubmissionClipboardImageCount"
                                            Heading="Missing submission evidence"
                                            EmptyStatus="Paste a confirmation screenshot"
                                            DropZoneTitle="Drop screenshot or file"
                                            EmptyMessage="Use this only to add a missing GCA reference or confirmation screenshot. It does not reopen the return.">
                        <div class="submission-evidence-recovery"><label class="submission-reference">GCA task reference <input @bind="submissionReference" @bind:event="oninput" placeholder="e0303f95-3441-4d48-bd32-e028a66f87db" /></label><button class="remi-action remi-action--section" disabled="@(!CanSaveMissingSubmissionEvidence)" @onclick="SaveMissingSubmissionEvidenceAsync">@(working ? "Saving…" : "Save missing evidence")</button></div>
                    </ClipboardImageEvidence>
                }
            </section>
        }
        @if (actionResult is not null) { <p class="notice @(actionResult.Succeeded ? "success" : "error")" role="status">@actionResult.Message</p> }
    </section>

    <section class="return-disclosures" aria-label="Return detail">
        <details class="return-disclosure">
            <summary><span><strong>Data review</strong><small>@ActivitySummary</small></span></summary>
            @if (IsNilReturn)
            {
                <p class="muted">Nil return. No contracts, invoices or other reportable items were present for this reporting period.</p>
            }
            else if (!HasActivity)
            {
                <p class="muted">No reportable contracts or invoices have been recorded for this framework and month.</p>
            }
            else if (!HasReviewData)
            {
                <p class="muted">This return has reportable activity, but its review rows are not available yet. Open the Contracts or Invoices register to review the recorded data.</p>
            }
            else
            {
                @if (reportingCard?.Contracts.Count > 0)
                {
                    <h3>Contracts</h3>
                    @foreach (var item in reportingCard.Contracts)
                    {
                        <details class="reporting-card-row"><summary>@item.Title</summary><dl>@foreach (var field in item.Fields) { <div><dt>@field.Label</dt><dd>@field.Value</dd></div> }</dl></details>
                    }
                }
                @if (reportingCard?.Invoices.Count > 0)
                {
                    <h3>Invoices</h3>
                    @foreach (var item in reportingCard.Invoices)
                    {
                        <details class="reporting-card-row"><summary>@item.Title</summary><dl>@foreach (var field in item.Fields) { <div><dt>@field.Label</dt><dd>@field.Value</dd></div> }</dl></details>
                    }
                }
            }
        </details>

        <details class="return-disclosure @(HasReportingIssues ? "return-disclosure--issues" : null)">
            <summary><span><strong>Checks</strong><small>@ChecksSummary</small></span></summary>
            @if (reportingFindings.Count != 0)
            {
                <ul class="findings inline-findings">@foreach (var finding in reportingFindings) { <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li> }</ul>
            }
            else
            {
                <p class="muted">No reporting issues found.</p>
            }
        </details>

        <details class="return-disclosure">
            <summary><span><strong>Generated files</strong><small>@GeneratedFilesSummary</small></span></summary>
            @if (GeneratedFiles.Count == 0)
            {
                <p class="muted">No workbook has been generated for this return.</p>
            }
            else
            {
                <div class="evidence-list">@foreach (var item in GeneratedFiles) { <a class="evidence-item" href="@($"/evidence/{item.Id}")" target="_blank"><span><strong>@item.FileName</strong><span class="cell-secondary">Created <time datetime="@item.ArchivedAtUtc.ToString("O")">@item.ArchivedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</time></span></span></a> }</div>
                @if (CanRegenerateReturn)
                {
                    <div class="return-regenerate-action">
                        <p class="muted">Regenerate only after changing the registered data or approved template. The previous unsubmitted generated workbook is superseded in the evidence archive.</p>
                        <button class="remi-action remi-action--section" disabled="@working" @onclick="GenerateReturnAsync">Regenerate workbook</button>
                    </div>
                }
            }
        </details>

        @if (IsSubmitted)
        {
            <details class="return-disclosure return-disclosure--secondary">
                <summary><span><strong>Correction</strong><small>Use only when the submitted return needs amendment</small></span></summary>
                <label class="correction-reason">Correction reason <input @bind="correctionReason" @bind:event="oninput" placeholder="What needs correcting and why?" /></label>
                <button class="remi-action remi-action--section" disabled="@(!CanRequestCorrection || working)" @onclick="RequestCorrectionAsync">Request correction</button>
            </details>
        }

    </section>
}
else
{
    <header class="dashboard-header">
        <div>
            <h1>Monthly returns</h1>
            <p class="lede">Browse the historical register or open a framework return for its reporting workflow.</p>
        </div>
    </header>

    <section class="panel return-register-panel">
        <div class="panel-heading return-register-heading"><div><h2>Browse reports</h2></div></div>
        <div class="return-register-controls">
            <div class="return-register-views" role="tablist" aria-label="Reports view">
                <button class="button secondary @(registerView == "month" ? "active" : null)" role="tab" aria-selected="@(registerView == "month" ? "true" : "false")" @onclick="@(() => registerView = "month")">By reporting month</button>
                <button class="button secondary @(registerView == "framework" ? "active" : null)" role="tab" aria-selected="@(registerView == "framework" ? "true" : "false")" @onclick="@(() => registerView = "framework")">By framework</button>
            </div>
            @if (registerView == "month")
            {
                <label class="return-register-filter">Reporting month<select @bind="registerMonth">@foreach (var month in returnRegister?.ReportingMonths ?? []) { <option value="@month">@DisplayReportingMonth(month)</option> }</select></label>
            }
            else
            {
                <label class="return-register-filter">Framework<select @bind="registerFramework">@foreach (var definition in RegisterFrameworks) { <option value="@definition.Code">@definition.DisplayName (@definition.AgreementNumber)</option> }</select></label>
            }
        </div>
        @if (returnRegister is null)
        {
            <p class="muted">Loading the return register...</p>
        }
        else
        {
            <div class="table-wrap return-register-table"><table><thead><tr>
                @if (registerView == "month") { <th>Framework</th> } else { <th>Reporting month</th> }
                <th>Status</th><th>Contracts</th><th>Invoices</th><th>Submission</th><th class="table-action-cell"><span class="visually-hidden">Open</span></th>
            </tr></thead><tbody>
            @foreach (var item in VisibleReturnEntries)
            {
                <tr>
                    @if (registerView == "month") { <td><strong>@item.Framework.DisplayName</strong><span class="cell-secondary">@item.Framework.AgreementNumber</span></td> } else { <td><strong>@DisplayReportingMonth(item.ReportingMonth)</strong></td> }
                    <td><span class="@LifecycleClass(item.LifecycleStatus)">@LifecycleLabel(item.LifecycleStatus)</span></td>
                    <td class="return-register-measure"><strong>@item.ContractCount</strong><span class="cell-secondary">@Currency(item.ContractTotalExVat)</span></td>
                    <td class="return-register-measure"><strong>@item.InvoiceCount</strong><span class="cell-secondary">@Currency(item.InvoiceTotalExVat)</span></td>
                    <td class="return-register-submission">
                        @if (item.LifecycleStatus == ReportLifecycleStatus.Draft)
                        {
                            <span>Not submitted</span>
                        }
                        else
                        {
                            @if (item.IsNilReturn) { <span class="nil-return-badge">Nil return</span> }
                            <span>@SubmissionRegisterTiming(item)</span>
                            @if (!string.IsNullOrWhiteSpace(item.SubmissionReference)) { <span class="cell-secondary">GCA ref @ShortReference(item.SubmissionReference)</span> }
                        }
                    </td>
                    <td class="table-action-cell"><a class="remi-action remi-action--table" href="@WorkspaceRoute(item)">Open <span aria-hidden="true">→</span></a></td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}

@code {
    [Parameter] public int? FrameworkValue { get; set; }
    [Parameter] public string? WorkspaceMonth { get; set; }

    private MonthlyReturnRegisterModel? returnRegister;
    private FrameworkCode framework = FrameworkCode.GCloud14;
    private FrameworkCode registerFramework = FrameworkCode.GCloud14;
    private string reportingMonth = string.Empty;
    private string registerMonth = string.Empty;
    private string registerView = "month";
    private string? submissionReference;
    private string? correctionReason;
    private ReturnActionResult? actionResult;
    private IReadOnlyList<ReportingEvidence> evidence = [];
    private IReadOnlyList<ValidationFinding> reportingFindings = [];
    private IReadOnlyList<ReturnSubmissionHistoryItem> submissionHistory = [];
    private ReportingCardModel? reportingCard;
    private ClipboardImageEvidence? submissionClipboardEvidence;
    private ClipboardImageEvidence? recordedSubmissionClipboardEvidence;
    private int submissionClipboardImageCount;
    private int recordedSubmissionClipboardImageCount;
    private bool showMissingSubmissionEvidence;
    private bool working;

    private bool IsWorkspace => FrameworkValue is not null && !string.IsNullOrWhiteSpace(WorkspaceMonth);
    private MonthlyReturnRegisterEntry? SelectedReturn => returnRegister?.Entries.SingleOrDefault(item => item.Framework.Code == framework && item.ReportingMonth == reportingMonth);
    private ReportLifecycleStatus LifecycleStatus => SelectedReturn?.LifecycleStatus ?? ReportLifecycleStatus.Draft;
    private bool IsSubmitted => LifecycleStatus == ReportLifecycleStatus.Submitted;
    private bool IsCorrectionRequired => LifecycleStatus == ReportLifecycleStatus.CorrectionRequired;
    private bool IsNilReturn => SelectedReturn?.IsNilReturn ?? false;
    private bool IsNilReturnDraft => !HasActivity && LifecycleStatus == ReportLifecycleStatus.Draft;
    private bool HasSubmissionRecord => IsSubmitted || IsCorrectionRequired;
    private IReadOnlyList<ReportingEvidence> GeneratedFiles => evidence.Where(item => item.Kind == EvidenceKind.GeneratedMiWorkbook).OrderByDescending(item => item.ArchivedAtUtc).ToList();
    private IReadOnlyList<ReportingEvidence> SubmissionEvidence => evidence.Where(item => item.Kind == EvidenceKind.SubmissionEvidence).OrderByDescending(item => item.ArchivedAtUtc).ToList();
    private string QueueRoute => ReportingRoutes.WithPeriod("/reports", reportingMonth);
    private string LifecycleHeading => LifecycleLabel(LifecycleStatus);
    private string LifecycleBadgeClass => LifecycleClass(LifecycleStatus);
    private bool HasActivity => (SelectedReturn?.ContractCount ?? 0) + (SelectedReturn?.InvoiceCount ?? 0) > 0;
    private bool HasReviewData => reportingCard is not null && (reportingCard.Contracts.Count != 0 || reportingCard.Invoices.Count != 0);
    private string? PurchaseOrderNumber => (SelectedReturn?.InvoiceCount ?? 0) > 0
        ? $"GCA_{FrameworkAbbreviation(framework)}_{reportingMonth.Replace("-", string.Empty, StringComparison.Ordinal)}"
        : null;
    private bool HasEvidence => GeneratedFiles.Count != 0;
    private bool CanMarkSubmitted => HasActivity && HasEvidence && LifecycleStatus is ReportLifecycleStatus.Draft or ReportLifecycleStatus.CorrectionRequired;
    private bool CanGenerateReturn => HasActivity && !HasEvidence && LifecycleStatus is ReportLifecycleStatus.Draft or ReportLifecycleStatus.CorrectionRequired;
    private bool CanRegenerateReturn => HasActivity && HasEvidence && LifecycleStatus is ReportLifecycleStatus.Draft or ReportLifecycleStatus.CorrectionRequired;
    private bool CanMarkNilReturn => !HasActivity && LifecycleStatus == ReportLifecycleStatus.Draft;
    private bool CanRecordPortalSubmission => CanMarkSubmitted || CanMarkNilReturn;
    private bool CanRequestCorrection => IsSubmitted && !string.IsNullOrWhiteSpace(correctionReason);
    private bool HasReportingIssues => reportingFindings.Count != 0;
    private bool HasSubmissionReferenceChanged => !string.Equals(NormalizeSubmissionReference(submissionReference), NormalizeSubmissionReference(SelectedReturn?.SubmissionReference), StringComparison.Ordinal);
    private bool CanSaveMissingSubmissionEvidence => !working && SelectedReturn?.ReturnId is Guid && (HasSubmissionReferenceChanged || recordedSubmissionClipboardImageCount != 0);
    private string ActivitySummary => DescribeActivity(SelectedReturn?.ContractCount ?? 0, SelectedReturn?.InvoiceCount ?? 0);
    private string ChecksSummary => reportingFindings.Count == 0 ? "✓ No reporting issues found" : $"{reportingFindings.Count} {Pluralize(reportingFindings.Count, "issue", "issues")} require attention";
    private string GeneratedFilesSummary => GeneratedFiles.Count switch { 0 => "No workbook", 1 => GeneratedFiles[0].FileName, _ => $"{GeneratedFiles.Count} retained files" };
    private string? GcaSubmissionTaskUrl => GcaTaskUrl(SelectedReturn?.SubmissionReference);
    private string SubmissionActionHeading => IsNilReturnDraft ? "Record nil submission" : IsCorrectionRequired ? "Record corrected submission" : "Record submission";
    private string SubmissionActionGuidance => IsNilReturnDraft
        ? "After reporting no business in GCA, record its task reference and confirmation screenshot here."
        : IsCorrectionRequired
            ? "Review the correction, upload the revised workbook in GCA, then record the replacement submission."
            : "Upload the retained workbook in GCA, then record its task reference and confirmation screenshot here.";
    private string SubmissionTiming => SelectedReturn?.SubmittedAtUtc is { } submittedAt
        ? $"Submitted {submittedAt.LocalDateTime:dd MMMM yyyy 'at' HH:mm}"
        : SelectedReturn?.InferredSubmissionDeadline is { } deadline
            ? $"Submission timestamp was not retained. Inferred deadline: {deadline:dd MMMM yyyy} ({Frameworks.Get(framework).ReportingDeadline?.Description})."
            : "Submission timestamp was not retained.";

    protected override void OnInitialized() => ReportingPeriod.Changed += ReportingPeriodChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (IsWorkspace && FrameworkValue is int routeFramework && Enum.IsDefined(typeof(FrameworkCode), routeFramework) && ReportingPeriodContext.IsValidPeriod(WorkspaceMonth))
        {
            framework = (FrameworkCode)routeFramework;
            reportingMonth = WorkspaceMonth!;
            registerFramework = framework;
        }
        else
        {
            reportingMonth = ReportingPeriod.SelectedPeriod;
        }
        registerMonth = reportingMonth;
        await ReloadAsync();
    }

    public void Dispose() => ReportingPeriod.Changed -= ReportingPeriodChanged;

    private async void ReportingPeriodChanged()
    {
        await InvokeAsync(async () =>
        {
            if (!IsWorkspace) { reportingMonth = ReportingPeriod.SelectedPeriod; registerMonth = reportingMonth; }
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        returnRegister = await Workspace.GetMonthlyReturnRegisterAsync();
        EnsureRegisterFrameworkSelection();
        if (IsWorkspace) await LoadReportingPeriodAsync();
    }

    private async Task GenerateReturnAsync()
    {
        working = true;
        try
        {
            var exported = await Workspace.ExportReturnAsync(framework, reportingMonth);
            actionResult = exported is null ? new ReturnActionResult(false, "Register an active approved template before generating this return.", []) : new ReturnActionResult(true, $"Generated {exported.FileName}. It is retained in the evidence archive.", exported.Findings);
        }
        catch (Exception exception) { actionResult = new ReturnActionResult(false, $"The MI workbook could not be generated: {exception.Message}", []); }
        finally { working = false; }
        await ReloadAsync();
    }

    private Task RecordCurrentSubmissionAsync() => IsNilReturnDraft
        ? RecordSubmissionAsync(() => Workspace.MarkNilReturnAsync(framework, reportingMonth, submissionReference))
        : RecordSubmissionAsync(() => Workspace.MarkSubmittedAsync(framework, reportingMonth, submissionReference));

    private async Task RecordSubmissionAsync(Func<Task<ReturnActionResult>> recordSubmission)
    {
        if (working) return;
        working = true;
        try
        {
            actionResult = await recordSubmission();
            if (actionResult.Succeeded) await ArchiveSubmissionEvidenceAsync(actionResult);
        }
        catch (Exception exception)
        {
            actionResult = new ReturnActionResult(false, $"The submission could not be recorded: {exception.Message}", []);
        }
        finally
        {
            working = false;
        }

        await ReloadAsync();
    }

    private async Task ArchiveSubmissionEvidenceAsync(ReturnActionResult recorded)
    {
        if (submissionClipboardImageCount == 0) return;
        if (recorded.EntityId is not Guid monthlyReturnId || submissionClipboardEvidence is null)
        {
            actionResult = recorded with { Message = $"{recorded.Message} The submission screenshot could not be linked, so please keep it and try again." };
            return;
        }

        try
        {
            var archived = await submissionClipboardEvidence.ArchiveAsync("monthly-return", monthlyReturnId);
            if (archived)
            {
                submissionClipboardImageCount = 0;
                actionResult = recorded with { Message = $"{recorded.Message} Submission evidence was retained." };
            }
            else
            {
                actionResult = recorded with { Message = $"{recorded.Message} The submission screenshot could not be archived, so please keep it and try again." };
            }
        }
        catch (Exception)
        {
            actionResult = recorded with { Message = $"{recorded.Message} The submission screenshot could not be archived, so please keep it and try again." };
        }
    }

    private void ShowMissingSubmissionEvidence()
    {
        submissionReference = SelectedReturn?.SubmissionReference;
        showMissingSubmissionEvidence = true;
    }

    private async Task SaveMissingSubmissionEvidenceAsync()
    {
        if (!CanSaveMissingSubmissionEvidence || SelectedReturn?.ReturnId is not Guid monthlyReturnId) return;
        working = true;
        try
        {
            actionResult = HasSubmissionReferenceChanged
                ? await Workspace.UpdateSubmissionReferenceAsync(framework, reportingMonth, submissionReference)
                : new ReturnActionResult(true, "The submission details have been saved.", [], monthlyReturnId);
            if (actionResult.Succeeded && recordedSubmissionClipboardImageCount != 0)
            {
                await ArchiveMissingSubmissionEvidenceAsync(actionResult);
            }

            if (actionResult.Succeeded && recordedSubmissionClipboardImageCount == 0)
            {
                showMissingSubmissionEvidence = false;
            }
        }
        catch (Exception exception)
        {
            actionResult = new ReturnActionResult(false, $"The missing submission evidence could not be saved: {exception.Message}", []);
        }
        finally
        {
            working = false;
        }

        await ReloadAsync();
    }

    private async Task ArchiveMissingSubmissionEvidenceAsync(ReturnActionResult saved)
    {
        if (saved.EntityId is not Guid monthlyReturnId || recordedSubmissionClipboardEvidence is null) return;
        try
        {
            var archived = await recordedSubmissionClipboardEvidence.ArchiveAsync("monthly-return", monthlyReturnId);
            if (archived)
            {
                recordedSubmissionClipboardImageCount = 0;
                actionResult = saved with { Message = $"{saved.Message} Submission evidence was retained." };
            }
            else
            {
                actionResult = saved with { Message = $"{saved.Message} The submission screenshot could not be archived, so please keep it and try again." };
            }
        }
        catch (Exception)
        {
            actionResult = saved with { Message = $"{saved.Message} The submission screenshot could not be archived, so please keep it and try again." };
        }
    }

    private async Task RequestCorrectionAsync()
    {
        working = true;
        actionResult = await Workspace.RequestCorrectionAsync(framework, reportingMonth, correctionReason ?? string.Empty);
        working = false;
        await ReloadAsync();
    }

    private async Task LoadReportingPeriodAsync()
    {
        if (!ReportingPeriodContext.IsValidPeriod(reportingMonth))
        {
            evidence = [];
            reportingFindings = [];
            submissionHistory = [];
            reportingCard = null;
            return;
        }

        var evidenceTask = Workspace.GetReportingEvidenceAsync(framework, reportingMonth);
        var cardTask = Workspace.GetReportingCardAsync(framework, reportingMonth);
        var findingsTask = Workspace.GetReportingFindingsAsync(framework, reportingMonth);
        var historyTask = Workspace.GetReturnSubmissionHistoryAsync(SelectedReturn?.ReturnId);
        await Task.WhenAll(evidenceTask, cardTask, findingsTask, historyTask);
        evidence = await evidenceTask;
        reportingCard = await cardTask;
        reportingFindings = await findingsTask;
        submissionHistory = await historyTask;
        submissionReference = SelectedReturn?.SubmissionReference;
    }

    private IEnumerable<MonthlyReturnRegisterEntry> VisibleReturnEntries => (returnRegister?.Entries ?? [])
        .Where(item => registerView == "month" ? item.ReportingMonth == registerMonth : item.Framework.Code == registerFramework)
        .OrderBy(item => registerView == "month" ? item.Framework.DisplayName : item.ReportingMonth, StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<FrameworkDefinition> RegisterFrameworks => (returnRegister?.Entries ?? []).Select(item => item.Framework).DistinctBy(item => item.Code).OrderBy(item => item.DisplayName, StringComparer.Ordinal).ToList();
    private void EnsureRegisterFrameworkSelection() { if (RegisterFrameworks.All(item => item.Code != registerFramework)) registerFramework = RegisterFrameworks.FirstOrDefault()?.Code ?? registerFramework; }
    private string WorkspaceRoute(MonthlyReturnRegisterEntry item) => $"/reports/{(int)item.Framework.Code}/{item.ReportingMonth}?period={item.ReportingMonth}";
    private int CurrentWorkflowStep => IsSubmitted ? 5 : IsCorrectionRequired ? 4 : CanGenerateReturn ? 2 : CanRecordPortalSubmission ? 4 : 1;
    private string WorkflowStepClass(int step) => step < CurrentWorkflowStep ? "complete" : step == CurrentWorkflowStep ? "current" : string.Empty;
    private string WorkflowStepMark(int step) => WorkflowStepClass(step) == "complete" ? "✓" : step.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static string LifecycleLabel(ReportLifecycleStatus status) => status switch { ReportLifecycleStatus.Submitted => "Submitted", ReportLifecycleStatus.CorrectionRequired => "Correction required", _ => "Draft" };
    private static string LifecycleClass(ReportLifecycleStatus status) => status switch { ReportLifecycleStatus.Submitted => "readiness-status complete", ReportLifecycleStatus.CorrectionRequired => "readiness-status warning", _ => "readiness-status neutral" };
    private static string SubmissionRegisterTiming(MonthlyReturnRegisterEntry item) => item.SubmittedAtUtc is { } submittedAt
        ? (item.LifecycleStatus == ReportLifecycleStatus.CorrectionRequired ? $"Previously submitted {submittedAt.LocalDateTime:dd MMM yyyy}" : submittedAt.LocalDateTime.ToString("dd MMM yyyy"))
        : item.InferredSubmissionDeadline is { } deadline ? $"Deadline {deadline:dd MMM yyyy}" : "Submission time not retained";
    private static string ShortReference(string submissionReference) => submissionReference.Length <= 12 ? submissionReference : $"{submissionReference[..8]}…";
    private static string DescribeActivity(int contractCount, int invoiceCount) => $"{contractCount} {Pluralize(contractCount, "contract", "contracts")} · {invoiceCount} {Pluralize(invoiceCount, "invoice", "invoices")}";
    private static string Pluralize(int value, string singular, string plural) => value == 1 ? singular : plural;
    private static string DisplayReportingMonth(string month) => DateOnly.ParseExact($"{month}-01", "yyyy-MM-dd").ToString("MMMM yyyy");
    private static string FrameworkAbbreviation(FrameworkCode framework) => framework switch
    {
        FrameworkCode.GCloud13 => "G13",
        FrameworkCode.GCloud14 => "G14",
        FrameworkCode.VerticalApplicationSolutions => "VAS",
        FrameworkCode.GCloud15 => "G15",
        _ => throw new ArgumentOutOfRangeException(nameof(framework), framework, null),
    };
    private static string Currency(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    private void SetSubmissionClipboardImageCount(int count) => submissionClipboardImageCount = count;
    private void SetRecordedSubmissionClipboardImageCount(int count) => recordedSubmissionClipboardImageCount = count;
    private static string? NormalizeSubmissionReference(string? submissionReference) => string.IsNullOrWhiteSpace(submissionReference) ? null : submissionReference.Trim();
    private static string? GcaTaskUrl(string? submissionReference) => Guid.TryParse(submissionReference?.Trim(), out var taskId)
        ? $"https://www.reportmi.gca.gov.uk/tasks/{taskId:D}"
        : null;
    private static string SubmissionHistoryDescription(ReturnSubmissionHistoryItem item) =>
        $"{(item.IsNilReturn ? "Nil return" : "Submitted return")} recorded {item.OccurredAtUtc.LocalDateTime:dd MMM yyyy, HH:mm}{(string.IsNullOrWhiteSpace(item.SubmissionReference) ? string.Empty : $" · GCA ref {item.SubmissionReference}")}";
}
