@page "/contracts/{ContractId:guid}"
@inject ReportingWorkspace Workspace

<PageTitle>Remi · Contract</PageTitle>

<ContractRecordView ContractId="@ContractId" />

@if (UseLegacyContractRecord)
{

<PageTitle>Remi · Contract</PageTitle>

@if (details is null)
{
    <section class="empty-state"><p>The requested contract was not found.</p><a class="button secondary" href="/contracts">Back to contracts</a></section>
}
else
{
    <section class="page-heading record-heading">
        <div>
            <p class="eyebrow">Contract record</p>
            <h1>@details.Contract.SupplierReference</h1>
            <p class="lede">@details.Contract.CustomerName · @Frameworks.Get(details.Contract.Framework).DisplayName</p>
        </div>
        <div class="record-actions"><a class="button primary" href="#register-invoice">Register invoice</a><a class="button secondary" href="/contracts">Back to contracts</a></div>
    </section>

    @if (details.Findings.Count != 0)
    {
        <section class="panel detail-panel">
            <p class="eyebrow">Needs attention</p>
            <ul class="findings inline-findings">
                @foreach (var finding in details.Findings)
                {
                    <li class="@finding.Severity.ToString().ToLowerInvariant()"><strong>@finding.Code</strong><span>@finding.Message</span></li>
                }
            </ul>
        </section>
    }

    <section class="panel detail-panel">
        <p class="eyebrow">Registered information</p>
        <h2>Contract details</h2>
        <dl class="record-grid">
            <div><dt>Framework</dt><dd>@Frameworks.Get(details.Contract.Framework).DisplayName</dd></div>
            <div><dt>Reporting month</dt><dd>@details.Contract.ReportMonth</dd></div>
            <div><dt>Supplier reference</dt><dd>@details.Contract.SupplierReference</dd></div>
            <div><dt>Customer</dt><dd>@details.Contract.CustomerName</dd></div>
            <div><dt>Customer URN</dt><dd>@Display(details.Contract.CustomerUrn)</dd></div>
            <div><dt>Lot</dt><dd>@Display(details.Contract.LotNumber)</dd></div>
            <div><dt>Start date</dt><dd>@Display(details.Contract.StartDate)</dd></div>
            <div><dt>End date</dt><dd>@Display(details.Contract.EndDate)</dd></div>
            <div><dt>Service group / level 1</dt><dd>@Display(details.Contract.ServiceGroup)</dd></div>
            <div><dt>Service group / level 2</dt><dd>@Display(details.Contract.ServiceGroupLevel2)</dd></div>
            <div><dt>Service description</dt><dd>@Display(details.Contract.ServiceDescription)</dd></div>
            <div><dt>Order channel</dt><dd>@Display(details.Contract.OrderChannel)</dd></div>
            <div><dt>Digital Marketplace service ID</dt><dd>@Display(details.Contract.DigitalMarketplaceServiceId)</dd></div>
            <div><dt>Total value, ex VAT</dt><dd>@Currency(details.Contract.TotalContractValueExVat)</dd></div>
            <div><dt>Register source</dt><dd>@details.Contract.SourceWorkbook</dd></div>
            <div><dt>Recorded</dt><dd>@details.Contract.CreatedAtUtc.LocalDateTime.ToString("dd MMM yyyy HH:mm")</dd></div>
        </dl>
    </section>

    <section class="panel detail-panel invoice-entry-panel" id="register-invoice">
        <div class="panel-heading">
            <div><p class="eyebrow">Invoice intake</p><h2>Register an invoice</h2></div>
            <span class="muted">Against this contract</span>
        </div>
        <p>Remi carries the customer, framework and reporting attributes from this contract into the invoice record. Enter the accounting facts below.</p>
        <div class="invoice-contract-context">
            <span><strong>@details.Contract.SupplierReference</strong><small>@Frameworks.Get(details.Contract.Framework).DisplayName</small></span>
            <span><strong>@details.Contract.CustomerName</strong><small>@(details.Contract.CustomerUrn ?? "URN not recorded")</small></span>
        </div>
        <div class="form-grid">
            <label>Invoice or credit note number <span class="required">required</span><input required @bind="invoiceNumber" @bind:event="oninput" /></label>
            <label>Invoice or credit note date <span class="required">required</span><input required type="date" @bind="invoiceDate" /></label>
            <label>Reporting month <span class="required">required</span><input required inputmode="numeric" pattern="[0-9]{4}-[0-9]{2}" placeholder="YYYY-MM" @bind="invoiceReportingMonth" @bind:event="oninput" /></label>
            <label>Total cost, ex VAT <span class="required">required</span><input required type="number" step="0.01" @bind="invoiceTotalExVat" /></label>
            <label>Unit of measure <span class="optional">optional</span><input @bind="unitOfMeasure" @bind:event="oninput" placeholder="e.g. licence, day or each" /></label>
            <label>Quantity <span class="optional">optional</span><input type="number" step="0.01" @bind="quantity" /></label>
            <label>Price per unit, ex VAT <span class="optional">optional</span><input type="number" step="0.01" @bind="pricePerUnitExVat" /></label>
            <label>Original vendor <span class="optional">optional</span><input @bind="originalVendor" @bind:event="oninput" /></label>
            <label>Subcontractor name <span class="optional">optional</span><input @bind="subcontractorName" @bind:event="oninput" /></label>
        </div>
        <p class="caption">Use a negative total for a credit note. Framework service fields, lot, order channel and Marketplace ID are copied from the registered contract.</p>
        <div class="action-row"><button class="button primary" disabled="@(!CanRecordInvoice || invoiceWorking)" @onclick="RecordInvoiceAsync">@(invoiceWorking ? "Recording…" : "Register invoice")</button></div>
        @if (invoiceSubmission is not null)
        {
            <p class="notice @(invoiceSubmission.Succeeded ? "success" : "error")" role="status">@invoiceSubmission.Message</p>
            @if (invoiceSubmission.Findings.Count != 0)
            {
                <ul class="findings inline-findings">
                    @foreach (var finding in invoiceSubmission.Findings)
                    {
                        <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li>
                    }
                </ul>
            }
        }
    </section>

    <section class="panel detail-panel">
        <div class="panel-heading"><div><p class="eyebrow">Charge schedule</p><h2>Annual payment positions</h2></div></div>
        @if (details.ChargeSchedule.Count == 0)
        {
            <p class="muted">No charge schedule has been recorded for this contract.</p>
        }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>Year</th><th>Description</th><th>Expected date</th><th>Value, ex VAT</th></tr></thead><tbody>
                @foreach (var item in details.ChargeSchedule)
                {
                    <tr><td>@item.ContractYear</td><td>@item.Description</td><td>@Display(item.ExpectedInvoiceDate)</td><td>@Currency(item.ValueExVat)</td></tr>
                }
            </tbody></table></div>
        }
    </section>

    <section class="panel detail-panel">
        <div class="panel-heading"><div><p class="eyebrow">Reported invoices</p><h2>Activity against this contract</h2></div><span class="muted">@details.Invoices.Count invoice(s)</span></div>
        @if (details.Invoices.Count == 0)
        {
            <p class="muted">No invoices have been recorded against this contract.</p>
        }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>Date</th><th>Invoice number</th><th>Total, ex VAT</th><th>Reporting month</th></tr></thead><tbody>
                @foreach (var invoice in details.Invoices)
                {
                    <tr><td>@Display(invoice.InvoiceDate)</td><td><a href="@($"/invoices/{invoice.Id}")">@invoice.InvoiceNumber</a></td><td>@Currency(invoice.TotalCostExVat)</td><td>@invoice.ReportMonth</td></tr>
                }
            </tbody></table></div>
        }
    </section>

    <section class="panel detail-panel">
        <div class="panel-heading"><div><p class="eyebrow">Evidence</p><h2>Original supporting files</h2></div><span class="muted">@details.Evidence.Count file(s)</span></div>
        @if (details.Evidence.Count == 0)
        {
            <p class="muted">No archived evidence is linked to this contract.</p>
        }
        else
        {
            <div class="evidence-list">
                @foreach (var evidence in details.Evidence)
                {
                    <a class="evidence-item" href="@($"/evidence/{evidence.Id}")" target="_blank"><span><strong>@evidence.FileName</strong><span class="cell-secondary">@evidence.OriginalRelativePath</span></span><span class="muted">@(IsPdf(evidence) ? "View PDF" : "Download")</span></a>
                }
            </div>
        }
    </section>
}

}

@code {
    [Parameter] public Guid ContractId { get; set; }
    private bool UseLegacyContractRecord => false;
    private ContractDetailsModel? details;
    private string invoiceNumber = string.Empty;
    private DateOnly? invoiceDate;
    private string invoiceReportingMonth = CurrentReportingMonth();
    private decimal invoiceTotalExVat;
    private string unitOfMeasure = string.Empty;
    private decimal? quantity;
    private decimal? pricePerUnitExVat;
    private string originalVendor = string.Empty;
    private string subcontractorName = string.Empty;
    private ReturnActionResult? invoiceSubmission;
    private bool invoiceWorking;

    protected override Task OnParametersSetAsync() => Task.CompletedTask;

    private bool IsValidInvoiceReportingMonth => DateOnly.TryParseExact($"{invoiceReportingMonth}-01", "yyyy-MM-dd", out _);
    private bool CanRecordInvoice =>
        details is not null &&
        IsValidInvoiceReportingMonth &&
        !string.IsNullOrWhiteSpace(invoiceNumber) &&
        invoiceDate is not null &&
        invoiceTotalExVat != 0;

    private async Task RecordInvoiceAsync()
    {
        if (!CanRecordInvoice || details is null)
        {
            return;
        }

        var contract = details.Contract;
        invoiceWorking = true;
        invoiceSubmission = null;
        try
        {
            invoiceSubmission = await Workspace.RecordInvoiceAsync(new InvoiceEntry(
                contract.Framework,
                contract.SupplierReference,
                contract.CustomerName,
                contract.CustomerUrn,
                invoiceDate,
                invoiceNumber,
                contract.LotNumber,
                contract.ServiceGroup,
                contract.ServiceGroupLevel2,
                contract.ServiceDescription,
                contract.OrderChannel,
                contract.DigitalMarketplaceServiceId,
                unitOfMeasure,
                quantity,
                pricePerUnitExVat,
                invoiceTotalExVat,
                originalVendor,
                subcontractorName,
                invoiceReportingMonth,
                "Manual invoice registration"));
            if (invoiceSubmission.Succeeded)
            {
                ResetInvoiceForm();
                details = await Workspace.GetContractDetailsAsync(ContractId);
            }
        }
        finally
        {
            invoiceWorking = false;
        }
    }

    private void ResetInvoiceForm()
    {
        invoiceNumber = unitOfMeasure = originalVendor = subcontractorName = string.Empty;
        invoiceDate = null;
        invoiceTotalExVat = 0;
        quantity = pricePerUnitExVat = null;
        invoiceReportingMonth = CurrentReportingMonth();
    }

    private static bool IsPdf(EvidenceLink evidence) => string.Equals(evidence.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase);
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    private static string Display(DateOnly? value) => value?.ToString("dd MMM yyyy") ?? "Not recorded";
    private static string Currency(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    private static string CurrentReportingMonth() => DateOnly.FromDateTime(DateTime.Today).AddMonths(-1).ToString("yyyy-MM");
}
