@page "/contracts"
@using Remi.Domain
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@implements IDisposable

<PageTitle>Remi · Contracts</PageTitle>

@if (model is null)
{
    <p class="loading">Loading contract register…</p>
}
else
{
    <section class="register-page">
        <header class="dashboard-header register-page-header-compact">
            <div>
                <h1>Contracts</h1>
            </div>
            <a class="remi-action remi-action--primary" href="@PeriodRoute("contracts/new")">Register</a>
        </header>

        <section class="register-workspace register-workspace-full" id="contract-register">
            <article class="register-card">
                <header class="register-card-header register-card-header-compact">
                    <div><h2>Find and check contracts</h2><p>Documents and reported value are visible before review.</p></div>
                    <div class="register-result-count"><strong>@FilteredContracts.Count</strong><span>matching contracts</span></div>
                </header>

                <div class="register-filters">
                    <label class="register-search floating-field floating-field--static"><input @bind="searchTerm" @bind:event="oninput" @bind:after="ResetPage" placeholder="Reference, customer or supplier" /><span class="floating-label">Search contracts</span></label>
                    <RemiPicklist Id="contract-framework-filter-options" Label="Framework" Items="@FrameworkFilterItems" Value="@frameworkFilter" ValueChanged="SetFrameworkFilter" ItemLabel="FrameworkFilterLabel" />
                    <RemiPicklist Id="contract-document-filter-options" Label="Documents" Items="@DocumentFilterItems" Value="@evidenceFilter" ValueChanged="SetEvidenceFilter" ItemLabel="DocumentFilterLabel" />
                    <RemiPicklist Id="contract-progress-filter-options" Label="Progress" Items="@ProgressFilterItems" Value="@progressFilter" ValueChanged="SetProgressFilter" ItemLabel="ProgressFilterLabel" />
                    <div class="filter-actions"><button class="remi-action remi-action--compact register-reset" @onclick="ResetFilters">Reset</button></div>
                    <div class="quick-filters" aria-label="Quick filters">
                        <span>Quick filters</span>
                        <button class="@QuickButtonClass("available")" @onclick="@(() => SetQuickFilter("available"))">Documents linked</button>
                        <button class="@QuickButtonClass("missing")" @onclick="@(() => SetQuickFilter("missing"))">Documents missing</button>
                        <button class="@QuickButtonClass("expiring")" @onclick="@(() => SetQuickFilter("expiring"))">Expiring soon</button>
                        <button class="@QuickButtonClass("period")" @onclick="@(() => SetQuickFilter("period"))">Selected period</button>
                    </div>
                </div>

                <div class="register-table-scroll">
                    <table class="register-table contract-register-table">
                        <thead><tr>
                            <th aria-sort="@SortAria("reference")"><button class="table-sort" @onclick="@(() => SortBy("reference"))">Reference &amp; framework <span aria-hidden="true">@SortIndicator("reference")</span></button></th>
                            <th aria-sort="@SortAria("customer")"><button class="table-sort" @onclick="@(() => SortBy("customer"))">Customer <span aria-hidden="true">@SortIndicator("customer")</span></button></th>
                            <th aria-sort="@SortAria("endDate")"><button class="table-sort" @onclick="@(() => SortBy("endDate"))">End date <span aria-hidden="true">@SortIndicator("endDate")</span></button></th>
                            <th aria-sort="@SortAria("value")"><button class="table-sort" @onclick="@(() => SortBy("value"))">Value <span aria-hidden="true">@SortIndicator("value")</span></button></th>
                            <th aria-sort="@SortAria("evidence")"><button class="table-sort" @onclick="@(() => SortBy("evidence"))">Documents <span aria-hidden="true">@SortIndicator("evidence")</span></button></th>
                            <th aria-sort="@SortAria("progress")"><button class="table-sort" @onclick="@(() => SortBy("progress"))">Progress <span aria-hidden="true">@SortIndicator("progress")</span></button></th>
                        </tr></thead>
                        <tbody>
                        @if (PagedContracts.Count == 0)
                        {
                            <tr><td colspan="6" class="register-empty">No contracts match these filters.</td></tr>
                        }
                        @foreach (var contract in PagedContracts)
                        {
                            <tr>
                                <td><a class="register-reference" href="@ContractRoute(contract.ContractId)">@contract.SupplierReference</a><span>@Frameworks.Get(contract.Framework).DisplayName</span></td>
                                <td><strong>@contract.CustomerName</strong><span>@(contract.CustomerUrn ?? "URN not recorded")</span></td>
                                <td class="register-date"><span class="@LifecycleStatusClass(contract)"><i aria-hidden="true"></i>@LifecycleStatus(contract)</span><span>@DisplayDate(contract.EndDate)</span></td>
                                <td class="register-currency"><strong>@Currency(contract.TotalContractValueExVat)</strong></td>
                                <td><span class="@EvidenceStatusClass(contract)"><i aria-hidden="true"></i>@EvidenceStatus(contract)</span><span>@contract.Evidence.Count file@(contract.Evidence.Count == 1 ? "" : "s")</span></td>
                                <td><div class="register-progress @(IsOverrun(contract) ? "overrun" : null)" title="@ProgressSummary(contract)"><span><i style="width: @ProgressWidth(contract.CompletionRatio)"></i></span><strong>@Percentage(contract.CompletionRatio)</strong>@if (IsOverrun(contract)) { <span class="visually-hidden">@ProgressSummary(contract)</span> }</div></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <footer class="register-pagination">
                    <span>Showing @FirstItem–@LastItem of @FilteredContracts.Count contracts</span>
                    <div><button disabled="@(page == 1)" @onclick="PreviousPage" aria-label="Previous page">‹</button><strong>@(page)</strong><span>of @TotalPages</span><button disabled="@(page == TotalPages)" @onclick="NextPage" aria-label="Next page">›</button></div>
                </footer>
            </article>
        </section>
    </section>
}

@code {
    private const int PageSize = 10;
    private static readonly IReadOnlyList<string> FrameworkFilterItems = [string.Empty, .. Frameworks.All.Select(item => item.Code.ToString())];
    private static readonly IReadOnlyList<string> DocumentFilterItems = [string.Empty, "available", "missing"];
    private static readonly IReadOnlyList<string> ProgressFilterItems = [string.Empty, "not-started", "in-progress", "complete"];
    private DashboardModel? model;
    private string searchTerm = string.Empty;
    private string frameworkFilter = string.Empty;
    private string evidenceFilter = string.Empty;
    private string progressFilter = string.Empty;
    private string quickFilter = string.Empty;
    private int page = 1;
    private string sortColumn = "reference";
    private bool sortDescending;

    protected override async Task OnInitializedAsync()
    {
        ReportingPeriod.Changed += ReportingPeriodChanged;
        await ReloadAsync();
    }

    public void Dispose() => ReportingPeriod.Changed -= ReportingPeriodChanged;

    private async void ReportingPeriodChanged()
    {
        await InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync() => model = await Workspace.GetDashboardAsync(ReportingPeriod.SelectedPeriod);

    private IReadOnlyList<ContractProgress> FilteredContracts => model is null
        ? []
        : SortContracts(model.ContractProgress.Where(MatchesFilters)).ToList();

    private IReadOnlyList<ContractProgress> PagedContracts => FilteredContracts.Skip((page - 1) * PageSize).Take(PageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredContracts.Count / (double)PageSize));
    private int FirstItem => FilteredContracts.Count == 0 ? 0 : ((page - 1) * PageSize) + 1;
    private int LastItem => Math.Min(page * PageSize, FilteredContracts.Count);

    private bool MatchesFilters(ContractProgress contract)
    {
        var hasEvidence = contract.Evidence.Count > 0;
        var today = DateOnly.FromDateTime(DateTime.Today);
        return (string.IsNullOrWhiteSpace(searchTerm) || contract.SupplierReference.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || contract.CustomerName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(frameworkFilter) || contract.Framework.ToString() == frameworkFilter)
            && (string.IsNullOrWhiteSpace(evidenceFilter) || (evidenceFilter == "available" && hasEvidence) || (evidenceFilter == "missing" && !hasEvidence))
            && (string.IsNullOrWhiteSpace(progressFilter) || (progressFilter == "not-started" && contract.CompletionRatio == 0) || (progressFilter == "in-progress" && contract.CompletionRatio > 0 && contract.CompletionRatio < 1) || (progressFilter == "complete" && contract.CompletionRatio >= 1))
            && (string.IsNullOrWhiteSpace(quickFilter) || (quickFilter == "available" && hasEvidence) || (quickFilter == "missing" && !hasEvidence) || (quickFilter == "expiring" && contract.EndDate is not null && contract.EndDate <= today.AddDays(180)) || (quickFilter == "period" && contract.ReportMonth == model?.CurrentReportingMonth));
    }

    private void SetQuickFilter(string filter) { quickFilter = quickFilter == filter ? string.Empty : filter; ResetPage(); }
    private void SetFrameworkFilter(string value) { frameworkFilter = value; ResetPage(); }
    private void SetEvidenceFilter(string value) { evidenceFilter = value; ResetPage(); }
    private void SetProgressFilter(string value) { progressFilter = value; ResetPage(); }
    private static string FrameworkFilterLabel(string value) => string.IsNullOrEmpty(value)
        ? "All frameworks"
        : Enum.TryParse<FrameworkCode>(value, out var framework) ? Frameworks.Get(framework).DisplayName : value;
    private static string DocumentFilterLabel(string value) => value switch { "available" => "Documents linked", "missing" => "Documents missing", _ => "All documents" };
    private static string ProgressFilterLabel(string value) => value switch { "not-started" => "Not started", "in-progress" => "In progress", "complete" => "Complete", _ => "Any progress" };
    private void SortBy(string column)
    {
        if (sortColumn == column) sortDescending = !sortDescending;
        else { sortColumn = column; sortDescending = false; }
        ResetPage();
    }
    private string SortIndicator(string column) => sortColumn == column ? sortDescending ? "↓" : "↑" : "↕";
    private string SortAria(string column) => sortColumn == column ? sortDescending ? "descending" : "ascending" : "none";
    private IOrderedEnumerable<ContractProgress> SortContracts(IEnumerable<ContractProgress> contracts) => (sortColumn, sortDescending) switch
    {
        ("reference", false) => contracts.OrderBy(contract => contract.SupplierReference, StringComparer.OrdinalIgnoreCase),
        ("reference", true) => contracts.OrderByDescending(contract => contract.SupplierReference, StringComparer.OrdinalIgnoreCase),
        ("customer", false) => contracts.OrderBy(contract => contract.CustomerName, StringComparer.OrdinalIgnoreCase),
        ("customer", true) => contracts.OrderByDescending(contract => contract.CustomerName, StringComparer.OrdinalIgnoreCase),
        ("endDate", false) => contracts.OrderBy(contract => contract.EndDate is null).ThenBy(contract => contract.EndDate),
        ("endDate", true) => contracts.OrderBy(contract => contract.EndDate is null).ThenByDescending(contract => contract.EndDate),
        ("value", false) => contracts.OrderBy(contract => contract.TotalContractValueExVat),
        ("value", true) => contracts.OrderByDescending(contract => contract.TotalContractValueExVat),
        ("evidence", false) => contracts.OrderBy(contract => contract.Evidence.Count),
        ("evidence", true) => contracts.OrderByDescending(contract => contract.Evidence.Count),
        ("progress", false) => contracts.OrderBy(contract => contract.CompletionRatio),
        ("progress", true) => contracts.OrderByDescending(contract => contract.CompletionRatio),
        _ => contracts.OrderBy(contract => contract.SupplierReference, StringComparer.OrdinalIgnoreCase),
    };
    private void ResetPage() => page = 1;
    private void ResetFilters() { searchTerm = frameworkFilter = evidenceFilter = progressFilter = quickFilter = string.Empty; ResetPage(); }
    private void PreviousPage() => page = Math.Max(1, page - 1);
    private void NextPage() => page = Math.Min(TotalPages, page + 1);
    private string QuickButtonClass(string filter) => quickFilter == filter ? "quick-filter active" : "quick-filter";
    private static string EvidenceStatus(ContractProgress contract) => contract.Evidence.Count > 0 ? "Linked" : "Missing";
    private static string EvidenceStatusClass(ContractProgress contract) => contract.Evidence.Count > 0 ? "register-status good" : "register-status warning";
    private static bool IsEnded(ContractProgress contract) => contract.EndDate is not null && contract.EndDate < DateOnly.FromDateTime(DateTime.Today);
    private static bool HasOutstandingPaymentPositions(ContractProgress contract) => contract.UsesInvoicePlan && contract.ReportedInvoiceValueExVat < contract.ComparisonValueExVat;
    private static string LifecycleStatus(ContractProgress contract) => !IsEnded(contract) ? "Live" : HasOutstandingPaymentPositions(contract) ? "Ended · payments open" : "Ended";
    private static string LifecycleStatusClass(ContractProgress contract) => !IsEnded(contract) ? "register-status live" : HasOutstandingPaymentPositions(contract) ? "register-status ended-open" : "register-status ended";
    private static string DisplayDate(DateOnly? value) => value?.ToString("dd MMM yyyy") ?? "Not recorded";
    private static string Percentage(decimal ratio) => $"{Math.Max(ratio * 100, 0):0}%";
    private static string ProgressWidth(decimal ratio) => $"{Math.Clamp(ratio * 100, 0, 100):0}%";
    private static bool IsOverrun(ContractProgress contract) => contract.ComparisonValueExVat > 0 && contract.ReportedInvoiceValueExVat > contract.ComparisonValueExVat;
    private static string ProgressSummary(ContractProgress contract) => IsOverrun(contract) ? $"{Percentage(contract.CompletionRatio)} reported. Reported invoice value exceeds the planned or contract value." : $"{Percentage(contract.CompletionRatio)} reported against the planned or contract value.";
    private static string Currency(decimal value) => value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    private string ContractRoute(Guid contractId) => PeriodRoute($"contracts/{contractId}");
    private string PeriodRoute(string path) => ReportingRoutes.WithPeriod($"/{path.TrimStart('/')}", ReportingPeriod.SelectedPeriod);
    private static string DisplayPeriod(string value) => DateOnly.TryParseExact($"{value}-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date) ? date.ToString("MMMM yyyy") : value;
}
