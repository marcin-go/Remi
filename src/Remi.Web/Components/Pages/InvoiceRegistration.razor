@page "/invoices/new"
@using Microsoft.JSInterop
@inject ReportingWorkspace Workspace
@inject ReportingPeriodContext ReportingPeriod
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>Remi · Register invoice</PageTitle>

<ClipboardImageEvidence @ref="clipboardEvidence" OnDocumentsChanged="SetClipboardImageCount">
<section class="invoice-intake-page">
    <header class="invoice-intake-header">
        <div><h1>Register invoice</h1><p>Choose a contract and enter the invoice details.</p></div>
        <button type="button" class="invoice-command" @onclick="ConfirmCancelAsync">Back <span aria-hidden="true">←</span></button>
    </header>

    @if (contracts is null)
    {
        <p class="loading">Loading registered contracts…</p>
    }
    else if (contracts.Count == 0)
    {
        <section class="invoice-intake-surface">
            <section class="invoice-contract-section">
                <h2>Contract</h2>
                <label class="floating-field floating-field--static">
                    <select disabled aria-label="Contract"><option>No contracts available</option></select>
                    <span class="floating-label">Contract</span>
                </label>
                <p class="invoice-empty-contracts">No registered contracts are available yet.</p>
            </section>
        </section>
    }
    else
    {
        @if (submission is not null)
        {
            <p class="notice @(submission.Succeeded ? "success" : "error")" role="status">@submission.Message</p>
            @if (submission.Findings.Count != 0)
            {
                <ul class="findings inline-findings">@foreach (var finding in submission.Findings) { <li class="@finding.Severity.ToString().ToLowerInvariant()"><span>@finding.Message</span></li> }</ul>
            }
        }

        <section class="invoice-intake-surface">
            <section class="invoice-contract-section">
                <h2>Contract</h2>
                <div class="contract-picker">
                    <label for="contract-search" class="floating-field floating-field--static">
                        <input id="contract-search" role="combobox" aria-label="Contract" aria-autocomplete="list" aria-controls="contract-suggestions" aria-expanded="@contractSuggestionsOpen.ToString().ToLowerInvariant()" autocomplete="off" placeholder="Search by reference, customer or framework" value="@contractSearch" @oninput="SearchContracts" @onfocus="OpenContractSuggestions" @onkeydown="HandleContractSearchKeyDown" />
                        <span class="floating-label">Contract</span>
                    </label>
                    @if (contractSuggestionsOpen)
                    {
                        <div id="contract-suggestions" class="contract-suggestions" role="listbox" aria-label="Contract suggestions">
                            @if (MatchingContracts.Count == 0)
                            {
                                <p>No matching contracts.</p>
                            }
                            else
                            {
                                @foreach (var contract in MatchingContracts)
                                {
                                    <button type="button" role="option" aria-selected="@(contract.ContractId == selectedContractId)" @onclick="@(() => SelectContractAsync(contract))">@ContractDescription(contract)</button>
                                }
                            }
                        </div>
                    }
                </div>
            </section>

            @if (SelectedContract is not null)
            {
                <section class="invoice-contract-summary">
                    <div>
                        <strong>@SelectedContract.SupplierReference <span aria-hidden="true">·</span> @SelectedContract.CustomerName</strong>
                        <span>@Frameworks.Get(SelectedContract.Framework).DisplayName <span aria-hidden="true">·</span> @Frameworks.Get(SelectedContract.Framework).AgreementNumber</span>
                    </div>
                    <a class="invoice-command" href="@ContractRoute(SelectedContract.ContractId)">View contract <span aria-hidden="true">→</span></a>
                </section>

                @if (SelectedContract.UnconfirmedChangeCount != 0)
                {
                    <p class="notice warning">This contract has @SelectedContract.UnconfirmedChangeCount change@(SelectedContract.UnconfirmedChangeCount == 1 ? string.Empty : "s") awaiting confirmation. An invoice can be recorded now; confirm the change from the contract's Changes tab when you have spoken to the customer.</p>
                }

                @if (SelectedContract.AgreedChanges.Count != 0)
                {
                    <section class="invoice-details-section invoice-contract-change-section">
                        <label class="floating-field floating-field--static">
                            <select @bind="contractChangeId">
                                <option value="">Original contract</option>
                                @foreach (var change in SelectedContract.AgreedChanges)
                                {
                                    <option value="@change.Id">@ChangeDescription(change)</option>
                                }
                            </select>
                            <span class="floating-label">Contract segment</span>
                        </label>
                        <p class="invoice-field-help">Choose the agreed extension or variation when this invoice relates to it. The MI invoice remains a separate invoice record.</p>
                    </section>
                }

                <section class="invoice-details-section">
                    <header><h2>Invoice details</h2></header>
                    <div class="invoice-details-grid">
                        <label class="floating-field"><input required placeholder=" " @bind="invoiceNumber" @bind:event="oninput" /><span class="floating-label">Invoice or credit note number</span></label>
                        <label class="floating-field floating-field--static"><input required type="date" @bind="invoiceDate" /><span class="floating-label">Invoice or credit note date</span></label>
                        <label class="floating-field floating-field--static">
                            <select required @bind="reportingMonth">
                                @foreach (var month in ReportingMonthOptions)
                                {
                                    <option value="@month">@DisplayReportingMonth(month)</option>
                                }
                            </select>
                            <span class="floating-label">Reporting month</span>
                        </label>
                        <label class="floating-field floating-field--static floating-field--currency"><b aria-hidden="true">£</b><input required type="number" step="0.01" @bind="totalCostExVat" /><span class="floating-label">Total cost, ex VAT</span></label>
                    </div>
                    <p class="invoice-field-help">Use a negative total for a credit note.</p>
                    @if (InvoiceExceedsRecordedValue)
                    {
                        <p class="notice warning">This invoice exceeds the remaining recorded contract value by @Currency(InvoiceOverage). It may reveal an extension or variation—record it from the contract's Changes tab.</p>
                    }
                    @if (SelectedChange is { IsConfirmed: false })
                    {
                        <p class="notice warning">The selected @SelectedChange.Kind.ToString().ToLowerInvariant() is awaiting confirmation. The invoice can still be linked to it.</p>
                    }
                </section>

                @if (IntakeForm is { IsAvailable: true } form)
                {
                    <section class="invoice-details-section">
                        <header><h2>@Frameworks.Get(SelectedContract.Framework).DisplayName invoice report fields</h2></header>
                        <p class="invoice-field-help">This form matches the selected framework's MI workbook. Contract values are prefilled; choose a lot before its dependent service group.</p>
                        <div class="invoice-details-grid">
                            <label class="floating-field"><input required placeholder=" " @bind="customerName" @bind:event="oninput" /><span class="floating-label">Customer organisation name</span></label>
                            <label class="floating-field"><input required placeholder=" " @bind="customerUrn" @bind:event="oninput" /><span class="floating-label">Customer URN</span></label>
                            <label class="floating-field floating-field--static">
                                <select required aria-label="Lot number" @bind="lotNumber" @bind:after="OnLotChanged">
                                    <option value="">Select a lot</option>
                                    @foreach (var lot in form.Lots)
                                    {
                                        <option value="@lot">@lot</option>
                                    }
                                </select>
                                <span class="floating-label">Lot number</span>
                            </label>
                            @if (form.IsVas)
                            {
                                <label class="floating-field floating-field--static">
                                    <select required aria-label="Product/service group level 1" disabled="@(ServiceGroupOptions.Count == 0)" @bind="serviceGroup">
                                        <option value="">@(ServiceGroupOptions.Count == 0 ? "Select a lot first" : "Select a product/service group")</option>
                                        @foreach (var group in ServiceGroupOptions)
                                        {
                                            <option value="@group">@group</option>
                                        }
                                    </select>
                                    <span class="floating-label">Product/service group level 1</span>
                                </label>
                                <label class="floating-field floating-field--static">
                                    <select required aria-label="Product/service group level 2" @bind="serviceGroupLevel2">
                                        <option value="">Select a classification</option>
                                        @foreach (var classification in form.ServiceGroupLevel2Options)
                                        {
                                            <option value="@classification">@classification</option>
                                        }
                                    </select>
                                    <span class="floating-label">Product/service group level 2</span>
                                </label>
                                <label class="floating-field"><input required placeholder=" " @bind="serviceDescription" @bind:event="oninput" /><span class="floating-label">Product/service description</span></label>
                                <label class="floating-field"><input required placeholder=" " @bind="originalVendor" @bind:event="oninput" /><span class="floating-label">Original vendor</span></label>
                                <label class="floating-field"><input required placeholder=" " @bind="subcontractorName" @bind:event="oninput" /><span class="floating-label">Subcontractor name</span></label>
                            }
                            else
                            {
                                <label class="floating-field floating-field--static">
                                    <select required aria-label="Service group" disabled="@(ServiceGroupOptions.Count == 0)" @bind="serviceGroup">
                                        <option value="">@(ServiceGroupOptions.Count == 0 ? "Select a lot first" : "Select a service group")</option>
                                        @foreach (var group in ServiceGroupOptions)
                                        {
                                            <option value="@group">@group</option>
                                        }
                                    </select>
                                    <span class="floating-label">Service group</span>
                                </label>
                                <label class="floating-field"><input required placeholder=" " @bind="digitalMarketplaceServiceId" @bind:event="oninput" /><span class="floating-label">Digital Marketplace service ID</span></label>
                                <label class="floating-field floating-field--static">
                                    <select required aria-label="Unit of measure" @bind="unitOfMeasure">
                                        <option value="">Select a unit of measure</option>
                                        @foreach (var unit in form.UnitOfMeasureOptions)
                                        {
                                            <option value="@unit">@unit</option>
                                        }
                                    </select>
                                    <span class="floating-label">Unit of measure</span>
                                </label>
                                @if (SelectedContract.Framework == FrameworkCode.GCloud13)
                                {
                                    <label class="floating-field floating-field--currency"><b aria-hidden="true">&pound;</b><input required type="number" step="0.01" @bind="pricePerUnitExVat" /><span class="floating-label">Price per unit, ex VAT</span></label>
                                    <label class="floating-field"><input required type="number" step="0.01" @bind="quantity" /><span class="floating-label">Quantity</span></label>
                                }
                                else
                                {
                                    <label class="floating-field"><input required type="number" step="0.01" @bind="quantity" /><span class="floating-label">Quantity</span></label>
                                    <label class="floating-field floating-field--currency"><b aria-hidden="true">&pound;</b><input required type="number" step="0.01" @bind="pricePerUnitExVat" /><span class="floating-label">Price per unit, ex VAT</span></label>
                                }
                            }
                        </div>
                    </section>
                }
                else
                {
                    <p class="notice warning">An approved invoice template for @Frameworks.Get(SelectedContract.Framework).DisplayName is not available yet, so an invoice cannot be recorded from this form.</p>
                }

                <footer class="invoice-intake-actions">
                    <button type="button" class="invoice-command invoice-command-muted" @onclick="ConfirmCancelAsync">Cancel</button>
                    <button type="button" class="invoice-command invoice-command-save" disabled="@(!CanRecord || working)" @onclick="RecordInvoiceAsync">@(working ? "Saving…" : "Save invoice")</button>
                </footer>
            }
        </section>
    }
</section>
</ClipboardImageEvidence>

@code {
    private IReadOnlyList<InvoiceRegistrationContract>? contracts;
    private Guid? selectedContractId;
    private string contractSearch = string.Empty;
    private bool contractSuggestionsOpen;
    private string invoiceNumber = string.Empty;
    private DateOnly? invoiceDate;
    private string reportingMonth = string.Empty;
    private string initialReportingMonth = string.Empty;
    private decimal totalCostValue;
    private Guid? contractChangeId;
    private ReturnActionResult? submission;
    private bool working;
    private ClipboardImageEvidence? clipboardEvidence;
    private int clipboardImageCount;
    private string customerName = string.Empty, customerUrn = string.Empty, lotNumber = string.Empty, serviceGroup = string.Empty, serviceGroupLevel2 = string.Empty, serviceDescription = string.Empty, orderChannel = string.Empty, digitalMarketplaceServiceId = string.Empty, unitOfMeasure = string.Empty, originalVendor = string.Empty, subcontractorName = string.Empty;
    private decimal? quantity;
    private decimal? pricePerUnitExVatValue;
    private bool pricePerUnitManuallySet;

    private InvoiceRegistrationContract? SelectedContract => selectedContractId is Guid contractId
        ? contracts?.SingleOrDefault(contract => contract.ContractId == contractId)
        : null;
    private ContractChangeRecord? SelectedChange => contractChangeId is Guid changeId
        ? SelectedContract?.AgreedChanges.SingleOrDefault(change => change.Id == changeId)
        : null;
    private IReadOnlyList<InvoiceRegistrationContract> MatchingContracts => (contracts ?? [])
        .Where(MatchesContractSearch)
        .Take(5)
        .ToList();
    private bool IsValidReportingMonth => DateOnly.TryParseExact($"{reportingMonth}-01", "yyyy-MM-dd", out _);
    private MiInvoiceIntakeForm? IntakeForm => SelectedContract is { } contract ? MiInvoiceIntakeForms.For(contract.Framework) : null;
    private IReadOnlyList<string> ServiceGroupOptions => IntakeForm?.ServiceGroupsFor(lotNumber) ?? [];
    private decimal totalCostExVat { get => totalCostValue; set { totalCostValue = value; if (!pricePerUnitManuallySet) pricePerUnitExVatValue = InvoiceReportingDefaults.PricePerUnitExVat(value); } }
    private decimal? pricePerUnitExVat { get => pricePerUnitExVatValue; set { pricePerUnitManuallySet = true; pricePerUnitExVatValue = value; } }
    private bool HasRequiredMiFields => IntakeForm is { IsAvailable: true } form
        && !string.IsNullOrWhiteSpace(customerName)
        && !string.IsNullOrWhiteSpace(customerUrn)
        && form.Lots.Contains(lotNumber, StringComparer.Ordinal)
        && form.ServiceGroupsFor(lotNumber).Contains(serviceGroup, StringComparer.Ordinal)
        && (form.IsVas
            ? form.ServiceGroupLevel2Options.Contains(serviceGroupLevel2, StringComparer.Ordinal) && !string.IsNullOrWhiteSpace(serviceDescription) && !string.IsNullOrWhiteSpace(originalVendor) && !string.IsNullOrWhiteSpace(subcontractorName)
            : !string.IsNullOrWhiteSpace(digitalMarketplaceServiceId) && form.UnitOfMeasureOptions.Contains(unitOfMeasure, StringComparer.Ordinal) && quantity is not null && pricePerUnitExVat is not null);
    private bool CanRecord => SelectedContract is not null && IsValidReportingMonth && !string.IsNullOrWhiteSpace(invoiceNumber) && invoiceDate is not null && totalCostExVat != 0 && HasRequiredMiFields;
    private bool InvoiceExceedsRecordedValue => SelectedContract is not null && totalCostExVat > SelectedContract.RemainingCommittedValueExVat;
    private decimal InvoiceOverage => SelectedContract is null ? 0 : Math.Max(0, totalCostExVat - SelectedContract.RemainingCommittedValueExVat);
    private bool HasUnsavedInvoiceChanges => !string.IsNullOrWhiteSpace(invoiceNumber) || invoiceDate is not null || totalCostExVat != 0 || !string.IsNullOrWhiteSpace(customerName) || reportingMonth != initialReportingMonth || clipboardImageCount != 0;
    private string ClipboardEvidenceMessage => clipboardImageCount == 0 ? "Paste images here to retain them as invoice evidence." : $"{clipboardImageCount} image{(clipboardImageCount == 1 ? string.Empty : "s")} ready to add as evidence.";
    private IReadOnlyList<string> ReportingMonthOptions
    {
        get
        {
            var selectedMonth = DateOnly.TryParseExact($"{reportingMonth}-01", "yyyy-MM-dd", out var parsed)
                ? parsed
                : DateOnly.FromDateTime(DateTime.Today);
            var firstMonth = new DateOnly(selectedMonth.Year, selectedMonth.Month, 1).AddMonths(-36);
            return Enumerable.Range(0, 61).Select(offset => firstMonth.AddMonths(offset).ToString("yyyy-MM")).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        reportingMonth = initialReportingMonth = ReportingPeriod.SelectedPeriod;
        contracts = await Workspace.GetInvoiceRegistrationContractsAsync();
    }

    private bool MatchesContractSearch(InvoiceRegistrationContract contract) =>
        string.IsNullOrWhiteSpace(contractSearch)
        || contract.SupplierReference.Contains(contractSearch, StringComparison.OrdinalIgnoreCase)
        || contract.CustomerName.Contains(contractSearch, StringComparison.OrdinalIgnoreCase)
        || Frameworks.Get(contract.Framework).DisplayName.Contains(contractSearch, StringComparison.OrdinalIgnoreCase);

    private void OpenContractSuggestions() => contractSuggestionsOpen = true;

    private void SearchContracts(ChangeEventArgs args)
    {
        contractSearch = args.Value?.ToString() ?? string.Empty;
        selectedContractId = null;
        contractSuggestionsOpen = true;
        submission = null;
    }

    private async Task HandleContractSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            contractSuggestionsOpen = false;
        }
        else if (args.Key == "Enter" && MatchingContracts.Count == 1)
        {
            await SelectContractAsync(MatchingContracts[0]);
        }
    }

    private async Task SelectContractAsync(InvoiceRegistrationContract contract)
    {
        selectedContractId = contract.ContractId;
        contractChangeId = null;
        contractSearch = ContractDescription(contract);
        contractSuggestionsOpen = false;
        submission = null;
        await PopulateInvoiceReportingFieldsAsync(contract);
    }

    private async Task RecordInvoiceAsync()
    {
        var contract = SelectedContract;
        if (!CanRecord || contract is null) return;

        working = true;
        submission = null;
        try
        {
            submission = await Workspace.RecordInvoiceAsync(new InvoiceEntry(
                contract.Framework,
                contract.SupplierReference,
                customerName,
                customerUrn,
                invoiceDate,
                invoiceNumber,
                lotNumber,
                serviceGroup,
                serviceGroupLevel2,
                serviceDescription,
                orderChannel,
                digitalMarketplaceServiceId,
                unitOfMeasure,
                quantity,
                pricePerUnitExVat,
                totalCostExVat,
                originalVendor,
                subcontractorName,
                reportingMonth,
                "Manual invoice registration",
                contractChangeId));
            if (submission.Succeeded)
            {
                if (clipboardImageCount != 0 && submission.EntityId is Guid invoiceId)
                {
                    await clipboardEvidence!.ArchiveAsync("invoice", invoiceId);
                }
                await ResetFormAsync();
            }
        }
        finally { working = false; }
    }

    private async Task ResetFormAsync()
    {
        invoiceNumber = string.Empty;
        invoiceDate = null;
        totalCostExVat = 0;
        reportingMonth = initialReportingMonth = ReportingPeriod.SelectedPeriod;
        clipboardImageCount = 0;
        contractChangeId = null;
        if (SelectedContract is { } contract)
        {
            await PopulateInvoiceReportingFieldsAsync(contract);
        }
    }

    private async Task PopulateInvoiceReportingFieldsAsync(InvoiceRegistrationContract contract)
    {
        customerName = contract.CustomerName;
        customerUrn = contract.CustomerUrn ?? string.Empty;
        lotNumber = contract.LotNumber ?? string.Empty;
        serviceGroup = contract.ServiceGroup ?? string.Empty;
        serviceGroupLevel2 = contract.ServiceGroupLevel2 ?? string.Empty;
        serviceDescription = contract.ServiceDescription ?? string.Empty;
        orderChannel = contract.OrderChannel ?? string.Empty;
        digitalMarketplaceServiceId = contract.DigitalMarketplaceServiceId ?? string.Empty;
        var suggestion = await Workspace.GetInvoiceReportingSuggestionAsync(contract.ContractId);
        unitOfMeasure = suggestion.UnitOfMeasure;
        quantity = suggestion.Quantity;
        pricePerUnitManuallySet = false;
        pricePerUnitExVatValue = InvoiceReportingDefaults.PricePerUnitExVat(totalCostExVat);
        originalVendor = suggestion.OriginalVendor;
        subcontractorName = suggestion.SubcontractorName;
        ReconcileTemplateSelections();
    }

    private void OnLotChanged()
    {
        serviceGroup = string.Empty;
    }

    private void ReconcileTemplateSelections()
    {
        if (IntakeForm is not { IsAvailable: true } form)
        {
            return;
        }

        if (!form.Lots.Contains(lotNumber, StringComparer.Ordinal))
        {
            lotNumber = string.Empty;
        }

        if (!form.ServiceGroupsFor(lotNumber).Contains(serviceGroup, StringComparer.Ordinal))
        {
            serviceGroup = string.Empty;
        }

        if (form.IsVas)
        {
            if (!form.ServiceGroupLevel2Options.Contains(serviceGroupLevel2, StringComparer.Ordinal))
            {
                serviceGroupLevel2 = string.Empty;
            }
        }
        else if (!form.UnitOfMeasureOptions.Contains(unitOfMeasure, StringComparer.Ordinal))
        {
            unitOfMeasure = string.Empty;
        }
    }

    private async Task ConfirmCancelAsync()
    {
        if (HasUnsavedInvoiceChanges && !await JsRuntime.InvokeAsync<bool>("confirm", "Discard the invoice details you have entered?")) return;
        Navigation.NavigateTo(PeriodRoute("invoices"));
    }

    private void SetClipboardImageCount(int count) => clipboardImageCount = count;

    private string PeriodRoute(string path) => ReportingRoutes.WithPeriod($"/{path.TrimStart('/')}", ReportingPeriod.SelectedPeriod);
    private string ContractRoute(Guid contractId) => PeriodRoute($"contracts/{contractId}");
    private static string DisplayReportingMonth(string month) => DateOnly.TryParseExact($"{month}-01", "yyyy-MM-dd", out var parsed) ? parsed.ToString("MMMM yyyy") : month;
    private static string ContractDescription(InvoiceRegistrationContract contract) => $"{contract.SupplierReference} · {contract.CustomerName} · {Frameworks.Get(contract.Framework).DisplayName}";
    private static string ChangeDescription(ContractChangeRecord change) => $"{change.Kind} agreed {change.AgreementDate:dd MMM yyyy} · {change.IncrementalValueExVat:C2}";
    private static string Currency(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
}
